<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="PurchasePlanned_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="PurchasePlanned_collab"><bpmn:participant id="PurchasePlanned_pool" name="Mua hàng theo kế hoạch sản xuất" processRef="PurchasePlanned"/></bpmn:collaboration><bpmn:process id="PurchasePlanned" name="Mua hàng theo kế hoạch sản xuất" isExecutable="false"><bpmn:laneSet id="PurchasePlanned_lanes"><bpmn:lane id="PurchasePlanned_lane_0" name="Bộ phận Cung ứng"><bpmn:flowNodeRef>PP_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>PP_MRP</bpmn:flowNodeRef><bpmn:flowNodeRef>PP_PO</bpmn:flowNodeRef><bpmn:flowNodeRef>PP_Sched</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="PurchasePlanned_lane_1" name="Phòng Kế toán"><bpmn:flowNodeRef>PP_Price</bpmn:flowNodeRef><bpmn:flowNodeRef>PP_G</bpmn:flowNodeRef><bpmn:flowNodeRef>PP_Appr</bpmn:flowNodeRef><bpmn:flowNodeRef>PP_Inv</bpmn:flowNodeRef><bpmn:flowNodeRef>PP_End</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="PurchasePlanned_lane_2" name="Bộ phận Kho"><bpmn:flowNodeRef>PP_Recv</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="PP_Start" name="Có kế hoạch sản xuất"><bpmn:documentation>Kế hoạch sản xuất và lệnh sản xuất đã phát hành là đầu vào cho việc tính nhu cầu nguyên vật liệu.</bpmn:documentation><bpmn:outgoing>PP_F1</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="PP_MRP" name="Chạy MRP
lên nhu cầu NVL"><bpmn:documentation>Hệ thống tính nhu cầu nguyên vật liệu dựa trên kế hoạch sản xuất, tồn kho hiện có và lượng đang về.</bpmn:documentation><bpmn:incoming>PP_F1</bpmn:incoming><bpmn:outgoing>PP_F2</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="PP_PO" name="Tạo và gửi duyệt
Đơn mua hàng"><bpmn:documentation>Từ đề xuất của MRP, Cung ứng xác nhận và tạo Đơn mua hàng; gộp theo nhà cung cấp, đơn vị tính và ngày giao rồi gửi đi phê duyệt.</bpmn:documentation><bpmn:incoming>PP_F2</bpmn:incoming><bpmn:incoming>PP_F6</bpmn:incoming><bpmn:outgoing>PP_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="PP_Price" name="Kiểm tra giá mua
với bảng giá"><bpmn:documentation>Đối chiếu đơn giá trên Đơn mua hàng với bảng giá mua theo hợp đồng nguyên tắc.</bpmn:documentation><bpmn:incoming>PP_F3</bpmn:incoming><bpmn:outgoing>PP_F4</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="PP_G" name="Giá hợp lệ?" default="PP_F6"><bpmn:documentation>Đơn giá khớp bảng giá thì duyệt; lệch giá thì trả lại Cung ứng chỉnh sửa.</bpmn:documentation><bpmn:incoming>PP_F4</bpmn:incoming><bpmn:outgoing>PP_F5</bpmn:outgoing><bpmn:outgoing>PP_F6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="PP_Appr" name="Duyệt Đơn mua hàng"><bpmn:documentation>Đơn mua hàng chuyển trạng thái đã duyệt, sẵn sàng gửi nhà cung cấp.</bpmn:documentation><bpmn:incoming>PP_F5</bpmn:incoming><bpmn:outgoing>PP_F7</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="PP_Sched" name="Thông báo
lịch nhập kho"><bpmn:documentation>Cung ứng thông báo lịch dự kiến nhập kho để Kho chuẩn bị nhân lực và mặt bằng.</bpmn:documentation><bpmn:incoming>PP_F7</bpmn:incoming><bpmn:outgoing>PP_F8</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="PP_Recv" name="Nhập kho theo lô
và vị trí"><bpmn:documentation>Kho tạo phiếu nhập, gán lô và vị trí kho, ghi nhận số lượng thực nhận rồi ghi sổ.</bpmn:documentation><bpmn:incoming>PP_F8</bpmn:incoming><bpmn:outgoing>PP_F9</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="PP_Inv" name="Ghi nhận
hóa đơn đầu vào"><bpmn:documentation>Kế toán lập hóa đơn mua hàng căn cứ phiếu nhập kho, ghi nhận công nợ phải trả.</bpmn:documentation><bpmn:incoming>PP_F9</bpmn:incoming><bpmn:outgoing>PP_F10</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="PP_End" name="Hoàn tất mua hàng"><bpmn:documentation></bpmn:documentation><bpmn:incoming>PP_F10</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="PP_F1" sourceRef="PP_Start" targetRef="PP_MRP"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PP_F2" sourceRef="PP_MRP" targetRef="PP_PO"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PP_F3" sourceRef="PP_PO" targetRef="PP_Price"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PP_F4" sourceRef="PP_Price" targetRef="PP_G"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PP_F5" sourceRef="PP_G" targetRef="PP_Appr" name="Hợp lệ"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">priceMatchesContract = true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="PP_F6" sourceRef="PP_G" targetRef="PP_PO" name="Lệch giá"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PP_F7" sourceRef="PP_Appr" targetRef="PP_Sched"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PP_F8" sourceRef="PP_Sched" targetRef="PP_Recv"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PP_F9" sourceRef="PP_Recv" targetRef="PP_Inv"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PP_F10" sourceRef="PP_Inv" targetRef="PP_End"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="PurchasePlanned_diagram"><bpmndi:BPMNPlane id="PurchasePlanned_plane" bpmnElement="PurchasePlanned_collab"><bpmndi:BPMNShape id="PurchasePlanned_pool_di" bpmnElement="PurchasePlanned_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1700" height="528"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PurchasePlanned_lane_0_di" bpmnElement="PurchasePlanned_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1670" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PurchasePlanned_lane_1_di" bpmnElement="PurchasePlanned_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1670" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PurchasePlanned_lane_2_di" bpmnElement="PurchasePlanned_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="1670" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PP_Start_di" bpmnElement="PP_Start" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="PP_MRP_di" bpmnElement="PP_MRP" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="250" y="141" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PP_PO_di" bpmnElement="PP_PO" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="430" y="141" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PP_Price_di" bpmnElement="PP_Price" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="620" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PP_G_di" bpmnElement="PP_G" bioc:fill="#fff8e6" bioc:stroke="#b3812f"><dc:Bounds x="810" y="329" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="773" y="388" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="PP_Appr_di" bpmnElement="PP_Appr" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="920" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PP_Sched_di" bpmnElement="PP_Sched" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1110" y="141" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PP_Recv_di" bpmnElement="PP_Recv" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1300" y="493" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PP_Inv_di" bpmnElement="PP_Inv" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1490" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PP_End_di" bpmnElement="PP_End" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1680" y="336" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1636" y="381" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="PP_F1_di" bpmnElement="PP_F1" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="250" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PP_F2_di" bpmnElement="PP_F2" bioc:stroke="#7e90aa"><di:waypoint x="376" y="178"/><di:waypoint x="430" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PP_F3_di" bpmnElement="PP_F3" bioc:stroke="#7e90aa"><di:waypoint x="556" y="178"/><di:waypoint x="590" y="178"/><di:waypoint x="590" y="354"/><di:waypoint x="620" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PP_F4_di" bpmnElement="PP_F4" bioc:stroke="#7e90aa"><di:waypoint x="746" y="354"/><di:waypoint x="810" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PP_F5_di" bpmnElement="PP_F5" bioc:stroke="#7e90aa"><di:waypoint x="860" y="354"/><di:waypoint x="920" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PP_F6_di" bpmnElement="PP_F6" bioc:stroke="#7e90aa"><di:waypoint x="835" y="329"/><di:waypoint x="835" y="250"/><di:waypoint x="493" y="250"/><di:waypoint x="493" y="215"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PP_F7_di" bpmnElement="PP_F7" bioc:stroke="#7e90aa"><di:waypoint x="1046" y="354"/><di:waypoint x="1080" y="354"/><di:waypoint x="1080" y="178"/><di:waypoint x="1110" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PP_F8_di" bpmnElement="PP_F8" bioc:stroke="#7e90aa"><di:waypoint x="1236" y="178"/><di:waypoint x="1270" y="178"/><di:waypoint x="1270" y="530"/><di:waypoint x="1300" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PP_F9_di" bpmnElement="PP_F9" bioc:stroke="#7e90aa"><di:waypoint x="1426" y="530"/><di:waypoint x="1460" y="530"/><di:waypoint x="1460" y="354"/><di:waypoint x="1490" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PP_F10_di" bpmnElement="PP_F10" bioc:stroke="#7e90aa"><di:waypoint x="1616" y="354"/><di:waypoint x="1680" y="354"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>