<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="ProductionPlan_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="ProductionPlan_collab"><bpmn:participant id="ProductionPlan_pool" name="Lập kế hoạch sản xuất" processRef="ProductionPlan"/></bpmn:collaboration><bpmn:process id="ProductionPlan" name="Lập kế hoạch sản xuất" isExecutable="false"><bpmn:laneSet id="ProductionPlan_lanes"><bpmn:lane id="ProductionPlan_lane_0" name="Phòng Kinh doanh"><bpmn:flowNodeRef>MP_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>MP_Fc</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="ProductionPlan_lane_1" name="Bộ phận Kế hoạch sản xuất"><bpmn:flowNodeRef>MP_Copy</bpmn:flowNodeRef><bpmn:flowNodeRef>MP_Mps</bpmn:flowNodeRef><bpmn:flowNodeRef>MP_Firm</bpmn:flowNodeRef><bpmn:flowNodeRef>MP_End</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="ProductionPlan_lane_2" name="Ban Giám đốc sản xuất"><bpmn:flowNodeRef>MP_Adj</bpmn:flowNodeRef><bpmn:flowNodeRef>MP_Cap</bpmn:flowNodeRef><bpmn:flowNodeRef>MP_G</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="MP_Start" name="Có dự báo doanh số"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>MP_F1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="MP_Fc" name="Cung cấp
dự báo doanh số"><bpmn:documentation>Dự báo doanh số của Kinh doanh là đầu vào cho kế hoạch sản xuất kỳ tới.</bpmn:documentation><bpmn:incoming>MP_F1</bpmn:incoming><bpmn:outgoing>MP_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="MP_Copy" name="Sao chép dự báo
sang kế hoạch SX"><bpmn:documentation>Sao chép dữ liệu dự báo bán hàng thành nhu cầu sản xuất trong hệ thống.</bpmn:documentation><bpmn:incoming>MP_F2</bpmn:incoming><bpmn:outgoing>MP_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="MP_Adj" name="Điều chỉnh
kế hoạch chi tiết"><bpmn:documentation>Điều chỉnh kế hoạch chi tiết theo doanh số dự báo và định hướng điều hành.</bpmn:documentation><bpmn:incoming>MP_F3</bpmn:incoming><bpmn:incoming>MP_F7</bpmn:incoming><bpmn:outgoing>MP_F4</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="MP_Mps" name="Chạy MPS cho
thành phẩm và bán TP"><bpmn:documentation>Hệ thống quét dữ liệu kế hoạch và tồn kho để đề xuất lịch sản xuất.</bpmn:documentation><bpmn:incoming>MP_F4</bpmn:incoming><bpmn:outgoing>MP_F5</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="MP_Cap" name="Kiểm tra
năng lực sản xuất"><bpmn:documentation>Đối chiếu lịch hệ thống đề xuất với năng lực thực tế của xưởng.</bpmn:documentation><bpmn:incoming>MP_F5</bpmn:incoming><bpmn:outgoing>MP_F6</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="MP_G" name="Đủ năng lực?" default="MP_F7"><bpmn:documentation></bpmn:documentation><bpmn:incoming>MP_F6</bpmn:incoming><bpmn:outgoing>MP_F7</bpmn:outgoing><bpmn:outgoing>MP_F8</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="MP_Firm" name="Tạo Lệnh sản xuất"><bpmn:documentation>Tạo lệnh sản xuất từ màn hình kế hoạch sau khi lịch đã khả thi.</bpmn:documentation><bpmn:incoming>MP_F8</bpmn:incoming><bpmn:outgoing>MP_F9</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="MP_End" name="Có lệnh sản xuất"><bpmn:documentation></bpmn:documentation><bpmn:incoming>MP_F9</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="MP_F1" sourceRef="MP_Start" targetRef="MP_Fc"></bpmn:sequenceFlow><bpmn:sequenceFlow id="MP_F2" sourceRef="MP_Fc" targetRef="MP_Copy"></bpmn:sequenceFlow><bpmn:sequenceFlow id="MP_F3" sourceRef="MP_Copy" targetRef="MP_Adj"></bpmn:sequenceFlow><bpmn:sequenceFlow id="MP_F4" sourceRef="MP_Adj" targetRef="MP_Mps"></bpmn:sequenceFlow><bpmn:sequenceFlow id="MP_F5" sourceRef="MP_Mps" targetRef="MP_Cap"></bpmn:sequenceFlow><bpmn:sequenceFlow id="MP_F6" sourceRef="MP_Cap" targetRef="MP_G"></bpmn:sequenceFlow><bpmn:sequenceFlow id="MP_F7" sourceRef="MP_G" targetRef="MP_Adj" name="Chưa đủ"></bpmn:sequenceFlow><bpmn:sequenceFlow id="MP_F8" sourceRef="MP_G" targetRef="MP_Firm" name="Đủ năng lực"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">capacityAvailable = true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="MP_F9" sourceRef="MP_Firm" targetRef="MP_End"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="ProductionPlan_diagram"><bpmndi:BPMNPlane id="ProductionPlan_plane" bpmnElement="ProductionPlan_collab"><bpmndi:BPMNShape id="ProductionPlan_pool_di" bpmnElement="ProductionPlan_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1520" height="528"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="ProductionPlan_lane_0_di" bpmnElement="ProductionPlan_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1490" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="ProductionPlan_lane_1_di" bpmnElement="ProductionPlan_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1490" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="ProductionPlan_lane_2_di" bpmnElement="ProductionPlan_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="1490" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="MP_Start_di" bpmnElement="MP_Start" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="MP_Fc_di" bpmnElement="MP_Fc" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="250" y="141" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="MP_Copy_di" bpmnElement="MP_Copy" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="430" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="MP_Adj_di" bpmnElement="MP_Adj" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="620" y="493" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="MP_Mps_di" bpmnElement="MP_Mps" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="810" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="MP_Cap_di" bpmnElement="MP_Cap" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1000" y="493" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="MP_G_di" bpmnElement="MP_G" bioc:fill="#fff8e6" bioc:stroke="#b3812f"><dc:Bounds x="1190" y="505" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1153" y="564" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="MP_Firm_di" bpmnElement="MP_Firm" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1300" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="MP_End_di" bpmnElement="MP_End" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1490" y="336" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1446" y="381" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="MP_F1_di" bpmnElement="MP_F1" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="250" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="MP_F2_di" bpmnElement="MP_F2" bioc:stroke="#7e90aa"><di:waypoint x="376" y="178"/><di:waypoint x="400" y="178"/><di:waypoint x="400" y="354"/><di:waypoint x="430" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="MP_F3_di" bpmnElement="MP_F3" bioc:stroke="#7e90aa"><di:waypoint x="556" y="354"/><di:waypoint x="590" y="354"/><di:waypoint x="590" y="530"/><di:waypoint x="620" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="MP_F4_di" bpmnElement="MP_F4" bioc:stroke="#7e90aa"><di:waypoint x="746" y="530"/><di:waypoint x="780" y="530"/><di:waypoint x="780" y="354"/><di:waypoint x="810" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="MP_F5_di" bpmnElement="MP_F5" bioc:stroke="#7e90aa"><di:waypoint x="936" y="354"/><di:waypoint x="970" y="354"/><di:waypoint x="970" y="530"/><di:waypoint x="1000" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="MP_F6_di" bpmnElement="MP_F6" bioc:stroke="#7e90aa"><di:waypoint x="1126" y="530"/><di:waypoint x="1190" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="MP_F7_di" bpmnElement="MP_F7" bioc:stroke="#7e90aa"><di:waypoint x="1215" y="681"/><di:waypoint x="1215" y="760"/><di:waypoint x="683" y="760"/><di:waypoint x="683" y="681"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="MP_F8_di" bpmnElement="MP_F8" bioc:stroke="#7e90aa"><di:waypoint x="1215" y="505"/><di:waypoint x="1215" y="354"/><di:waypoint x="1300" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="MP_F9_di" bpmnElement="MP_F9" bioc:stroke="#7e90aa"><di:waypoint x="1426" y="354"/><di:waypoint x="1490" y="354"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>