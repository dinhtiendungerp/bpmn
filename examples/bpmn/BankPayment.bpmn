<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="BankPayment_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="BankPayment_collab"><bpmn:participant id="BankPayment_pool" name="Chi tiền qua ngân hàng" processRef="BankPayment"/></bpmn:collaboration><bpmn:process id="BankPayment" name="Chi tiền qua ngân hàng" isExecutable="false"><bpmn:laneSet id="BankPayment_lanes"><bpmn:lane id="BankPayment_lane_0" name="Bộ phận yêu cầu"><bpmn:flowNodeRef>BP_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>BP_Req</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="BankPayment_lane_1" name="Phòng Kế toán"><bpmn:flowNodeRef>BP_Ver</bpmn:flowNodeRef><bpmn:flowNodeRef>BP_G</bpmn:flowNodeRef><bpmn:flowNodeRef>BP_Jrn</bpmn:flowNodeRef><bpmn:flowNodeRef>BP_Xml</bpmn:flowNodeRef><bpmn:flowNodeRef>BP_Rec</bpmn:flowNodeRef><bpmn:flowNodeRef>BP_End</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="BankPayment_lane_2" name="Ban Giám đốc"><bpmn:flowNodeRef>BP_Appr</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="BankPayment_lane_3" name="Ngân hàng"><bpmn:flowNodeRef>BP_Pay</bpmn:flowNodeRef><bpmn:flowNodeRef>BP_Stmt</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="BP_Start" name="Phát sinh nhu cầu chi"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>BP_F1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="BP_Req" name="Lập đề nghị
thanh toán"><bpmn:documentation>Bộ phận có nhu cầu lập đề nghị thanh toán kèm chứng từ; trưởng bộ phận ký duyệt trước khi gửi Kế toán.</bpmn:documentation><bpmn:incoming>BP_F1</bpmn:incoming><bpmn:incoming>BP_F5</bpmn:incoming><bpmn:outgoing>BP_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="BP_Ver" name="Tiếp nhận
và thẩm định"><bpmn:documentation>Kế toán kiểm tra tính hợp lệ của bộ chứng từ và trình phê duyệt theo phân cấp.</bpmn:documentation><bpmn:incoming>BP_F2</bpmn:incoming><bpmn:outgoing>BP_F3</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="BP_G" name="Hồ sơ hợp lệ?" default="BP_F5"><bpmn:documentation></bpmn:documentation><bpmn:incoming>BP_F3</bpmn:incoming><bpmn:outgoing>BP_F4</bpmn:outgoing><bpmn:outgoing>BP_F5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="BP_Jrn" name="Tạo bút toán chi
trên Payment Journal"><bpmn:documentation>Tạo bút toán thanh toán bằng tiền mặt hoặc chuyển khoản, tham chiếu hóa đơn và đề nghị đã duyệt.</bpmn:documentation><bpmn:incoming>BP_F4</bpmn:incoming><bpmn:outgoing>BP_F6</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="BP_Xml" name="Kết xuất lệnh
và gửi ngân hàng"><bpmn:documentation>Kết xuất tệp lệnh thanh toán từ hệ thống rồi nạp lên cổng ngân hàng, hoặc gửi thẳng nếu đã tích hợp trực tiếp.</bpmn:documentation><bpmn:incoming>BP_F6</bpmn:incoming><bpmn:outgoing>BP_F7</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="BP_Appr" name="Duyệt lệnh chi
trên hệ thống ngân hàng"><bpmn:documentation>Người có thẩm quyền duyệt lệnh trên hệ thống ngân hàng để lệnh được thực hiện.</bpmn:documentation><bpmn:incoming>BP_F7</bpmn:incoming><bpmn:outgoing>BP_F8</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="BP_Pay" name="Đi lệnh chuyển tiền"><bpmn:documentation>Ngân hàng thực hiện chuyển tiền theo lệnh đã được duyệt.</bpmn:documentation><bpmn:incoming>BP_F8</bpmn:incoming><bpmn:outgoing>BP_F9</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="BP_Stmt" name="Trả thông tin
sao kê về hệ thống"><bpmn:documentation>Thông tin sao kê được gửi về màn hình đối chiếu ngân hàng trong hệ thống.</bpmn:documentation><bpmn:incoming>BP_F9</bpmn:incoming><bpmn:outgoing>BP_F10</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="BP_Rec" name="Đối chiếu sao kê
và hạch toán"><bpmn:documentation>Kế toán đối chiếu các lệnh đã hoàn thành, hệ thống ghi nhận hạch toán và in phiếu chi theo mẫu quy định.</bpmn:documentation><bpmn:incoming>BP_F10</bpmn:incoming><bpmn:outgoing>BP_F11</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="BP_End" name="Hoàn tất chi tiền"><bpmn:documentation></bpmn:documentation><bpmn:incoming>BP_F11</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="BP_F1" sourceRef="BP_Start" targetRef="BP_Req"></bpmn:sequenceFlow><bpmn:sequenceFlow id="BP_F2" sourceRef="BP_Req" targetRef="BP_Ver"></bpmn:sequenceFlow><bpmn:sequenceFlow id="BP_F3" sourceRef="BP_Ver" targetRef="BP_G"></bpmn:sequenceFlow><bpmn:sequenceFlow id="BP_F4" sourceRef="BP_G" targetRef="BP_Jrn" name="Hợp lệ"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">documentsComplete = true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="BP_F5" sourceRef="BP_G" targetRef="BP_Req" name="Thiếu chứng từ"></bpmn:sequenceFlow><bpmn:sequenceFlow id="BP_F6" sourceRef="BP_Jrn" targetRef="BP_Xml"></bpmn:sequenceFlow><bpmn:sequenceFlow id="BP_F7" sourceRef="BP_Xml" targetRef="BP_Appr"></bpmn:sequenceFlow><bpmn:sequenceFlow id="BP_F8" sourceRef="BP_Appr" targetRef="BP_Pay"></bpmn:sequenceFlow><bpmn:sequenceFlow id="BP_F9" sourceRef="BP_Pay" targetRef="BP_Stmt"></bpmn:sequenceFlow><bpmn:sequenceFlow id="BP_F10" sourceRef="BP_Stmt" targetRef="BP_Rec"></bpmn:sequenceFlow><bpmn:sequenceFlow id="BP_F11" sourceRef="BP_Rec" targetRef="BP_End"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="BankPayment_diagram"><bpmndi:BPMNPlane id="BankPayment_plane" bpmnElement="BankPayment_collab"><bpmndi:BPMNShape id="BankPayment_pool_di" bpmnElement="BankPayment_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="2000" height="704"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="BankPayment_lane_0_di" bpmnElement="BankPayment_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1970" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="BankPayment_lane_1_di" bpmnElement="BankPayment_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1970" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="BankPayment_lane_2_di" bpmnElement="BankPayment_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="1970" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="BankPayment_lane_3_di" bpmnElement="BankPayment_lane_3" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="618" width="1970" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="BP_Start_di" bpmnElement="BP_Start" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="BP_Req_di" bpmnElement="BP_Req" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="250" y="141" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="BP_Ver_di" bpmnElement="BP_Ver" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="440" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="BP_G_di" bpmnElement="BP_G" bioc:fill="#fff8e6" bioc:stroke="#b3812f"><dc:Bounds x="630" y="329" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="593" y="388" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="BP_Jrn_di" bpmnElement="BP_Jrn" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="740" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="BP_Xml_di" bpmnElement="BP_Xml" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="930" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="BP_Appr_di" bpmnElement="BP_Appr" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1120" y="493" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="BP_Pay_di" bpmnElement="BP_Pay" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1310" y="669" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="BP_Stmt_di" bpmnElement="BP_Stmt" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1500" y="669" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="BP_Rec_di" bpmnElement="BP_Rec" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1690" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="BP_End_di" bpmnElement="BP_End" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1880" y="336" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1836" y="381" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="BP_F1_di" bpmnElement="BP_F1" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="250" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="BP_F2_di" bpmnElement="BP_F2" bioc:stroke="#7e90aa"><di:waypoint x="376" y="178"/><di:waypoint x="410" y="178"/><di:waypoint x="410" y="354"/><di:waypoint x="440" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="BP_F3_di" bpmnElement="BP_F3" bioc:stroke="#7e90aa"><di:waypoint x="566" y="354"/><di:waypoint x="630" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="BP_F4_di" bpmnElement="BP_F4" bioc:stroke="#7e90aa"><di:waypoint x="680" y="354"/><di:waypoint x="740" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="BP_F5_di" bpmnElement="BP_F5" bioc:stroke="#7e90aa"><di:waypoint x="655" y="329"/><di:waypoint x="655" y="250"/><di:waypoint x="313" y="250"/><di:waypoint x="313" y="215"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="BP_F6_di" bpmnElement="BP_F6" bioc:stroke="#7e90aa"><di:waypoint x="866" y="354"/><di:waypoint x="930" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="BP_F7_di" bpmnElement="BP_F7" bioc:stroke="#7e90aa"><di:waypoint x="1056" y="354"/><di:waypoint x="1090" y="354"/><di:waypoint x="1090" y="530"/><di:waypoint x="1120" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="BP_F8_di" bpmnElement="BP_F8" bioc:stroke="#7e90aa"><di:waypoint x="1246" y="530"/><di:waypoint x="1280" y="530"/><di:waypoint x="1280" y="706"/><di:waypoint x="1310" y="706"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="BP_F9_di" bpmnElement="BP_F9" bioc:stroke="#7e90aa"><di:waypoint x="1436" y="706"/><di:waypoint x="1500" y="706"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="BP_F10_di" bpmnElement="BP_F10" bioc:stroke="#7e90aa"><di:waypoint x="1563" y="669"/><di:waypoint x="1563" y="354"/><di:waypoint x="1690" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="BP_F11_di" bpmnElement="BP_F11" bioc:stroke="#7e90aa"><di:waypoint x="1816" y="354"/><di:waypoint x="1880" y="354"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>