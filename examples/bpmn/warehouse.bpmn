<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Warehouse_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="Warehouse_collab"><bpmn:participant id="Warehouse_pool" name="Nhập kho &amp; kiểm tra QC" processRef="Warehouse"/></bpmn:collaboration><bpmn:process id="Warehouse" name="Nhập kho &amp; kiểm tra QC" isExecutable="false"><bpmn:laneSet id="Warehouse_lanes"><bpmn:lane id="Warehouse_lane_0" name="Nhân viên kho"><bpmn:flowNodeRef>W_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>W_Receive</bpmn:flowNodeRef><bpmn:flowNodeRef>W_Putaway</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Warehouse_lane_1" name="Bộ phận chất lượng"><bpmn:flowNodeRef>W_QC</bpmn:flowNodeRef><bpmn:flowNodeRef>W_Result</bpmn:flowNodeRef><bpmn:flowNodeRef>W_Hold</bpmn:flowNodeRef><bpmn:flowNodeRef>W_Rejected</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Warehouse_lane_2" name="Kế toán kho"><bpmn:flowNodeRef>W_Post</bpmn:flowNodeRef><bpmn:flowNodeRef>W_End</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="W_Start" name="Hàng đến kho"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>W_F1</bpmn:outgoing></bpmn:startEvent><bpmn:manualTask id="W_Receive" name="Nhận hàng &amp;
ghi nhận lô"><bpmn:documentation>Đối chiếu hàng nhận và chứng từ. Ghi nhận Lot, số lượng và Pallet nếu có.</bpmn:documentation><bpmn:incoming>W_F1</bpmn:incoming><bpmn:outgoing>W_F2</bpmn:outgoing></bpmn:manualTask><bpmn:userTask id="W_QC" name="Thực hiện QC"><bpmn:documentation>Kiểm tra chất lượng theo quy định. Tồn kho thương mại chưa được xuất bán trước khi QC đạt.</bpmn:documentation><bpmn:incoming>W_F2</bpmn:incoming><bpmn:outgoing>W_F3</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="W_Result" name="QC đạt?" default="W_Fail"><bpmn:documentation></bpmn:documentation><bpmn:incoming>W_F3</bpmn:incoming><bpmn:outgoing>W_Fail</bpmn:outgoing><bpmn:outgoing>W_Pass</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="W_Hold" name="Cách ly &amp;
lập phiếu lỗi"><bpmn:documentation></bpmn:documentation><bpmn:incoming>W_Fail</bpmn:incoming><bpmn:outgoing>W_F5</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="W_Rejected" name="Chờ xử lý lỗi"><bpmn:documentation></bpmn:documentation><bpmn:incoming>W_F5</bpmn:incoming></bpmn:endEvent><bpmn:manualTask id="W_Putaway" name="Đưa hàng
vào bin"><bpmn:documentation></bpmn:documentation><bpmn:incoming>W_Pass</bpmn:incoming><bpmn:outgoing>W_F7</bpmn:outgoing></bpmn:manualTask><bpmn:serviceTask id="W_Post" name="Cập nhật tồn kho
khả dụng"><bpmn:documentation></bpmn:documentation><bpmn:incoming>W_F7</bpmn:incoming><bpmn:outgoing>W_F8</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="W_End" name="Hoàn tất"><bpmn:documentation></bpmn:documentation><bpmn:incoming>W_F8</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="W_F1" sourceRef="W_Start" targetRef="W_Receive"></bpmn:sequenceFlow><bpmn:sequenceFlow id="W_F2" sourceRef="W_Receive" targetRef="W_QC"></bpmn:sequenceFlow><bpmn:sequenceFlow id="W_F3" sourceRef="W_QC" targetRef="W_Result"></bpmn:sequenceFlow><bpmn:sequenceFlow id="W_Fail" sourceRef="W_Result" targetRef="W_Hold" name="Không đạt"></bpmn:sequenceFlow><bpmn:sequenceFlow id="W_F5" sourceRef="W_Hold" targetRef="W_Rejected"></bpmn:sequenceFlow><bpmn:sequenceFlow id="W_Pass" sourceRef="W_Result" targetRef="W_Putaway" name="Đạt"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">qcPassed = true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="W_F7" sourceRef="W_Putaway" targetRef="W_Post"></bpmn:sequenceFlow><bpmn:sequenceFlow id="W_F8" sourceRef="W_Post" targetRef="W_End"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="Warehouse_diagram"><bpmndi:BPMNPlane id="Warehouse_plane" bpmnElement="Warehouse_collab"><bpmndi:BPMNShape id="Warehouse_pool_di" bpmnElement="Warehouse_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1120" height="462"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Warehouse_lane_0_di" bpmnElement="Warehouse_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1090" height="154"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Warehouse_lane_1_di" bpmnElement="Warehouse_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="244" width="1090" height="154"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Warehouse_lane_2_di" bpmnElement="Warehouse_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="398" width="1090" height="154"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="W_Start_di" bpmnElement="W_Start" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="147" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="192" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="W_Receive_di" bpmnElement="W_Receive" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="242" y="128" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="W_QC_di" bpmnElement="W_QC" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="438" y="282" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="W_Result_di" bpmnElement="W_Result" bioc:fill="#fff8e6" bioc:stroke="#b3812f"><dc:Bounds x="626" y="294" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="589" y="353" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="W_Hold_di" bpmnElement="W_Hold" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="752" y="282" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="W_Rejected_di" bpmnElement="W_Rejected" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="954" y="301" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="910" y="346" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="W_Putaway_di" bpmnElement="W_Putaway" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="752" y="128" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="W_Post_di" bpmnElement="W_Post" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="933" y="436" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="W_End_di" bpmnElement="W_End" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1110" y="455" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1066" y="500" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="W_F1_di" bpmnElement="W_F1" bioc:stroke="#7e90aa"><di:waypoint x="186" y="165"/><di:waypoint x="242" y="165"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="W_F2_di" bpmnElement="W_F2" bioc:stroke="#7e90aa"><di:waypoint x="368" y="165"/><di:waypoint x="400" y="165"/><di:waypoint x="400" y="319"/><di:waypoint x="438" y="319"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="W_F3_di" bpmnElement="W_F3" bioc:stroke="#7e90aa"><di:waypoint x="564" y="319"/><di:waypoint x="626" y="319"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="W_Fail_di" bpmnElement="W_Fail" bioc:stroke="#7e90aa"><di:waypoint x="676" y="319"/><di:waypoint x="752" y="319"/><bpmndi:BPMNLabel><dc:Bounds x="640" y="268" width="100" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="W_F5_di" bpmnElement="W_F5" bioc:stroke="#7e90aa"><di:waypoint x="878" y="319"/><di:waypoint x="954" y="319"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="W_Pass_di" bpmnElement="W_Pass" bioc:stroke="#7e90aa"><di:waypoint x="651" y="294"/><di:waypoint x="651" y="165"/><di:waypoint x="752" y="165"/><bpmndi:BPMNLabel><dc:Bounds x="660" y="222" width="100" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="W_F7_di" bpmnElement="W_F7" bioc:stroke="#7e90aa"><di:waypoint x="878" y="165"/><di:waypoint x="900" y="165"/><di:waypoint x="900" y="473"/><di:waypoint x="933" y="473"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="W_F8_di" bpmnElement="W_F8" bioc:stroke="#7e90aa"><di:waypoint x="1059" y="473"/><di:waypoint x="1110" y="473"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>