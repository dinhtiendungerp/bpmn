<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Purchase_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="Purchase_collab"><bpmn:participant id="Purchase_pool" name="Yêu cầu mua hàng" processRef="Purchase"/></bpmn:collaboration><bpmn:process id="Purchase" name="Yêu cầu mua hàng" isExecutable="false"><bpmn:laneSet id="Purchase_lanes"><bpmn:lane id="Purchase_lane_0" name="Người yêu cầu"><bpmn:flowNodeRef>Start_Request</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Request</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Revise</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Purchase_lane_1" name="Người phê duyệt"><bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Purchase_lane_2" name="Hệ thống ERP"><bpmn:flowNodeRef>Task_PO</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Request</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start_Request" name="Phát sinh nhu cầu"><bpmn:documentation>Quy trình bắt đầu khi bộ phận có nhu cầu mua hàng.</bpmn:documentation><bpmn:outgoing>Flow_Start</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Task_Request" name="Lập yêu cầu
mua hàng"><bpmn:documentation>Người yêu cầu khai báo mặt hàng, số lượng, ngày cần hàng và mục đích. Gửi yêu cầu sau khi kiểm tra thông tin.</bpmn:documentation><bpmn:incoming>Flow_Start</bpmn:incoming><bpmn:outgoing>Flow_Submit</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_Review" name="Kiểm tra &amp;
phê duyệt"><bpmn:documentation>Người phê duyệt kiểm tra nhu cầu, hạn mức và ngân sách. Ghi rõ lý do nếu yêu cầu cần bổ sung.</bpmn:documentation><bpmn:incoming>Flow_Submit</bpmn:incoming><bpmn:incoming>Flow_Resubmit</bpmn:incoming><bpmn:outgoing>Flow_Decide</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_Approved" name="Được duyệt?" default="Flow_Revise"><bpmn:documentation>Chỉ một nhánh được chọn. Nếu approved = true, tạo đơn mua; nhánh mặc định yêu cầu bổ sung.</bpmn:documentation><bpmn:incoming>Flow_Decide</bpmn:incoming><bpmn:outgoing>Flow_Revise</bpmn:outgoing><bpmn:outgoing>Flow_Approved</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_Revise" name="Bổ sung
yêu cầu"><bpmn:documentation>Bổ sung thông tin theo phản hồi, sau đó gửi lại bước phê duyệt.</bpmn:documentation><bpmn:incoming>Flow_Revise</bpmn:incoming><bpmn:outgoing>Flow_Resubmit</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Task_PO" name="Tạo đơn mua
trên ERP"><bpmn:documentation>Điểm tích hợp dự kiến: tạo Purchase Order sau khi yêu cầu được duyệt. Cần cấu hình connector hoặc worker để thực thi thật.</bpmn:documentation><bpmn:incoming>Flow_Approved</bpmn:incoming><bpmn:outgoing>Flow_PO</bpmn:outgoing></bpmn:serviceTask><bpmn:sendTask id="Task_Notify" name="Gửi thông báo
kết quả"><bpmn:documentation>Thông báo số đơn mua cho người yêu cầu. Mô phỏng không gửi email hoặc tạo dữ liệu ERP.</bpmn:documentation><bpmn:incoming>Flow_PO</bpmn:incoming><bpmn:outgoing>Flow_Done</bpmn:outgoing></bpmn:sendTask><bpmn:endEvent id="End_Request" name="Hoàn tất"><bpmn:documentation>Yêu cầu mua hàng hoàn tất sau khi thông báo kết quả.</bpmn:documentation><bpmn:incoming>Flow_Done</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_Start" sourceRef="Start_Request" targetRef="Task_Request"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Submit" sourceRef="Task_Request" targetRef="Task_Review" name="Gửi duyệt"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Decide" sourceRef="Task_Review" targetRef="Gateway_Approved"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Revise" sourceRef="Gateway_Approved" targetRef="Task_Revise" name="Cần bổ sung"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Resubmit" sourceRef="Task_Revise" targetRef="Task_Review" name="Gửi lại"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Approved" sourceRef="Gateway_Approved" targetRef="Task_PO" name="Đồng ý"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved = true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_PO" sourceRef="Task_PO" targetRef="Task_Notify"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Done" sourceRef="Task_Notify" targetRef="End_Request"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="Purchase_diagram"><bpmndi:BPMNPlane id="Purchase_plane" bpmnElement="Purchase_collab"><bpmndi:BPMNShape id="Purchase_pool_di" bpmnElement="Purchase_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1130" height="462"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Purchase_lane_0_di" bpmnElement="Purchase_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1100" height="154"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Purchase_lane_1_di" bpmnElement="Purchase_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="244" width="1100" height="154"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Purchase_lane_2_di" bpmnElement="Purchase_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="398" width="1100" height="154"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Start_Request_di" bpmnElement="Start_Request" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="172" y="147" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="140" y="207" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Request_di" bpmnElement="Task_Request" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="244" y="128" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="433" y="286" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gateway_Approved_di" bpmnElement="Gateway_Approved" bioc:fill="#fff8e6" bioc:stroke="#b3812f"><dc:Bounds x="627" y="298" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="690" y="355" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Revise_di" bpmnElement="Task_Revise" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="740" y="128" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_PO_di" bpmnElement="Task_PO" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="740" y="436" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Notify_di" bpmnElement="Task_Notify" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="923" y="436" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="End_Request_di" bpmnElement="End_Request" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1100" y="455" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1056" y="500" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_Start_di" bpmnElement="Flow_Start" bioc:stroke="#7e90aa"><di:waypoint x="208" y="165"/><di:waypoint x="244" y="165"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_Submit_di" bpmnElement="Flow_Submit" bioc:stroke="#7e90aa"><di:waypoint x="370" y="165"/><di:waypoint x="401" y="165"/><di:waypoint x="401" y="323"/><di:waypoint x="433" y="323"/><bpmndi:BPMNLabel><dc:Bounds x="280" y="218" width="100" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_Decide_di" bpmnElement="Flow_Decide" bioc:stroke="#7e90aa"><di:waypoint x="559" y="323"/><di:waypoint x="627" y="323"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_Revise_di" bpmnElement="Flow_Revise" bioc:stroke="#7e90aa"><di:waypoint x="652" y="298"/><di:waypoint x="652" y="165"/><di:waypoint x="740" y="165"/><bpmndi:BPMNLabel><dc:Bounds x="660" y="213" width="100" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_Resubmit_di" bpmnElement="Flow_Resubmit" bioc:stroke="#7e90aa"><di:waypoint x="803" y="128"/><di:waypoint x="803" y="105"/><di:waypoint x="496" y="105"/><di:waypoint x="496" y="286"/><bpmndi:BPMNLabel><dc:Bounds x="570" y="111" width="100" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved" bioc:stroke="#7e90aa"><di:waypoint x="652" y="348"/><di:waypoint x="652" y="473"/><di:waypoint x="740" y="473"/><bpmndi:BPMNLabel><dc:Bounds x="653" y="403" width="100" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_PO_di" bpmnElement="Flow_PO" bioc:stroke="#7e90aa"><di:waypoint x="866" y="473"/><di:waypoint x="923" y="473"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_Done_di" bpmnElement="Flow_Done" bioc:stroke="#7e90aa"><di:waypoint x="1049" y="473"/><di:waypoint x="1100" y="473"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>