<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="SalesReturn_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="SalesReturn_collab"><bpmn:participant id="SalesReturn_pool" name="Quản lý Đơn trả hàng bán" processRef="SalesReturn"/></bpmn:collaboration><bpmn:process id="SalesReturn" name="Quản lý Đơn trả hàng bán" isExecutable="false"><bpmn:laneSet id="SalesReturn_lanes"><bpmn:lane id="SalesReturn_lane_0" name="Phòng Kinh doanh"><bpmn:flowNodeRef>SR_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>SR_Recv</bpmn:flowNodeRef><bpmn:flowNodeRef>SR_Create</bpmn:flowNodeRef><bpmn:flowNodeRef>SR_Appr</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="SalesReturn_lane_1" name="Bộ phận Kho"><bpmn:flowNodeRef>SR_Wh</bpmn:flowNodeRef><bpmn:flowNodeRef>SR_Dmg</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="SalesReturn_lane_2" name="Bộ phận Quản lý chất lượng"><bpmn:flowNodeRef>SR_Qc</bpmn:flowNodeRef><bpmn:flowNodeRef>SR_G</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="SalesReturn_lane_3" name="Phòng Kế toán"><bpmn:flowNodeRef>SR_Cn</bpmn:flowNodeRef><bpmn:flowNodeRef>SR_Ar</bpmn:flowNodeRef><bpmn:flowNodeRef>SR_End</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="SR_Start" name="Khách hàng yêu cầu trả"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>SR_F1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="SR_Recv" name="Tiếp nhận
yêu cầu trả"><bpmn:documentation>Xác định lý do trả: hàng lỗi, hàng cận hạn dùng, sai đơn đặt hoặc điều chỉnh doanh số.</bpmn:documentation><bpmn:incoming>SR_F1</bpmn:incoming><bpmn:outgoing>SR_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="SR_Create" name="Lập Đơn trả hàng bán"><bpmn:documentation>Lập đơn tham chiếu phiếu giao hàng gốc; số lượng trả không vượt quá số lượng đã giao.</bpmn:documentation><bpmn:incoming>SR_F2</bpmn:incoming><bpmn:outgoing>SR_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="SR_Appr" name="Phê duyệt Đơn trả"><bpmn:documentation>Phê duyệt để kiểm soát tính chính đáng của việc trả hàng.</bpmn:documentation><bpmn:incoming>SR_F3</bpmn:incoming><bpmn:outgoing>SR_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="SR_Wh" name="Nhận hàng trả về kho"><bpmn:documentation>Kho tiếp nhận theo đơn trả và gán đúng lô đã xuất trước đây để bảo đảm truy vết.</bpmn:documentation><bpmn:incoming>SR_F4</bpmn:incoming><bpmn:outgoing>SR_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="SR_Qc" name="Kiểm tra chất lượng
hàng trả"><bpmn:documentation>Kiểm tra tình trạng hàng trả về để xác định còn bán lại được hay phải xử lý hư hỏng.</bpmn:documentation><bpmn:incoming>SR_F5</bpmn:incoming><bpmn:outgoing>SR_F6</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="SR_G" name="Còn bán được?" default="SR_F7"><bpmn:documentation></bpmn:documentation><bpmn:incoming>SR_F6</bpmn:incoming><bpmn:outgoing>SR_F7</bpmn:outgoing><bpmn:outgoing>SR_F8</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="SR_Dmg" name="Xử lý hàng hư hỏng"><bpmn:documentation>Ghi nhận chi phí sửa chữa bao bì hoặc hủy hàng, phân bổ vào chi phí tương ứng.</bpmn:documentation><bpmn:incoming>SR_F7</bpmn:incoming><bpmn:outgoing>SR_F9</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="SR_Cn" name="Hóa đơn
điều chỉnh giảm"><bpmn:documentation>Phát hành hóa đơn điều chỉnh giảm cho khách hàng; công nợ phải thu giảm tương ứng.</bpmn:documentation><bpmn:incoming>SR_F8</bpmn:incoming><bpmn:incoming>SR_F9</bpmn:incoming><bpmn:outgoing>SR_F10</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="SR_Ar" name="Kiểm tra công nợ"><bpmn:documentation>Đối chiếu số dư công nợ khách hàng sau điều chỉnh giữa hóa đơn gốc và hóa đơn điều chỉnh.</bpmn:documentation><bpmn:incoming>SR_F10</bpmn:incoming><bpmn:outgoing>SR_F11</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="SR_End" name="Hoàn tất trả hàng"><bpmn:documentation></bpmn:documentation><bpmn:incoming>SR_F11</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="SR_F1" sourceRef="SR_Start" targetRef="SR_Recv"></bpmn:sequenceFlow><bpmn:sequenceFlow id="SR_F2" sourceRef="SR_Recv" targetRef="SR_Create"></bpmn:sequenceFlow><bpmn:sequenceFlow id="SR_F3" sourceRef="SR_Create" targetRef="SR_Appr"></bpmn:sequenceFlow><bpmn:sequenceFlow id="SR_F4" sourceRef="SR_Appr" targetRef="SR_Wh"></bpmn:sequenceFlow><bpmn:sequenceFlow id="SR_F5" sourceRef="SR_Wh" targetRef="SR_Qc"></bpmn:sequenceFlow><bpmn:sequenceFlow id="SR_F6" sourceRef="SR_Qc" targetRef="SR_G"></bpmn:sequenceFlow><bpmn:sequenceFlow id="SR_F7" sourceRef="SR_G" targetRef="SR_Dmg" name="Không đạt"></bpmn:sequenceFlow><bpmn:sequenceFlow id="SR_F8" sourceRef="SR_G" targetRef="SR_Cn" name="Còn bán được"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">resellable = true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="SR_F9" sourceRef="SR_Dmg" targetRef="SR_Cn"></bpmn:sequenceFlow><bpmn:sequenceFlow id="SR_F10" sourceRef="SR_Cn" targetRef="SR_Ar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="SR_F11" sourceRef="SR_Ar" targetRef="SR_End"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="SalesReturn_diagram"><bpmndi:BPMNPlane id="SalesReturn_plane" bpmnElement="SalesReturn_collab"><bpmndi:BPMNShape id="SalesReturn_pool_di" bpmnElement="SalesReturn_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1880" height="704"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="SalesReturn_lane_0_di" bpmnElement="SalesReturn_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1850" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="SalesReturn_lane_1_di" bpmnElement="SalesReturn_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1850" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="SalesReturn_lane_2_di" bpmnElement="SalesReturn_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="1850" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="SalesReturn_lane_3_di" bpmnElement="SalesReturn_lane_3" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="618" width="1850" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="SR_Start_di" bpmnElement="SR_Start" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="SR_Recv_di" bpmnElement="SR_Recv" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="250" y="141" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="SR_Create_di" bpmnElement="SR_Create" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="430" y="141" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="SR_Appr_di" bpmnElement="SR_Appr" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="620" y="141" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="SR_Wh_di" bpmnElement="SR_Wh" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="810" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="SR_Qc_di" bpmnElement="SR_Qc" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1000" y="493" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="SR_G_di" bpmnElement="SR_G" bioc:fill="#fff8e6" bioc:stroke="#b3812f"><dc:Bounds x="1190" y="505" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1153" y="564" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="SR_Dmg_di" bpmnElement="SR_Dmg" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1300" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="SR_Cn_di" bpmnElement="SR_Cn" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1490" y="669" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="SR_Ar_di" bpmnElement="SR_Ar" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1680" y="669" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="SR_End_di" bpmnElement="SR_End" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1870" y="688" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1826" y="733" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="SR_F1_di" bpmnElement="SR_F1" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="250" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="SR_F2_di" bpmnElement="SR_F2" bioc:stroke="#7e90aa"><di:waypoint x="376" y="178"/><di:waypoint x="430" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="SR_F3_di" bpmnElement="SR_F3" bioc:stroke="#7e90aa"><di:waypoint x="556" y="178"/><di:waypoint x="620" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="SR_F4_di" bpmnElement="SR_F4" bioc:stroke="#7e90aa"><di:waypoint x="746" y="178"/><di:waypoint x="780" y="178"/><di:waypoint x="780" y="354"/><di:waypoint x="810" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="SR_F5_di" bpmnElement="SR_F5" bioc:stroke="#7e90aa"><di:waypoint x="936" y="354"/><di:waypoint x="970" y="354"/><di:waypoint x="970" y="530"/><di:waypoint x="1000" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="SR_F6_di" bpmnElement="SR_F6" bioc:stroke="#7e90aa"><di:waypoint x="1126" y="530"/><di:waypoint x="1190" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="SR_F7_di" bpmnElement="SR_F7" bioc:stroke="#7e90aa"><di:waypoint x="1215" y="505"/><di:waypoint x="1215" y="354"/><di:waypoint x="1300" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="SR_F8_di" bpmnElement="SR_F8" bioc:stroke="#7e90aa"><di:waypoint x="1215" y="555"/><di:waypoint x="1215" y="706"/><di:waypoint x="1490" y="706"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="SR_F9_di" bpmnElement="SR_F9" bioc:stroke="#7e90aa"><di:waypoint x="1426" y="354"/><di:waypoint x="1460" y="354"/><di:waypoint x="1460" y="706"/><di:waypoint x="1490" y="706"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="SR_F10_di" bpmnElement="SR_F10" bioc:stroke="#7e90aa"><di:waypoint x="1616" y="706"/><di:waypoint x="1680" y="706"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="SR_F11_di" bpmnElement="SR_F11" bioc:stroke="#7e90aa"><di:waypoint x="1806" y="706"/><di:waypoint x="1870" y="706"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>