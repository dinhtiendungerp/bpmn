<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="ProductionCosting_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="ProductionCosting_collab"><bpmn:participant id="ProductionCosting_pool" name="Tính giá thành sản xuất" processRef="ProductionCosting"/></bpmn:collaboration><bpmn:process id="ProductionCosting" name="Tính giá thành sản xuất" isExecutable="false"><bpmn:laneSet id="ProductionCosting_lanes"><bpmn:lane id="ProductionCosting_lane_0" name="Phòng Sản xuất"><bpmn:flowNodeRef>PC_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>PC_Out</bpmn:flowNodeRef><bpmn:flowNodeRef>PC_Fin</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="ProductionCosting_lane_1" name="Phòng Kế toán"><bpmn:flowNodeRef>PC_Lab</bpmn:flowNodeRef><bpmn:flowNodeRef>PC_Chk</bpmn:flowNodeRef><bpmn:flowNodeRef>PC_Adj1</bpmn:flowNodeRef><bpmn:flowNodeRef>PC_Alloc</bpmn:flowNodeRef><bpmn:flowNodeRef>PC_Adj2</bpmn:flowNodeRef><bpmn:flowNodeRef>PC_Rpt</bpmn:flowNodeRef><bpmn:flowNodeRef>PC_End</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="PC_Start" name="Đến kỳ tính giá thành"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>PC_F1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="PC_Out" name="Cập nhật Output
và Consumption"><bpmn:documentation>Hằng ngày cập nhật sản lượng và tiêu hao thực tế từ báo cáo sản xuất.</bpmn:documentation><bpmn:incoming>PC_F1</bpmn:incoming><bpmn:outgoing>PC_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="PC_Fin" name="Chuyển lệnh sản xuất
sang Finished"><bpmn:documentation>Chuyển trạng thái các lệnh sản xuất đã hoàn thành để chốt số liệu tính giá.</bpmn:documentation><bpmn:incoming>PC_F2</bpmn:incoming><bpmn:outgoing>PC_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="PC_Lab" name="Ghi nhận chi phí
nhân công và SX chung"><bpmn:documentation>Hạch toán chi phí nhân công và sản xuất chung vào sổ nhật ký theo từng nhà máy.</bpmn:documentation><bpmn:incoming>PC_F3</bpmn:incoming><bpmn:outgoing>PC_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="PC_Chk" name="Kiểm tra lệnh SX
cuối kỳ"><bpmn:documentation>Rà soát toàn bộ sản lượng và tiêu hao trước khi phân bổ chi phí.</bpmn:documentation><bpmn:incoming>PC_F4</bpmn:incoming><bpmn:outgoing>PC_F5</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="PC_Adj1" name="Adjust Cost
và Post to G/L"><bpmn:documentation>Cập nhật giá vốn nguyên vật liệu vào sổ cái.</bpmn:documentation><bpmn:incoming>PC_F5</bpmn:incoming><bpmn:outgoing>PC_F6</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="PC_Alloc" name="Phân bổ chi phí
cho từng lệnh SX"><bpmn:documentation>Phân bổ chi phí nhân công và sản xuất chung cho từng lệnh sản xuất theo tiêu thức đã chọn.</bpmn:documentation><bpmn:incoming>PC_F6</bpmn:incoming><bpmn:outgoing>PC_F7</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="PC_Adj2" name="Adjust Cost
lần hai"><bpmn:documentation>Đẩy kết quả phân bổ vào sổ cái để hoàn tất giá thành.</bpmn:documentation><bpmn:incoming>PC_F7</bpmn:incoming><bpmn:outgoing>PC_F8</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="PC_Rpt" name="Báo cáo
Inventory Valuation"><bpmn:documentation>Kiểm tra chi phí nguyên vật liệu và sản xuất chung đã phân bổ đúng, đối chiếu giá trị dở dang.</bpmn:documentation><bpmn:incoming>PC_F8</bpmn:incoming><bpmn:outgoing>PC_F9</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="PC_End" name="Chốt giá thành kỳ"><bpmn:documentation></bpmn:documentation><bpmn:incoming>PC_F9</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="PC_F1" sourceRef="PC_Start" targetRef="PC_Out"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PC_F2" sourceRef="PC_Out" targetRef="PC_Fin"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PC_F3" sourceRef="PC_Fin" targetRef="PC_Lab"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PC_F4" sourceRef="PC_Lab" targetRef="PC_Chk"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PC_F5" sourceRef="PC_Chk" targetRef="PC_Adj1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PC_F6" sourceRef="PC_Adj1" targetRef="PC_Alloc"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PC_F7" sourceRef="PC_Alloc" targetRef="PC_Adj2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PC_F8" sourceRef="PC_Adj2" targetRef="PC_Rpt"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PC_F9" sourceRef="PC_Rpt" targetRef="PC_End"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="ProductionCosting_diagram"><bpmndi:BPMNPlane id="ProductionCosting_plane" bpmnElement="ProductionCosting_collab"><bpmndi:BPMNShape id="ProductionCosting_pool_di" bpmnElement="ProductionCosting_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1800" height="352"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="ProductionCosting_lane_0_di" bpmnElement="ProductionCosting_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1770" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="ProductionCosting_lane_1_di" bpmnElement="ProductionCosting_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1770" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PC_Start_di" bpmnElement="PC_Start" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="PC_Out_di" bpmnElement="PC_Out" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="250" y="141" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PC_Fin_di" bpmnElement="PC_Fin" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="440" y="141" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PC_Lab_di" bpmnElement="PC_Lab" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="630" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PC_Chk_di" bpmnElement="PC_Chk" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="820" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PC_Adj1_di" bpmnElement="PC_Adj1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1010" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PC_Alloc_di" bpmnElement="PC_Alloc" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PC_Adj2_di" bpmnElement="PC_Adj2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1390" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PC_Rpt_di" bpmnElement="PC_Rpt" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1580" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PC_End_di" bpmnElement="PC_End" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1770" y="336" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1726" y="381" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="PC_F1_di" bpmnElement="PC_F1" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="250" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PC_F2_di" bpmnElement="PC_F2" bioc:stroke="#7e90aa"><di:waypoint x="376" y="178"/><di:waypoint x="440" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PC_F3_di" bpmnElement="PC_F3" bioc:stroke="#7e90aa"><di:waypoint x="566" y="178"/><di:waypoint x="600" y="178"/><di:waypoint x="600" y="354"/><di:waypoint x="630" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PC_F4_di" bpmnElement="PC_F4" bioc:stroke="#7e90aa"><di:waypoint x="756" y="354"/><di:waypoint x="820" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PC_F5_di" bpmnElement="PC_F5" bioc:stroke="#7e90aa"><di:waypoint x="946" y="354"/><di:waypoint x="1010" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PC_F6_di" bpmnElement="PC_F6" bioc:stroke="#7e90aa"><di:waypoint x="1136" y="354"/><di:waypoint x="1200" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PC_F7_di" bpmnElement="PC_F7" bioc:stroke="#7e90aa"><di:waypoint x="1326" y="354"/><di:waypoint x="1390" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PC_F8_di" bpmnElement="PC_F8" bioc:stroke="#7e90aa"><di:waypoint x="1516" y="354"/><di:waypoint x="1580" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PC_F9_di" bpmnElement="PC_F9" bioc:stroke="#7e90aa"><di:waypoint x="1706" y="354"/><di:waypoint x="1770" y="354"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>