<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="PeriodClose_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="PeriodClose_collab"><bpmn:participant id="PeriodClose_pool" name="Đối chiếu và đóng sổ cuối kỳ" processRef="PeriodClose"/></bpmn:collaboration><bpmn:process id="PeriodClose" name="Đối chiếu và đóng sổ cuối kỳ" isExecutable="false"><bpmn:laneSet id="PeriodClose_lanes"><bpmn:lane id="PeriodClose_lane_0" name="Kế toán tổng hợp"><bpmn:flowNodeRef>PZ_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>PZ_Sum</bpmn:flowNodeRef><bpmn:flowNodeRef>PZ_Jrn</bpmn:flowNodeRef><bpmn:flowNodeRef>PZ_Post</bpmn:flowNodeRef><bpmn:flowNodeRef>PZ_Re</bpmn:flowNodeRef><bpmn:flowNodeRef>PZ_Close</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="PeriodClose_lane_1" name="Kế toán trưởng"><bpmn:flowNodeRef>PZ_A1</bpmn:flowNodeRef><bpmn:flowNodeRef>PZ_G</bpmn:flowNodeRef><bpmn:flowNodeRef>PZ_Conf</bpmn:flowNodeRef><bpmn:flowNodeRef>PZ_End</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="PeriodClose_lane_2" name="Ban Giám đốc"><bpmn:flowNodeRef>PZ_A2</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="PZ_Start" name="Kết thúc kỳ kế toán"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>PZ_F1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="PZ_Sum" name="Tổng hợp
bút toán điều chỉnh"><bpmn:documentation>Tổng hợp các bút toán điều chỉnh phát sinh trong kỳ từ các phần hành.</bpmn:documentation><bpmn:incoming>PZ_F1</bpmn:incoming><bpmn:outgoing>PZ_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="PZ_Jrn" name="Lập bút toán
trên General Journal"><bpmn:documentation>Nhập bút toán điều chỉnh vào sổ nhật ký chung kèm diễn giải và chứng từ tham chiếu.</bpmn:documentation><bpmn:incoming>PZ_F2</bpmn:incoming><bpmn:outgoing>PZ_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="PZ_A1" name="Kế toán trưởng
phê duyệt"><bpmn:documentation>Kế toán trưởng soát xét và phê duyệt bút toán điều chỉnh.</bpmn:documentation><bpmn:incoming>PZ_F3</bpmn:incoming><bpmn:outgoing>PZ_F4</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="PZ_G" name="Giá trị trọng yếu?" default="PZ_F6"><bpmn:documentation></bpmn:documentation><bpmn:incoming>PZ_F4</bpmn:incoming><bpmn:outgoing>PZ_F5</bpmn:outgoing><bpmn:outgoing>PZ_F6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="PZ_A2" name="Ban Giám đốc
phê duyệt"><bpmn:documentation>Bút toán vượt ngưỡng trọng yếu cần thêm phê duyệt của Ban Giám đốc.</bpmn:documentation><bpmn:incoming>PZ_F5</bpmn:incoming><bpmn:outgoing>PZ_F7</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="PZ_Post" name="Ghi sổ
bút toán điều chỉnh"><bpmn:documentation>Ghi sổ bút toán sau khi đã có đủ phê duyệt theo phân cấp.</bpmn:documentation><bpmn:incoming>PZ_F6</bpmn:incoming><bpmn:incoming>PZ_F7</bpmn:incoming><bpmn:outgoing>PZ_F8</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="PZ_Re" name="Đối chiếu lại
sau điều chỉnh"><bpmn:documentation>Đối chiếu lại số liệu sổ sách sau khi các bút toán điều chỉnh đã ghi sổ.</bpmn:documentation><bpmn:incoming>PZ_F8</bpmn:incoming><bpmn:outgoing>PZ_F9</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="PZ_Close" name="Đóng kỳ
và mở kỳ mới"><bpmn:documentation>Đóng kỳ kế toán, khai báo kỳ mới và bộ số chứng từ cho năm tài chính tiếp theo.</bpmn:documentation><bpmn:incoming>PZ_F9</bpmn:incoming><bpmn:outgoing>PZ_F10</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="PZ_Conf" name="Xác nhận đóng sổ"><bpmn:documentation>Kế toán trưởng xác nhận hoàn tất đóng sổ cuối kỳ.</bpmn:documentation><bpmn:incoming>PZ_F10</bpmn:incoming><bpmn:outgoing>PZ_F11</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="PZ_End" name="Đã đóng sổ"><bpmn:documentation></bpmn:documentation><bpmn:incoming>PZ_F11</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="PZ_F1" sourceRef="PZ_Start" targetRef="PZ_Sum"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PZ_F2" sourceRef="PZ_Sum" targetRef="PZ_Jrn"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PZ_F3" sourceRef="PZ_Jrn" targetRef="PZ_A1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PZ_F4" sourceRef="PZ_A1" targetRef="PZ_G"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PZ_F5" sourceRef="PZ_G" targetRef="PZ_A2" name="Trọng yếu"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">materialAmount = true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="PZ_F6" sourceRef="PZ_G" targetRef="PZ_Post" name="Không trọng yếu"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PZ_F7" sourceRef="PZ_A2" targetRef="PZ_Post"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PZ_F8" sourceRef="PZ_Post" targetRef="PZ_Re"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PZ_F9" sourceRef="PZ_Re" targetRef="PZ_Close"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PZ_F10" sourceRef="PZ_Close" targetRef="PZ_Conf"></bpmn:sequenceFlow><bpmn:sequenceFlow id="PZ_F11" sourceRef="PZ_Conf" targetRef="PZ_End"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="PeriodClose_diagram"><bpmndi:BPMNPlane id="PeriodClose_plane" bpmnElement="PeriodClose_collab"><bpmndi:BPMNShape id="PeriodClose_pool_di" bpmnElement="PeriodClose_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1910" height="528"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PeriodClose_lane_0_di" bpmnElement="PeriodClose_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1880" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PeriodClose_lane_1_di" bpmnElement="PeriodClose_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1880" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PeriodClose_lane_2_di" bpmnElement="PeriodClose_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="1880" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PZ_Start_di" bpmnElement="PZ_Start" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="PZ_Sum_di" bpmnElement="PZ_Sum" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="250" y="141" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PZ_Jrn_di" bpmnElement="PZ_Jrn" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="440" y="141" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PZ_A1_di" bpmnElement="PZ_A1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="630" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PZ_G_di" bpmnElement="PZ_G" bioc:fill="#fff8e6" bioc:stroke="#b3812f"><dc:Bounds x="820" y="329" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="783" y="388" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="PZ_A2_di" bpmnElement="PZ_A2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="930" y="493" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PZ_Post_di" bpmnElement="PZ_Post" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1120" y="141" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PZ_Re_di" bpmnElement="PZ_Re" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1310" y="141" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PZ_Close_di" bpmnElement="PZ_Close" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1500" y="141" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PZ_Conf_di" bpmnElement="PZ_Conf" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1690" y="317" width="126" height="74"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PZ_End_di" bpmnElement="PZ_End" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1880" y="336" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1836" y="381" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="PZ_F1_di" bpmnElement="PZ_F1" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="250" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PZ_F2_di" bpmnElement="PZ_F2" bioc:stroke="#7e90aa"><di:waypoint x="376" y="178"/><di:waypoint x="440" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PZ_F3_di" bpmnElement="PZ_F3" bioc:stroke="#7e90aa"><di:waypoint x="566" y="178"/><di:waypoint x="600" y="178"/><di:waypoint x="600" y="354"/><di:waypoint x="630" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PZ_F4_di" bpmnElement="PZ_F4" bioc:stroke="#7e90aa"><di:waypoint x="756" y="354"/><di:waypoint x="820" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PZ_F5_di" bpmnElement="PZ_F5" bioc:stroke="#7e90aa"><di:waypoint x="845" y="379"/><di:waypoint x="845" y="530"/><di:waypoint x="930" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PZ_F6_di" bpmnElement="PZ_F6" bioc:stroke="#7e90aa"><di:waypoint x="845" y="329"/><di:waypoint x="845" y="178"/><di:waypoint x="1120" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PZ_F7_di" bpmnElement="PZ_F7" bioc:stroke="#7e90aa"><di:waypoint x="993" y="493"/><di:waypoint x="993" y="178"/><di:waypoint x="1120" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PZ_F8_di" bpmnElement="PZ_F8" bioc:stroke="#7e90aa"><di:waypoint x="1246" y="178"/><di:waypoint x="1310" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PZ_F9_di" bpmnElement="PZ_F9" bioc:stroke="#7e90aa"><di:waypoint x="1436" y="178"/><di:waypoint x="1500" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PZ_F10_di" bpmnElement="PZ_F10" bioc:stroke="#7e90aa"><di:waypoint x="1626" y="178"/><di:waypoint x="1660" y="178"/><di:waypoint x="1660" y="354"/><di:waypoint x="1690" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="PZ_F11_di" bpmnElement="PZ_F11" bioc:stroke="#7e90aa"><di:waypoint x="1816" y="354"/><di:waypoint x="1880" y="354"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>