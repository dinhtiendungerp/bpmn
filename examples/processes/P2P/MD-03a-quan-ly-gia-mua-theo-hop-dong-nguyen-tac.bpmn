<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP50_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP50_collab"><bpmn:participant id="AP50_pool" name="Quản lý giá mua theo Hợp đồng nguyên tắc" processRef="AP50"/></bpmn:collaboration><bpmn:process id="AP50" name="Quản lý giá mua theo Hợp đồng nguyên tắc" isExecutable="false"><bpmn:laneSet id="AP50_lanes"><bpmn:lane id="AP50_lane_0" name="Bộ phận Cung ứng"><bpmn:flowNodeRef>AP50_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP50_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP50_T1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP50_lane_1" name="BLĐ"><bpmn:flowNodeRef>AP50_T2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP50_lane_2" name="Bộ phận CNTT"><bpmn:flowNodeRef>AP50_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP50_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP50_E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP50_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP50_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP50_T0" name="01 · Nhận Bảng giá mới từ
NCC"><bpmn:documentation>Bước 1 · P. Cung Ứng. Hàng năm hoặc theo kỳ hợp đồng, NCC gửi Bảng giá mới. P. Cung Ứng tập hợp và chuẩn hóa theo mẫu.</bpmn:documentation><bpmn:incoming>AP50_F0</bpmn:incoming><bpmn:outgoing>AP50_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP50_T1" name="02 · Trình ký Bảng giá"><bpmn:documentation>Bước 2 · P. Cung Ứng. Trình Bảng giá mới lên Ban Lãnh đạo xem xét và phê duyệt, làm căn cứ ký Hợp đồng nguyên tắc mua hàng.</bpmn:documentation><bpmn:incoming>AP50_F1</bpmn:incoming><bpmn:outgoing>AP50_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP50_T2" name="03 · Chấp nhận Bảng giá?"><bpmn:documentation>Bước 3 · BLĐ. BLĐ xem xét và duyệt. Không duyệt: đàm phán lại với NCC. Duyệt: chuyển tạo Bảng giá trên hệ thống.</bpmn:documentation><bpmn:incoming>AP50_F2</bpmn:incoming><bpmn:outgoing>AP50_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP50_T3" name="04 · Tạo Bảng giá mua mới"><bpmn:documentation>Bước 4 · BP. CNTT. Tạo Bảng giá mua trên hệ thống - khai báo mặt hàng, đơn vị tính, đơn giá, ngày bắt đầu hiệu lực, Nhà cung cấp. Sau khi tạo, Đơn mua hàng cho NCC này tự lấy giá từ Bảng giá.</bpmn:documentation><bpmn:incoming>AP50_F3</bpmn:incoming><bpmn:outgoing>AP50_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP50_T4" name="05 · Đóng Bảng giá cũ"><bpmn:documentation>Bước 5 · BP. CNTT. Đặt ngày kết thúc cho Bảng giá cũ - đảm bảo chỉ một Bảng giá đang hoạt động cho cùng NCC và mặt hàng tại một thời điểm, tránh áp dụng sai giá.</bpmn:documentation><bpmn:incoming>AP50_F4</bpmn:incoming><bpmn:outgoing>AP50_F5</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP50_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP50_F5</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP50_F0" sourceRef="AP50_S" targetRef="AP50_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP50_F1" sourceRef="AP50_T0" targetRef="AP50_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP50_F2" sourceRef="AP50_T1" targetRef="AP50_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP50_F3" sourceRef="AP50_T2" targetRef="AP50_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP50_F4" sourceRef="AP50_T3" targetRef="AP50_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP50_F5" sourceRef="AP50_T4" targetRef="AP50_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP50_diagram"><bpmndi:BPMNPlane id="AP50_plane" bpmnElement="AP50_collab"><bpmndi:BPMNShape id="AP50_pool_di" bpmnElement="AP50_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1536" height="528"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP50_lane_0_di" bpmnElement="AP50_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1506" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP50_lane_1_di" bpmnElement="AP50_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1506" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP50_lane_2_di" bpmnElement="AP50_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="1506" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP50_S_di" bpmnElement="AP50_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP50_T0_di" bpmnElement="AP50_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP50_T1_di" bpmnElement="AP50_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP50_T2_di" bpmnElement="AP50_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP50_T3_di" bpmnElement="AP50_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP50_T4_di" bpmnElement="AP50_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP50_E_di" bpmnElement="AP50_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1410" y="512" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1366" y="557" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP50_F0_di" bpmnElement="AP50_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP50_F1_di" bpmnElement="AP50_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="570" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP50_F2_di" bpmnElement="AP50_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="178"/><di:waypoint x="750" y="178"/><di:waypoint x="750" y="354"/><di:waypoint x="780" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP50_F3_di" bpmnElement="AP50_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="354"/><di:waypoint x="960" y="354"/><di:waypoint x="960" y="530"/><di:waypoint x="990" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP50_F4_di" bpmnElement="AP50_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="530"/><di:waypoint x="1200" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP50_F5_di" bpmnElement="AP50_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="530"/><di:waypoint x="1410" y="530"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>