<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP52_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP52_collab"><bpmn:participant id="AP52_pool" name="Mua hàng theo kế hoạch sản xuất" processRef="AP52"/></bpmn:collaboration><bpmn:process id="AP52" name="Mua hàng theo kế hoạch sản xuất" isExecutable="false"><bpmn:laneSet id="AP52_lanes"><bpmn:lane id="AP52_lane_0" name="Bộ phận Cung ứng"><bpmn:flowNodeRef>AP52_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP52_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP52_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP52_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP52_T5</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP52_lane_1" name="Phòng Kế toán"><bpmn:flowNodeRef>AP52_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP52_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP52_T7</bpmn:flowNodeRef><bpmn:flowNodeRef>AP52_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP52_lane_2" name="Bộ phận Kho"><bpmn:flowNodeRef>AP52_T6</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP52_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP52_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP52_T0" name="01 · Chạy MRP &amp; lên nhu cầu
NVL"><bpmn:documentation>Bước 1 · P. Cung Ứng. Dựa trên Kế hoạch sản xuất và Lệnh sản xuất đã phát hành, chạy MRP để hệ thống tính toán nhu cầu NVL còn thiếu - căn cứ lập kế hoạch mua.</bpmn:documentation><bpmn:incoming>AP52_F0</bpmn:incoming><bpmn:outgoing>AP52_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP52_T1" name="02 · Tạo / sửa Đơn mua hàng"><bpmn:documentation>Bước 2 · P. Cung Ứng. Từ đề xuất MRP, Cung Ứng xác nhận và tạo Đơn mua hàng - gộp theo NCC, đơn vị tính, ngày giao để tối ưu chi phí vận chuyển.</bpmn:documentation><bpmn:incoming>AP52_F1</bpmn:incoming><bpmn:outgoing>AP52_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP52_T2" name="03 · Gửi yêu cầu duyệt đơn"><bpmn:documentation>Bước 3 · P. Cung Ứng. Gửi Đơn mua hàng đi phê duyệt - chuyển sang Kế toán kiểm tra giá trước khi cho phép đặt hàng chính thức với NCC.</bpmn:documentation><bpmn:incoming>AP52_F2</bpmn:incoming><bpmn:outgoing>AP52_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP52_T3" name="04 · Kiểm tra giá mua vs
Bảng giá"><bpmn:documentation>Bước 4 · P. Kế toán. Đối chiếu đơn giá trên Đơn mua hàng với Bảng giá mua (Hợp đồng nguyên tắc). Nếu lệch, hệ thống cảnh báo để Kế toán xem xét nguyên nhân.</bpmn:documentation><bpmn:incoming>AP52_F3</bpmn:incoming><bpmn:outgoing>AP52_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP52_T4" name="05 · Duyệt Đơn mua hàng"><bpmn:documentation>Bước 5 · P. Kế toán. Nếu giá hợp lệ, phê duyệt - Đơn mua hàng chuyển trạng thái đã duyệt, sẵn sàng gửi NCC. Nếu không, từ chối, trả về Cung Ứng để điều chỉnh.</bpmn:documentation><bpmn:incoming>AP52_F4</bpmn:incoming><bpmn:outgoing>AP52_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP52_T5" name="06 · Thông báo lịch nhập kho"><bpmn:documentation>Bước 6 · P. Cung Ứng. Sau khi duyệt, Cung Ứng thông báo lịch dự kiến nhập kho cho Bộ phận Kho vận chuẩn bị nhân lực, thiết bị bốc dỡ, vị trí lưu kho.</bpmn:documentation><bpmn:incoming>AP52_F5</bpmn:incoming><bpmn:outgoing>AP52_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP52_T6" name="07 · Nhập kho"><bpmn:documentation>Bước 7 · BP. Kho. Khi hàng về, Kho tạo Phiếu nhập kho, gán Lô và vị trí kho, ghi nhận số lượng thực nhận; post ghi sổ để tồn kho cập nhật.</bpmn:documentation><bpmn:incoming>AP52_F6</bpmn:incoming><bpmn:outgoing>AP52_F7</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP52_T7" name="08 · Ghi nhận Hóa đơn đầu
vào"><bpmn:documentation>Bước 8 · P. Kế toán. Sau khi Kho đã post nhập, Kế toán lập Hóa đơn mua hàng căn cứ theo Phiếu nhập kho, ghi nhận công nợ phải trả Nhà cung cấp.</bpmn:documentation><bpmn:incoming>AP52_F7</bpmn:incoming><bpmn:outgoing>AP52_F8</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP52_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP52_F8</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP52_F0" sourceRef="AP52_S" targetRef="AP52_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP52_F1" sourceRef="AP52_T0" targetRef="AP52_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP52_F2" sourceRef="AP52_T1" targetRef="AP52_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP52_F3" sourceRef="AP52_T2" targetRef="AP52_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP52_F4" sourceRef="AP52_T3" targetRef="AP52_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP52_F5" sourceRef="AP52_T4" targetRef="AP52_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP52_F6" sourceRef="AP52_T5" targetRef="AP52_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP52_F7" sourceRef="AP52_T6" targetRef="AP52_T7"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP52_F8" sourceRef="AP52_T7" targetRef="AP52_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP52_diagram"><bpmndi:BPMNPlane id="AP52_plane" bpmnElement="AP52_collab"><bpmndi:BPMNShape id="AP52_pool_di" bpmnElement="AP52_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="2166" height="528"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP52_lane_0_di" bpmnElement="AP52_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP52_lane_1_di" bpmnElement="AP52_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP52_lane_2_di" bpmnElement="AP52_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP52_S_di" bpmnElement="AP52_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP52_T0_di" bpmnElement="AP52_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP52_T1_di" bpmnElement="AP52_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP52_T2_di" bpmnElement="AP52_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP52_T3_di" bpmnElement="AP52_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP52_T4_di" bpmnElement="AP52_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP52_T5_di" bpmnElement="AP52_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP52_T6_di" bpmnElement="AP52_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP52_T7_di" bpmnElement="AP52_T7" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1830" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP52_E_di" bpmnElement="AP52_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="2040" y="336" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1996" y="381" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP52_F0_di" bpmnElement="AP52_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP52_F1_di" bpmnElement="AP52_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="570" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP52_F2_di" bpmnElement="AP52_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="178"/><di:waypoint x="780" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP52_F3_di" bpmnElement="AP52_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="178"/><di:waypoint x="960" y="178"/><di:waypoint x="960" y="354"/><di:waypoint x="990" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP52_F4_di" bpmnElement="AP52_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="354"/><di:waypoint x="1200" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP52_F5_di" bpmnElement="AP52_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="354"/><di:waypoint x="1380" y="354"/><di:waypoint x="1380" y="178"/><di:waypoint x="1410" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP52_F6_di" bpmnElement="AP52_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="178"/><di:waypoint x="1590" y="178"/><di:waypoint x="1590" y="530"/><di:waypoint x="1620" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP52_F7_di" bpmnElement="AP52_F7" bioc:stroke="#7e90aa"><di:waypoint x="1780" y="530"/><di:waypoint x="1800" y="530"/><di:waypoint x="1800" y="354"/><di:waypoint x="1830" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP52_F8_di" bpmnElement="AP52_F8" bioc:stroke="#7e90aa"><di:waypoint x="1990" y="354"/><di:waypoint x="2040" y="354"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>