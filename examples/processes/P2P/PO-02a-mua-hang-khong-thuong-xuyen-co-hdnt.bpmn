<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP53_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP53_collab"><bpmn:participant id="AP53_pool" name="Mua hàng không thường xuyên (CÓ HĐNT)" processRef="AP53"/></bpmn:collaboration><bpmn:process id="AP53" name="Mua hàng không thường xuyên (CÓ HĐNT)" isExecutable="false"><bpmn:laneSet id="AP53_lanes"><bpmn:lane id="AP53_lane_0" name="Bộ phận yêu cầu"><bpmn:flowNodeRef>AP53_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP53_T0</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP53_lane_1" name="Trưởng phòng"><bpmn:flowNodeRef>AP53_T1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP53_lane_2" name="Bộ phận Cung ứng"><bpmn:flowNodeRef>AP53_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP53_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP53_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP53_T6</bpmn:flowNodeRef><bpmn:flowNodeRef>AP53_T7</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP53_lane_3" name="BLĐ"><bpmn:flowNodeRef>AP53_T5</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP53_lane_4" name="Phòng Kế toán"><bpmn:flowNodeRef>AP53_T8</bpmn:flowNodeRef><bpmn:flowNodeRef>AP53_T9</bpmn:flowNodeRef><bpmn:flowNodeRef>AP53_T10</bpmn:flowNodeRef><bpmn:flowNodeRef>AP53_E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP53_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP53_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP53_T0" name="01 · Phát sinh nhu cầu mua
hàng"><bpmn:documentation>Bước 1 · Các phòng ban. Phòng ban phát sinh nhu cầu mua mặt hàng/vật tư ngoài kế hoạch sản xuất - thường là CCDC, dịch vụ, hàng mua lần đầu.</bpmn:documentation><bpmn:incoming>AP53_F0</bpmn:incoming><bpmn:outgoing>AP53_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP53_T1" name="02 · Duyệt Yêu cầu mua hàng
nội bộ"><bpmn:documentation>Bước 2 · Trưởng phòng. Trưởng phòng xem xét tính hợp lý của nhu cầu, mức giá tham khảo và thời điểm cần nhận hàng. Duyệt Yêu cầu mua hàng nội bộ (qua chứng từ giấy hoặc email) trước khi chuyển sang Phòng Cung Ứng.</bpmn:documentation><bpmn:incoming>AP53_F1</bpmn:incoming><bpmn:outgoing>AP53_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP53_T2" name="03 · Tiếp nhận Yêu cầu mua
hàng đã duyệt"><bpmn:documentation>Bước 3 · P. Cung Ứng. Cung Ứng tiếp nhận Yêu cầu mua hàng đã được phòng ban duyệt từ ngoài hệ thống. Kiểm tra tính đầy đủ thông tin: nhu cầu, số lượng, mức giá tham khảo, thời điểm cần nhận hàng - làm căn cứ nhập vào hệ thống.</bpmn:documentation><bpmn:incoming>AP53_F2</bpmn:incoming><bpmn:outgoing>AP53_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP53_T3" name="04 · Tạo Yêu cầu mua hàng"><bpmn:documentation>Bước 4 · P. Cung Ứng. Cung Ứng nhập Yêu cầu mua hàng đã duyệt vào hệ thống D365 BC làm căn cứ lập Tờ trình và Đơn mua hàng - bám đúng nội dung phòng ban đã yêu cầu (mặt hàng, số lượng, mức giá tham khảo, thời điểm cần nhận hàng).</bpmn:documentation><bpmn:incoming>AP53_F3</bpmn:incoming><bpmn:outgoing>AP53_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP53_T4" name="05 · Lập Tờ trình cho Yêu
cầu"><bpmn:documentation>Bước 5 · P. Cung Ứng. Cung Ứng lập Tờ trình từ Yêu cầu mua hàng đã nhập, lấy giá từ Bảng giá HĐNT (tham khảo MD-03a). Đính kèm Yêu cầu mua hàng vào Tờ trình. Không cần xin báo giá vì đã có HĐNT.</bpmn:documentation><bpmn:incoming>AP53_F4</bpmn:incoming><bpmn:outgoing>AP53_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP53_T5" name="06 · BLĐ duyệt Tờ trình?"><bpmn:documentation>Bước 6 · BLĐ. BLĐ xem xét Tờ trình. Duyệt: tiếp tục tạo Đơn mua hàng. Không duyệt: trả về Cung Ứng để chọn NCC khác hoặc thương lượng lại.</bpmn:documentation><bpmn:incoming>AP53_F5</bpmn:incoming><bpmn:outgoing>AP53_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP53_T6" name="07 · Tạo Đơn mua hàng"><bpmn:documentation>Bước 7 · P. Cung Ứng. Từ Yêu cầu đã duyệt, Cung Ứng tạo Đơn mua hàng kế thừa thông tin: NCC, mặt hàng, số lượng, đơn giá, ngày giao.</bpmn:documentation><bpmn:incoming>AP53_F6</bpmn:incoming><bpmn:outgoing>AP53_F7</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP53_T7" name="08 · Gửi yêu cầu duyệt Đơn"><bpmn:documentation>Bước 8 · P. Cung Ứng. Gửi Đơn mua hàng đi phê duyệt - chuyển sang Kế toán kiểm tra trước khi đặt hàng chính thức với NCC.</bpmn:documentation><bpmn:incoming>AP53_F7</bpmn:incoming><bpmn:outgoing>AP53_F8</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP53_T8" name="09 · Kiểm tra giá &amp; duyệt
Đơn"><bpmn:documentation>Bước 9 · P. Kế toán. Kế toán kiểm tra giá, điều khoản thanh toán, hạch toán. Duyệt nếu hợp lệ - Đơn chuyển trạng thái đã duyệt.</bpmn:documentation><bpmn:incoming>AP53_F8</bpmn:incoming><bpmn:outgoing>AP53_F9</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP53_T9" name="10 · Yêu cầu trả trước?"><bpmn:documentation>Bước 10 · P. Kế toán. Nếu NCC yêu cầu thanh toán trước một phần: Kế toán ghi nhận trả trước và thực hiện thanh toán theo quy định trước khi NCC giao hàng.</bpmn:documentation><bpmn:incoming>AP53_F9</bpmn:incoming><bpmn:outgoing>AP53_F10</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP53_T10" name="11 · Ghi nhận Hóa đơn đầu
vào"><bpmn:documentation>Bước 11 · P. Kế toán. Sau khi Kho nhập hàng, Kế toán lập Hóa đơn mua hàng căn cứ Phiếu nhập kho - ghi công nợ phải trả NCC.</bpmn:documentation><bpmn:incoming>AP53_F10</bpmn:incoming><bpmn:outgoing>AP53_F11</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP53_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP53_F11</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP53_F0" sourceRef="AP53_S" targetRef="AP53_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP53_F1" sourceRef="AP53_T0" targetRef="AP53_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP53_F2" sourceRef="AP53_T1" targetRef="AP53_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP53_F3" sourceRef="AP53_T2" targetRef="AP53_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP53_F4" sourceRef="AP53_T3" targetRef="AP53_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP53_F5" sourceRef="AP53_T4" targetRef="AP53_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP53_F6" sourceRef="AP53_T5" targetRef="AP53_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP53_F7" sourceRef="AP53_T6" targetRef="AP53_T7"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP53_F8" sourceRef="AP53_T7" targetRef="AP53_T8"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP53_F9" sourceRef="AP53_T8" targetRef="AP53_T9"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP53_F10" sourceRef="AP53_T9" targetRef="AP53_T10"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP53_F11" sourceRef="AP53_T10" targetRef="AP53_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP53_diagram"><bpmndi:BPMNPlane id="AP53_plane" bpmnElement="AP53_collab"><bpmndi:BPMNShape id="AP53_pool_di" bpmnElement="AP53_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="2796" height="880"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP53_lane_0_di" bpmnElement="AP53_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="2766" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP53_lane_1_di" bpmnElement="AP53_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="2766" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP53_lane_2_di" bpmnElement="AP53_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="2766" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP53_lane_3_di" bpmnElement="AP53_lane_3" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="618" width="2766" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP53_lane_4_di" bpmnElement="AP53_lane_4" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="794" width="2766" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP53_S_di" bpmnElement="AP53_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP53_T0_di" bpmnElement="AP53_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP53_T1_di" bpmnElement="AP53_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP53_T2_di" bpmnElement="AP53_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP53_T3_di" bpmnElement="AP53_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP53_T4_di" bpmnElement="AP53_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP53_T5_di" bpmnElement="AP53_T5" bioc:fill="#eef4ff" bioc: