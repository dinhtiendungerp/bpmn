<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP51_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP51_collab"><bpmn:participant id="AP51_pool" name="Mua hàng không thường xuyên (yêu cầu báo giá)" processRef="AP51"/></bpmn:collaboration><bpmn:process id="AP51" name="Mua hàng không thường xuyên (yêu cầu báo giá)" isExecutable="false"><bpmn:laneSet id="AP51_lanes"><bpmn:lane id="AP51_lane_0" name="Bộ phận Cung ứng"><bpmn:flowNodeRef>AP51_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP51_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP51_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP51_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP51_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP51_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP51_T6</bpmn:flowNodeRef><bpmn:flowNodeRef>AP51_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP51_lane_1" name="BLĐ"><bpmn:flowNodeRef>AP51_T5</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP51_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP51_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP51_T0" name="01 · Nhận Yêu cầu mua hàng
đã duyệt"><bpmn:documentation>Bước 1 · P. Cung Ứng. Nhận Yêu cầu mua hàng đã được phòng ban duyệt ngoài hệ thống, chuyển từ quy trình PO-02b (mua không thường xuyên cần báo giá). RFQ chỉ kích hoạt khi mã hàng chưa có HĐNT - nếu đã có HĐNT, dùng PO-02a (lấy giá từ HĐNT) thay vì đi qua RFQ.</bpmn:documentation><bpmn:incoming>AP51_F0</bpmn:incoming><bpmn:outgoing>AP51_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP51_T1" name="02 · Xin báo giá từ ≥ 3 NCC"><bpmn:documentation>Bước 2 · P. Cung Ứng. Gửi yêu cầu báo giá cho tối thiểu 3 Nhà cung cấp khác nhau để đảm bảo cạnh tranh về giá và điều khoản.</bpmn:documentation><bpmn:incoming>AP51_F1</bpmn:incoming><bpmn:outgoing>AP51_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP51_T2" name="03 · Ghi nhận Báo giá trên
hệ thống"><bpmn:documentation>Bước 3 · P. Cung Ứng. Nhập các báo giá thu thập được vào hệ thống - mỗi NCC một báo giá để làm căn cứ so sánh và lưu vết.</bpmn:documentation><bpmn:incoming>AP51_F2</bpmn:incoming><bpmn:outgoing>AP51_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP51_T3" name="04 · Chấm điểm &amp; chọn NCC"><bpmn:documentation>Bước 4 · P. Cung Ứng. So sánh nhiều tiêu chí: đơn giá, thời gian giao hàng, điều khoản thanh toán, chất lượng, uy tín. Chấm điểm và chọn NCC tối ưu.</bpmn:documentation><bpmn:incoming>AP51_F3</bpmn:incoming><bpmn:outgoing>AP51_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP51_T4" name="05 · Lập Tờ trình so sánh
giá"><bpmn:documentation>Bước 5 · P. Cung Ứng. Lập Tờ trình cho Báo giá được chọn, đính kèm các báo giá còn lại để BLĐ đối chiếu tính minh bạch.</bpmn:documentation><bpmn:incoming>AP51_F4</bpmn:incoming><bpmn:outgoing>AP51_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP51_T5" name="06 · Duyệt Tờ trình?"><bpmn:documentation>Bước 6 · BLĐ. BLĐ xem xét Tờ trình. Duyệt: Báo giá chuyển trạng thái đã chọn. Không duyệt: làm lại bước chọn NCC khác.</bpmn:documentation><bpmn:incoming>AP51_F5</bpmn:incoming><bpmn:outgoing>AP51_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP51_T6" name="07 · Kích hoạt Báo giá được
chọn"><bpmn:documentation>Bước 7 · P. Cung Ứng. Báo giá được kích hoạt, chuyển sang quy trình Mua hàng không thường xuyên: tạo Đơn mua hàng từ Báo giá đã duyệt.</bpmn:documentation><bpmn:incoming>AP51_F6</bpmn:incoming><bpmn:outgoing>AP51_F7</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP51_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP51_F7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP51_F0" sourceRef="AP51_S" targetRef="AP51_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP51_F1" sourceRef="AP51_T0" targetRef="AP51_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP51_F2" sourceRef="AP51_T1" targetRef="AP51_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP51_F3" sourceRef="AP51_T2" targetRef="AP51_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP51_F4" sourceRef="AP51_T3" targetRef="AP51_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP51_F5" sourceRef="AP51_T4" targetRef="AP51_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP51_F6" sourceRef="AP51_T5" targetRef="AP51_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP51_F7" sourceRef="AP51_T6" targetRef="AP51_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP51_diagram"><bpmndi:BPMNPlane id="AP51_plane" bpmnElement="AP51_collab"><bpmndi:BPMNShape id="AP51_pool_di" bpmnElement="AP51_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1956" height="352"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP51_lane_0_di" bpmnElement="AP51_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP51_lane_1_di" bpmnElement="AP51_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP51_S_di" bpmnElement="AP51_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP51_T0_di" bpmnElement="AP51_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP51_T1_di" bpmnElement="AP51_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP51_T2_di" bpmnElement="AP51_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP51_T3_di" bpmnElement="AP51_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP51_T4_di" bpmnElement="AP51_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP51_T5_di" bpmnElement="AP51_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP51_T6_di" bpmnElement="AP51_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP51_E_di" bpmnElement="AP51_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1830" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1786" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP51_F0_di" bpmnElement="AP51_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP51_F1_di" bpmnElement="AP51_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="570" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP51_F2_di" bpmnElement="AP51_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="178"/><di:waypoint x="780" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP51_F3_di" bpmnElement="AP51_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="178"/><di:waypoint x="990" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP51_F4_di" bpmnElement="AP51_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="178"/><di:waypoint x="1200" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP51_F5_di" bpmnElement="AP51_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="178"/><di:waypoint x="1380" y="178"/><di:waypoint x="1380" y="354"/><di:waypoint x="1410" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP51_F6_di" bpmnElement="AP51_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="354"/><di:waypoint x="1590" y="354"/><di:waypoint x="1590" y="178"/><di:waypoint x="1620" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP51_F7_di" bpmnElement="AP51_F7" bioc:stroke="#7e90aa"><di:waypoint x="1780" y="178"/><di:waypoint x="1830" y="178"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>