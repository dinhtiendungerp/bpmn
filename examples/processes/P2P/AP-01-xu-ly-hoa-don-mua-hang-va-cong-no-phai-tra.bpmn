<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP57_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP57_collab"><bpmn:participant id="AP57_pool" name="Xử lý hóa đơn mua hàng và công nợ phải trả" processRef="AP57"/></bpmn:collaboration><bpmn:process id="AP57" name="Xử lý hóa đơn mua hàng và công nợ phải trả" isExecutable="false"><bpmn:laneSet id="AP57_lanes"><bpmn:lane id="AP57_lane_0" name="Phòng Kế toán"><bpmn:flowNodeRef>AP57_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP57_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP57_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP57_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP57_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP57_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP57_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP57_T6</bpmn:flowNodeRef><bpmn:flowNodeRef>AP57_T7</bpmn:flowNodeRef><bpmn:flowNodeRef>AP57_E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP57_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP57_F0</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="AP57_T0" name="01 · Khai báo định mức &amp;
hạch toán"><bpmn:documentation>Bước 1 · BP. CNTT / Kế toán. Khai báo định mức xăng xe theo xe/nhân viên; khai báo hạn mức chi phí nhóm; thiết lập mã hóa nhóm hạch toán cho hàng hóa, chi phí, dịch vụ, Tài sản cố định. Là dữ liệu nền cho hệ thống tự kiểm tra.</bpmn:documentation><bpmn:incoming>AP57_F0</bpmn:incoming><bpmn:outgoing>AP57_F1</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="AP57_T1" name="02 · Nhận hóa đơn điện tử từ
VNPT"><bpmn:documentation>Bước 2 · Kế toán phải trả. Mở cổng E-document, nhận hóa đơn điện tử đầu vào từ VNPT. Áp dụng cho hóa đơn không quản lý tồn kho (xăng, VPP, CCDC nhỏ) và hóa đơn dịch vụ (điện, nước, kiểm toán).</bpmn:documentation><bpmn:incoming>AP57_F1</bpmn:incoming><bpmn:outgoing>AP57_F2</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="AP57_T2" name="03 · Kiểm tra định mức &amp; hạn
mức"><bpmn:documentation>Bước 3 · Kế toán phải trả. Hệ thống tự kiểm tra định mức xăng xe, số tiền chi trong ngày có thỏa điều kiện không. Thỏa: tiếp tục. Vượt hạn mức: cảnh báo, Kế toán xử lý ngoại lệ theo quy định nội bộ.</bpmn:documentation><bpmn:incoming>AP57_F2</bpmn:incoming><bpmn:outgoing>AP57_F3</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="AP57_T3" name="04 · Xử lý E-document trạng
thái Lỗi"><bpmn:documentation>Bước 4 · Kế toán phải trả. Kiểm tra các E-document báo Lỗi (Nhà cung cấp chưa khai báo, mặt hàng chưa tạo, sai thông tin thuế); xử lý lỗi, bổ sung dữ liệu, sau đó tiếp tục quy trình.</bpmn:documentation><bpmn:incoming>AP57_F3</bpmn:incoming><bpmn:outgoing>AP57_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP57_T4" name="05 · Khởi tạo chứng từ từ
E-document"><bpmn:documentation>Bước 5 · Kế toán phải trả. Từ E-document đã đủ dữ liệu, tạo hoặc cập nhật Đơn mua hàng/Hóa đơn mua hàng tương ứng. Kế toán kiểm tra preview trước khi post.</bpmn:documentation><bpmn:incoming>AP57_F4</bpmn:incoming><bpmn:outgoing>AP57_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP57_T5" name="06 · Ghi nhận hóa đơn theo
nhóm"><bpmn:documentation>Bước 6 · Kế toán phải trả. Theo từng nhóm: (1) HĐ hàng hóa; (2) HĐ chi phí (tiếp khách, VPP, chi khác); (3) HĐ dịch vụ (kiểm toán, tư vấn); (4) HĐ mua Tài sản cố định; (5) HĐ phân bổ chi phí mua hàng/ Thuế nhập khẩu. Xem slide Tổng quan 6 nhóm HĐ.</bpmn:documentation><bpmn:incoming>AP57_F5</bpmn:incoming><bpmn:outgoing>AP57_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP57_T6" name="07 · Hóa đơn điều chỉnh /
thay thế"><bpmn:documentation>Bước 7 · Kế toán phải trả. NCC phát hành Hóa đơn điều chỉnh giảm/tăng hoặc Hóa đơn thay thế: kiểm tra trên cổng VNPT, lấy về hệ thống. Lập Hóa đơn điều chỉnh giảm hoặc Hóa đơn mới tương ứng.</bpmn:documentation><bpmn:incoming>AP57_F6</bpmn:incoming><bpmn:outgoing>AP57_F7</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP57_T7" name="08 · Đảo bút toán &amp; kiểm tra"><bpmn:documentation>Bước 8 · Kế toán phải trả. Phát hiện bút toán chi phí đã ghi sổ sai: dùng chức năng đảo bút toán trên Hóa đơn đã post. Xem lại hóa đơn đã ghi sổ tại Sổ cái Nhà cung cấp; chạy báo cáo công nợ phải trả định kỳ.</bpmn:documentation><bpmn:incoming>AP57_F7</bpmn:incoming><bpmn:outgoing>AP57_F8</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP57_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP57_F8</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP57_F0" sourceRef="AP57_S" targetRef="AP57_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP57_F1" sourceRef="AP57_T0" targetRef="AP57_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP57_F2" sourceRef="AP57_T1" targetRef="AP57_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP57_F3" sourceRef="AP57_T2" targetRef="AP57_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP57_F4" sourceRef="AP57_T3" targetRef="AP57_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP57_F5" sourceRef="AP57_T4" targetRef="AP57_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP57_F6" sourceRef="AP57_T5" targetRef="AP57_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP57_F7" sourceRef="AP57_T6" targetRef="AP57_T7"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP57_F8" sourceRef="AP57_T7" targetRef="AP57_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP57_diagram"><bpmndi:BPMNPlane id="AP57_plane" bpmnElement="AP57_collab"><bpmndi:BPMNShape id="AP57_pool_di" bpmnElement="AP57_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="2166" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP57_lane_0_di" bpmnElement="AP57_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP57_S_di" bpmnElement="AP57_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP57_T0_di" bpmnElement="AP57_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP57_T1_di" bpmnElement="AP57_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP57_T2_di" bpmnElement="AP57_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP57_T3_di" bpmnElement="AP57_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP57_T4_di" bpmnElement="AP57_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP57_T5_di" bpmnElement="AP57_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP57_T6_di" bpmnElement="AP57_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP57_T7_di" bpmnElement="AP57_T7" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1830" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP57_E_di" bpmnElement="AP57_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="2040" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1996" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP57_F0_di" bpmnElement="AP57_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP57_F1_di" bpmnElement="AP57_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="570" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP57_F2_di" bpmnElement="AP57_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="178"/><di:waypoint x="780" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP57_F3_di" bpmnElement="AP57_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="178"/><di:waypoint x="990" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP57_F4_di" bpmnElement="AP57_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="178"/><di:waypoint x="1200" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP57_F5_di" bpmnElement="AP57_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="178"/><di:waypoint x="1410" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP57_F6_di" bpmnElement="AP57_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="178"/><di:waypoint x="1620" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP57_F7_di" bpmnElement="AP57_F7" bioc:stroke="#7e90aa"><di:waypoint x="1780" y="178"/><di:waypoint x="1830" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP57_F8_di" bpmnElement="AP57_F8" bioc:stroke="#7e90aa"><di:waypoint x="1990" y="178"/><di:waypoint x="2040" y="178"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>