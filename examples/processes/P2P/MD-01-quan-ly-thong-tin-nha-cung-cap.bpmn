<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP48_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP48_collab"><bpmn:participant id="AP48_pool" name="Quản lý thông tin Nhà cung cấp" processRef="AP48"/></bpmn:collaboration><bpmn:process id="AP48" name="Quản lý thông tin Nhà cung cấp" isExecutable="false"><bpmn:laneSet id="AP48_lanes"><bpmn:lane id="AP48_lane_0" name="Bộ phận yêu cầu"><bpmn:flowNodeRef>AP48_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP48_T0</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP48_lane_1" name="Bộ phận Cung ứng"><bpmn:flowNodeRef>AP48_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP48_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP48_T8</bpmn:flowNodeRef><bpmn:flowNodeRef>AP48_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP48_lane_2" name="Bộ phận CNTT"><bpmn:flowNodeRef>AP48_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP48_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP48_T7</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP48_lane_3" name="Phòng Kế toán"><bpmn:flowNodeRef>AP48_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP48_T6</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP48_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP48_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP48_T0" name="01 · Phát sinh nhu cầu mua
hàng"><bpmn:documentation>Bước 1 · Các phòng ban. Các phòng ban phát sinh nhu cầu mua hàng; khởi chạy quy trình Yêu cầu mua hàng nội bộ.</bpmn:documentation><bpmn:incoming>AP48_F0</bpmn:incoming><bpmn:outgoing>AP48_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP48_T1" name="02 · Lựa chọn, thu thập
thông tin NCC"><bpmn:documentation>Bước 2 · P. Cung Ứng. Tìm kiếm, đánh giá và thu thập thông tin Nhà cung cấp phù hợp nhu cầu mua: năng lực, uy tín, giá tham khảo, điều khoản.</bpmn:documentation><bpmn:incoming>AP48_F1</bpmn:incoming><bpmn:outgoing>AP48_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP48_T2" name="03 · Kiểm tra NCC có trên hệ
thống"><bpmn:documentation>Bước 3 · P. Cung Ứng. Rà soát Danh mục Nhà cung cấp hiện có trên hệ thống. Nếu đã có, chuyển sang cập nhật thông tin; nếu chưa, chuyển tạo mới.</bpmn:documentation><bpmn:incoming>AP48_F2</bpmn:incoming><bpmn:outgoing>AP48_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP48_T3" name="04 · Tạo mới thông tin NCC"><bpmn:documentation>Bước 4 · BP. CNTT. Tạo hồ sơ Nhà cung cấp mới theo mẫu chuẩn, mặc định ở trạng thái khóa để đảm bảo kiểm soát. Điền thông tin cơ bản: tên pháp nhân, Mã số thuế, địa chỉ, điều khoản thanh toán.</bpmn:documentation><bpmn:incoming>AP48_F3</bpmn:incoming><bpmn:outgoing>AP48_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP48_T4" name="05 · Gửi yêu cầu phê duyệt
NCC"><bpmn:documentation>Bước 5 · BP. CNTT. Gửi yêu cầu phê duyệt; thông tin NCC chuyển sang Phòng Kế toán để kiểm tra hạch toán trước khi được phép giao dịch.</bpmn:documentation><bpmn:incoming>AP48_F4</bpmn:incoming><bpmn:outgoing>AP48_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP48_T5" name="06 · Kiểm tra &amp; bổ sung hạch
toán"><bpmn:documentation>Bước 6 · P. Kế toán. Rà soát và bổ sung nhóm hạch toán nhà cung cấp, nhóm kinh doanh, nhóm thuế, thông tin thuế phù hợp với chính sách công ty.</bpmn:documentation><bpmn:incoming>AP48_F5</bpmn:incoming><bpmn:outgoing>AP48_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP48_T6" name="07 · Duyệt &amp; mở khóa NCC"><bpmn:documentation>Bước 7 · P. Kế toán. Phê duyệt thông tin hạch toán. NCC tự động được mở khóa, sẵn sàng phát sinh giao dịch mua hàng.</bpmn:documentation><bpmn:incoming>AP48_F6</bpmn:incoming><bpmn:outgoing>AP48_F7</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP48_T7" name="08 · Cập nhật thông tin NCC"><bpmn:documentation>Bước 8 · BP. CNTT. Trường hợp NCC đã tồn tại: đối chiếu và cập nhật thông tin mới (địa chỉ, tài khoản ngân hàng, liên hệ) để đảm bảo hệ thống luôn chính xác.</bpmn:documentation><bpmn:incoming>AP48_F7</bpmn:incoming><bpmn:outgoing>AP48_F8</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP48_T8" name="09 · Thực hiện mua hàng với
NCC"><bpmn:documentation>Bước 9 · P. Cung Ứng. Nếu tiếp tục mua hàng, chuyển sang quy trình Mua hàng theo kế hoạch hoặc Mua hàng không thường xuyên. Nếu không, kết thúc quy trình.</bpmn:documentation><bpmn:incoming>AP48_F8</bpmn:incoming><bpmn:outgoing>AP48_F9</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP48_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP48_F9</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP48_F0" sourceRef="AP48_S" targetRef="AP48_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP48_F1" sourceRef="AP48_T0" targetRef="AP48_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP48_F2" sourceRef="AP48_T1" targetRef="AP48_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP48_F3" sourceRef="AP48_T2" targetRef="AP48_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP48_F4" sourceRef="AP48_T3" targetRef="AP48_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP48_F5" sourceRef="AP48_T4" targetRef="AP48_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP48_F6" sourceRef="AP48_T5" targetRef="AP48_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP48_F7" sourceRef="AP48_T6" targetRef="AP48_T7"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP48_F8" sourceRef="AP48_T7" targetRef="AP48_T8"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP48_F9" sourceRef="AP48_T8" targetRef="AP48_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP48_diagram"><bpmndi:BPMNPlane id="AP48_plane" bpmnElement="AP48_collab"><bpmndi:BPMNShape id="AP48_pool_di" bpmnElement="AP48_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="2376" height="704"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP48_lane_0_di" bpmnElement="AP48_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="2346" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP48_lane_1_di" bpmnElement="AP48_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="2346" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP48_lane_2_di" bpmnElement="AP48_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="2346" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP48_lane_3_di" bpmnElement="AP48_lane_3" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="618" width="2346" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP48_S_di" bpmnElement="AP48_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP48_T0_di" bpmnElement="AP48_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP48_T1_di" bpmnElement="AP48_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP48_T2_di" bpmnElement="AP48_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP48_T3_di" bpmnElement="AP48_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP48_T4_di" bpmnElement="AP48_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP48_T5_di" bpmnElement="AP48_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="658" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP48_T6_di" bpmnElement="AP48_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="658" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP48_T7_di" bpmnElement="AP48_T7" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1830" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP48_T8_di" bpmnElement="AP48_T8" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="2040" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP48_E_di" bpmnElement="AP48_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="2250" y="336" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="2206" y="381" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP48_F0_di" bpmnElement="AP48_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP48_F1_di" bpmnElement="AP48_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="540" y="178"/><di:waypoint x="540" y="354"/><di:waypoint x="570" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP48_F2_di" bpmnElement="AP48_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="354"/><di:waypoint x="780" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP48_F3_di" bpmnElement="AP48_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="354"/><di:waypoint x="960" y="354"/><di:waypoint x="960" y="530"/><di:waypoint x="990" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP48_F4_di" bpmnElement="AP48_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="530"/><di:waypoint x="1200" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP48_F5_di" bpmnElement="AP48_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="530"/><di:waypoint x="1380" y="530"/><di:waypoint x="1380" y="706"/><di:waypoint x="1410" y="706"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP48_F6_di" bpmnElement="AP48_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="706"/><di:waypoint x="1620" y="706"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP48_F7_di" bpmnElement="AP48_F7" bioc:stroke="#7e90aa"><di:waypoint x="1780" y="706"/><di:waypoint x="1800" y="706"/><di:waypoint x="1800" y="530"/><di:waypoint x="1830" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP48_F8_di" bpmnElement="AP48_F8" bioc:stroke="#7e90aa"><di:waypoint x="1990" y="530"/><di:waypoint x="2010" y="530"/><di:waypoint x="2010" y="354"/><di:waypoint x="2040" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP48_F9_di" bpmnElement="AP48_F9" bioc:stroke="#7e90aa"><di:waypoint x="2200" y="354"/><di:waypoint x="2250" y="354"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>