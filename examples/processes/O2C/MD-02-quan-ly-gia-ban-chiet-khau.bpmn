<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP34_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP34_collab"><bpmn:participant id="AP34_pool" name="Quản lý giá bán &amp; Chiết khấu" processRef="AP34"/></bpmn:collaboration><bpmn:process id="AP34" name="Quản lý giá bán &amp; Chiết khấu" isExecutable="false"><bpmn:laneSet id="AP34_lanes"><bpmn:lane id="AP34_lane_0" name="Phòng Kinh doanh"><bpmn:flowNodeRef>AP34_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP34_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP34_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP34_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP34_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP34_T6</bpmn:flowNodeRef><bpmn:flowNodeRef>AP34_T7</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP34_lane_1" name="Admin BAS"><bpmn:flowNodeRef>AP34_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP34_T5</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP34_lane_2" name="Phòng Kế toán"><bpmn:flowNodeRef>AP34_T8</bpmn:flowNodeRef><bpmn:flowNodeRef>AP34_E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP34_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP34_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP34_T0" name="01 · Thu thập chính sách giá"><bpmn:documentation>Bước 1 · P. Kinh doanh. Tổng hợp chính sách giá theo nhóm Khách hàng (NPP, TMĐT, Showroom, KH xuất khẩu), xác định hiệu lực áp dụng từ ngày.</bpmn:documentation><bpmn:incoming>AP34_F0</bpmn:incoming><bpmn:outgoing>AP34_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP34_T1" name="02 · Tạo Bảng giá bán mới"><bpmn:documentation>Bước 2 · NV P. Kinh doanh. Tạo Bảng giá bán theo nhóm Khách hàng, liệt kê mặt hàng và đơn giá tương ứng; lưu ở trạng thái Nháp để kiểm tra trước khi áp dụng.</bpmn:documentation><bpmn:incoming>AP34_F1</bpmn:incoming><bpmn:outgoing>AP34_F2</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="AP34_T2" name="03 · Phê duyệt &amp; kích hoạt
Bảng giá"><bpmn:documentation>Bước 3 · NV P. Kinh doanh. Kiểm tra lại bảng giá; chuyển sang trạng thái Hoạt động để hệ thống tự áp dụng trên Đơn bán hàng phát sinh mới.</bpmn:documentation><bpmn:incoming>AP34_F2</bpmn:incoming><bpmn:outgoing>AP34_F3</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="AP34_T3" name="04 · Đóng Bảng giá cũ"><bpmn:documentation>Bước 4 · NV P. Kinh doanh. Khi chính sách giá thay đổi, đóng Bảng giá cũ để không áp dụng được nữa; đảm bảo chỉ một Bảng giá đang hoạt động cho cùng nhóm và mặt hàng tại một thời điểm.</bpmn:documentation><bpmn:incoming>AP34_F3</bpmn:incoming><bpmn:outgoing>AP34_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP34_T4" name="05 · Thiết lập Chương trình
khuyến mãi"><bpmn:documentation>Bước 5 · Admin BAS. Khai báo Chương trình khuyến mãi với đối tượng áp dụng, kỳ hiệu lực và chính sách ưu đãi: chiết khấu %, giá Net, sản phẩm tặng kèm, tặng trên ngưỡng doanh số.</bpmn:documentation><bpmn:incoming>AP34_F4</bpmn:incoming><bpmn:outgoing>AP34_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP34_T5" name="06 · Kích hoạt Chương trình"><bpmn:documentation>Bước 6 · Admin BAS. Chuyển Chương trình khuyến mãi sang trạng thái Hoạt động; hệ thống cho phép áp dụng trên Đơn bán hàng trong kỳ hiệu lực.</bpmn:documentation><bpmn:incoming>AP34_F5</bpmn:incoming><bpmn:outgoing>AP34_F6</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="AP34_T6" name="07 · Áp dụng khuyến mãi trên
đơn"><bpmn:documentation>Bước 7 · NV Kinh doanh. Khi tạo Đơn bán hàng, áp dụng khuyến mãi phù hợp; hệ thống tự chèn dòng chiết khấu hoặc sản phẩm tặng theo chương trình.</bpmn:documentation><bpmn:incoming>AP34_F6</bpmn:incoming><bpmn:outgoing>AP34_F7</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="AP34_T7" name="08 · Điều chỉnh dòng chiết
khấu"><bpmn:documentation>Bước 8 · NV Kinh doanh. Khi cần điều chỉnh lại đơn (thay đổi số lượng, mặt hàng), xóa dòng chiết khấu cũ và tính lại để khớp với đơn mới.</bpmn:documentation><bpmn:incoming>AP34_F7</bpmn:incoming><bpmn:outgoing>AP34_F8</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP34_T8" name="09 · Kiểm tra sau khi xuất
hóa đơn"><bpmn:documentation>Bước 9 · NV Kế toán. Sau khi phát hành Hóa đơn bán hàng, kiểm tra dòng chiết khấu được tách đúng nhóm thuế; hóa đơn điện tử đẩy sang VNPT đúng thông tin.</bpmn:documentation><bpmn:incoming>AP34_F8</bpmn:incoming><bpmn:outgoing>AP34_F9</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP34_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP34_F9</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP34_F0" sourceRef="AP34_S" targetRef="AP34_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP34_F1" sourceRef="AP34_T0" targetRef="AP34_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP34_F2" sourceRef="AP34_T1" targetRef="AP34_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP34_F3" sourceRef="AP34_T2" targetRef="AP34_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP34_F4" sourceRef="AP34_T3" targetRef="AP34_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP34_F5" sourceRef="AP34_T4" targetRef="AP34_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP34_F6" sourceRef="AP34_T5" targetRef="AP34_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP34_F7" sourceRef="AP34_T6" targetRef="AP34_T7"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP34_F8" sourceRef="AP34_T7" targetRef="AP34_T8"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP34_F9" sourceRef="AP34_T8" targetRef="AP34_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP34_diagram"><bpmndi:BPMNPlane id="AP34_plane" bpmnElement="AP34_collab"><bpmndi:BPMNShape id="AP34_pool_di" bpmnElement="AP34_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="2376" height="528"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP34_lane_0_di" bpmnElement="AP34_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="2346" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP34_lane_1_di" bpmnElement="AP34_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="2346" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP34_lane_2_di" bpmnElement="AP34_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="2346" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP34_S_di" bpmnElement="AP34_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP34_T0_di" bpmnElement="AP34_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP34_T1_di" bpmnElement="AP34_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP34_T2_di" bpmnElement="AP34_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP34_T3_di" bpmnElement="AP34_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP34_T4_di" bpmnElement="AP34_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP34_T5_di" bpmnElement="AP34_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP34_T6_di" bpmnElement="AP34_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP34_T7_di" bpmnElement="AP34_T7" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1830" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP34_T8_di" bpmnElement="AP34_T8" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="2040" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP34_E_di" bpmnElement="AP34_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="2250" y="512" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="2206" y="557" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP34_F0_di" bpmnElement="AP34_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP34_F1_di" bpmnElement="AP34_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="570" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP34_F2_di" bpmnElement="AP34_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="178"/><di:waypoint x="780" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP34_F3_di" bpmnElement="AP34_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="178"/><di:waypoint x="990" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP34_F4_di" bpmnElement="AP34_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="178"/><di:waypoint x="1170" y="178"/><di:waypoint x="1170" y="354"/><di:waypoint x="1200" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP34_F5_di" bpmnElement="AP34_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="354"/><di:waypoint x="1410" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP34_F6_di" bpmnElement="AP34_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="354"/><di:waypoint x="1590" y="354"/><di:waypoint x="1590" y="178"/><di:waypoint x="1620" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP34_F7_di" bpmnElement="AP34_F7" bioc:stroke="#7e90aa"><di:waypoint x="1780" y="178"/><di:waypoint x="1830" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP34_F8_di" bpmnElement="AP34_F8" bioc:stroke="#7e90aa"><di:waypoint x="1990" y="178"/><di:waypoint x="2010" y="178"/><di:waypoint x="2010" y="530"/><di:waypoint x="2040" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP34_F9_di" bpmnElement="AP34_F9" bioc:stroke="#7e90aa"><di:waypoint x="2200" y="530"/>