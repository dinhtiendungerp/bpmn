<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP47_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP47_collab"><bpmn:participant id="AP47_pool" name="Mô tả bước thực hiện" processRef="AP47"/></bpmn:collaboration><bpmn:process id="AP47" name="Mô tả bước thực hiện" isExecutable="false"><bpmn:laneSet id="AP47_lanes"><bpmn:lane id="AP47_lane_0" name="Phòng Kinh doanh"><bpmn:flowNodeRef>AP47_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP47_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP47_T7</bpmn:flowNodeRef><bpmn:flowNodeRef>AP47_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP47_lane_1" name="KD / Admin BAS"><bpmn:flowNodeRef>AP47_T1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP47_lane_2" name="Phòng Kế toán"><bpmn:flowNodeRef>AP47_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP47_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP47_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP47_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP47_T6</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP47_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP47_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP47_T0" name="01 · Phân nhóm Khách hàng áp
dụng"><bpmn:documentation>Bước 1 · NV Kinh doanh. Phân loại Khách hàng theo nhóm (NPP, TMĐT, đại lý lớn) trên hồ sơ Khách hàng. Đây là điều kiện tiên quyết để hệ thống tính trả thưởng theo đúng chính sách từng nhóm.</bpmn:documentation><bpmn:incoming>AP47_F0</bpmn:incoming><bpmn:outgoing>AP47_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP47_T1" name="02 · Thiết lập Điều khoản
trả thưởng"><bpmn:documentation>Bước 2 · NV KD / Admin BAS. Khai báo Điều khoản thương mại cho từng nhóm Khách hàng; chọn phương thức tính: chiết khấu % theo doanh số, đạt ngưỡng doanh số hưởng chiết khấu cố định, tặng sản phẩm miễn phí. Khai báo kỳ hiệu lực.</bpmn:documentation><bpmn:incoming>AP47_F1</bpmn:incoming><bpmn:outgoing>AP47_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP47_T2" name="03 · Thu thập dữ liệu doanh
số"><bpmn:documentation>Bước 3 · NV Kế toán. Thu thập dữ liệu doanh số bán trong kỳ tính thưởng cho từng Khách hàng - là căn cứ tính mức trả thưởng theo Điều khoản đã khai báo.</bpmn:documentation><bpmn:incoming>AP47_F2</bpmn:incoming><bpmn:outgoing>AP47_F3</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="AP47_T3" name="04 · Tính &amp; tạo Đề xuất trả
thưởng"><bpmn:documentation>Bước 4 · NV Kế toán. Hệ thống tự tính trả thưởng theo Điều khoản và doanh số thu thập; sinh ra Đề xuất trả thưởng cho từng Khách hàng với số tiền / sản phẩm tương ứng.</bpmn:documentation><bpmn:incoming>AP47_F3</bpmn:incoming><bpmn:outgoing>AP47_F4</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="AP47_T4" name="05 · Phê duyệt Đề xuất"><bpmn:documentation>Bước 5 · NV Kế toán. Kế toán có quyền phê duyệt (theo phân quyền) mở Đề xuất để sang bước thực hiện. Đề xuất chưa duyệt không thể phát sinh giao dịch.</bpmn:documentation><bpmn:incoming>AP47_F4</bpmn:incoming><bpmn:outgoing>AP47_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP47_T5" name="06 · Chọn phương thức trả"><bpmn:documentation>Bước 6 · NV Kế toán. Chọn phương thức thực hiện: (1) Sản phẩm tặng kèm, (2) Chi tiền mặt, (3) Hóa đơn điều chỉnh cấn trừ công nợ, (4) Chiết khấu áp dụng trên Đơn bán hàng kế tiếp. Lựa chọn theo thỏa thuận với Khách hàng.</bpmn:documentation><bpmn:incoming>AP47_F5</bpmn:incoming><bpmn:outgoing>AP47_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP47_T6" name="07 · Thực hiện &amp; ghi sổ"><bpmn:documentation>Bước 7 · NV Kế toán. Tạo chứng từ tương ứng phương thức đã chọn: Hóa đơn điều chỉnh giảm, Phiếu chi tiền mặt, hoặc Phiếu xuất sản phẩm tặng; post ghi sổ công nợ giảm / chi tiền / xuất kho.</bpmn:documentation><bpmn:incoming>AP47_F6</bpmn:incoming><bpmn:outgoing>AP47_F7</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="AP47_T7" name="08 · Áp dụng chiết khấu đơn
kế tiếp"><bpmn:documentation>Bước 8 · NV Kinh doanh. Khi Khách hàng có Đề xuất trả thưởng chọn phương thức chiết khấu: Kinh doanh lập Đơn bán hàng kế tiếp cho Khách hàng đó và áp dụng trả thưởng - hệ thống tự khấu trừ đúng số tiền chưa dùng.</bpmn:documentation><bpmn:incoming>AP47_F7</bpmn:incoming><bpmn:outgoing>AP47_F8</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="AP47_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP47_F8</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP47_F0" sourceRef="AP47_S" targetRef="AP47_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP47_F1" sourceRef="AP47_T0" targetRef="AP47_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP47_F2" sourceRef="AP47_T1" targetRef="AP47_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP47_F3" sourceRef="AP47_T2" targetRef="AP47_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP47_F4" sourceRef="AP47_T3" targetRef="AP47_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP47_F5" sourceRef="AP47_T4" targetRef="AP47_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP47_F6" sourceRef="AP47_T5" targetRef="AP47_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP47_F7" sourceRef="AP47_T6" targetRef="AP47_T7"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP47_F8" sourceRef="AP47_T7" targetRef="AP47_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP47_diagram"><bpmndi:BPMNPlane id="AP47_plane" bpmnElement="AP47_collab"><bpmndi:BPMNShape id="AP47_pool_di" bpmnElement="AP47_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="2166" height="528"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP47_lane_0_di" bpmnElement="AP47_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP47_lane_1_di" bpmnElement="AP47_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP47_lane_2_di" bpmnElement="AP47_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP47_S_di" bpmnElement="AP47_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP47_T0_di" bpmnElement="AP47_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP47_T1_di" bpmnElement="AP47_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP47_T2_di" bpmnElement="AP47_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP47_T3_di" bpmnElement="AP47_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP47_T4_di" bpmnElement="AP47_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP47_T5_di" bpmnElement="AP47_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP47_T6_di" bpmnElement="AP47_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP47_T7_di" bpmnElement="AP47_T7" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1830" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP47_E_di" bpmnElement="AP47_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="2040" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1996" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP47_F0_di" bpmnElement="AP47_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP47_F1_di" bpmnElement="AP47_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="540" y="178"/><di:waypoint x="540" y="354"/><di:waypoint x="570" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP47_F2_di" bpmnElement="AP47_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="354"/><di:waypoint x="750" y="354"/><di:waypoint x="750" y="530"/><di:waypoint x="780" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP47_F3_di" bpmnElement="AP47_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="530"/><di:waypoint x="990" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP47_F4_di" bpmnElement="AP47_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="530"/><di:waypoint x="1200" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP47_F5_di" bpmnElement="AP47_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="530"/><di:waypoint x="1410" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP47_F6_di" bpmnElement="AP47_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="530"/><di:waypoint x="1620" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP47_F7_di" bpmnElement="AP47_F7" bioc:stroke="#7e90aa"><di:waypoint x="1780" y="530"/><di:waypoint x="1800" y="530"/><di:waypoint x="1800" y="178"/><di:waypoint x="1830" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP47_F8_di" bpmnElement="AP47_F8" bioc:stroke="#7e90aa"><di:waypoint x="1990" y="178"/><di:waypoint x="2040" y="178"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>