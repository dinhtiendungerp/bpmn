<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP44_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP44_collab"><bpmn:participant id="AP44_pool" name="Quản lý đơn trả hàng bán" processRef="AP44"/></bpmn:collaboration><bpmn:process id="AP44" name="Quản lý đơn trả hàng bán" isExecutable="false"><bpmn:laneSet id="AP44_lanes"><bpmn:lane id="AP44_lane_0" name="Phòng Kinh doanh"><bpmn:flowNodeRef>AP44_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP44_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP44_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP44_T2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP44_lane_1" name="Bộ phận Kho"><bpmn:flowNodeRef>AP44_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP44_T7</bpmn:flowNodeRef><bpmn:flowNodeRef>AP44_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP44_lane_2" name="Bộ phận Quản lý chất lượng"><bpmn:flowNodeRef>AP44_T4</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP44_lane_3" name="Phòng Kế toán"><bpmn:flowNodeRef>AP44_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP44_T6</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP44_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP44_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP44_T0" name="01 · Tiếp nhận yêu cầu trả"><bpmn:documentation>Bước 1 · NV P. Kinh doanh. Khách hàng thông báo trả hàng do: hàng lỗi, hàng cận date, sai đơn đặt, điều chỉnh doanh số. Xác nhận lý do, mặt hàng, số lượng, tham chiếu Phiếu giao hàng gốc.</bpmn:documentation><bpmn:incoming>AP44_F0</bpmn:incoming><bpmn:outgoing>AP44_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP44_T1" name="02 · Lập Đơn trả hàng bán"><bpmn:documentation>Bước 2 · NV P. Kinh doanh. Lập Đơn trả hàng bán tham chiếu Phiếu giao hàng gốc; số lượng trả không vượt quá số lượng đã giao và gửi phê duyệt</bpmn:documentation><bpmn:incoming>AP44_F1</bpmn:incoming><bpmn:outgoing>AP44_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP44_T2" name="03 · Phê duyệt Đơn trả"><bpmn:documentation>Bước 3 · TP. Kinh doanh. Phê duyệt Đơn trả để kiểm soát tính chính đáng của việc trả hàng.</bpmn:documentation><bpmn:incoming>AP44_F2</bpmn:incoming><bpmn:outgoing>AP44_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP44_T3" name="04 · Nhận hàng trả về kho"><bpmn:documentation>Bước 4 · NV Kho. Khi hàng về, Kho tiếp nhận theo Đơn trả; gán đúng Lô hàng trả (cùng Lô đã xuất trước đây) để đảm bảo truy xuất; post nhận hàng.</bpmn:documentation><bpmn:incoming>AP44_F3</bpmn:incoming><bpmn:outgoing>AP44_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP44_T4" name="05 · Kiểm tra chất lượng
hàng trả"><bpmn:documentation>Bước 5 · NV QC. QC kiểm tra tình trạng hàng trả về. Đạt: có thể bán lại; Không đạt: chuyển sang quy trình xử lý hàng lỗi / tiêu hủy.</bpmn:documentation><bpmn:incoming>AP44_F4</bpmn:incoming><bpmn:outgoing>AP44_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP44_T5" name="06 · Hóa đơn điều chỉnh giảm"><bpmn:documentation>Bước 6 · NV Kế toán. Sau khi hàng trả đã nhận, Kế toán phát hành Hóa đơn điều chỉnh giảm cho Khách hàng; công nợ phải thu Khách hàng tự động giảm.</bpmn:documentation><bpmn:incoming>AP44_F5</bpmn:incoming><bpmn:outgoing>AP44_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP44_T6" name="07 · Kiểm tra công nợ"><bpmn:documentation>Bước 7 · NV Kế toán. Kiểm tra số dư công nợ Khách hàng sau khi điều chỉnh; đối chiếu Hóa đơn gốc vs Hóa đơn điều chỉnh giảm đảm bảo khớp số liệu.</bpmn:documentation><bpmn:incoming>AP44_F6</bpmn:incoming><bpmn:outgoing>AP44_F7</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP44_T7" name="08 · Xử lý hàng hư hỏng"><bpmn:documentation>Bước 8 · NV KT / Kho. Trường hợp hàng NPP gửi trả bị lỗi / hư hỏng: Kế toán ghi nhận chi phí sửa chữa bao bì, phân bổ chi phí vào Đơn bán hàng mới khi tái xuất; hoặc tiêu hủy nếu không sửa được.</bpmn:documentation><bpmn:incoming>AP44_F7</bpmn:incoming><bpmn:outgoing>AP44_F8</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP44_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP44_F8</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP44_F0" sourceRef="AP44_S" targetRef="AP44_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP44_F1" sourceRef="AP44_T0" targetRef="AP44_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP44_F2" sourceRef="AP44_T1" targetRef="AP44_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP44_F3" sourceRef="AP44_T2" targetRef="AP44_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP44_F4" sourceRef="AP44_T3" targetRef="AP44_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP44_F5" sourceRef="AP44_T4" targetRef="AP44_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP44_F6" sourceRef="AP44_T5" targetRef="AP44_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP44_F7" sourceRef="AP44_T6" targetRef="AP44_T7"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP44_F8" sourceRef="AP44_T7" targetRef="AP44_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP44_diagram"><bpmndi:BPMNPlane id="AP44_plane" bpmnElement="AP44_collab"><bpmndi:BPMNShape id="AP44_pool_di" bpmnElement="AP44_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="2166" height="704"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP44_lane_0_di" bpmnElement="AP44_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP44_lane_1_di" bpmnElement="AP44_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP44_lane_2_di" bpmnElement="AP44_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP44_lane_3_di" bpmnElement="AP44_lane_3" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="618" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP44_S_di" bpmnElement="AP44_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP44_T0_di" bpmnElement="AP44_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP44_T1_di" bpmnElement="AP44_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP44_T2_di" bpmnElement="AP44_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP44_T3_di" bpmnElement="AP44_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP44_T4_di" bpmnElement="AP44_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP44_T5_di" bpmnElement="AP44_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="658" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP44_T6_di" bpmnElement="AP44_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="658" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP44_T7_di" bpmnElement="AP44_T7" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1830" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP44_E_di" bpmnElement="AP44_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="2040" y="336" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1996" y="381" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP44_F0_di" bpmnElement="AP44_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP44_F1_di" bpmnElement="AP44_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="570" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP44_F2_di" bpmnElement="AP44_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="178"/><di:waypoint x="780" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP44_F3_di" bpmnElement="AP44_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="178"/><di:waypoint x="960" y="178"/><di:waypoint x="960" y="354"/><di:waypoint x="990" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP44_F4_di" bpmnElement="AP44_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="354"/><di:waypoint x="1170" y="354"/><di:waypoint x="1170" y="530"/><di:waypoint x="1200" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP44_F5_di" bpmnElement="AP44_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="530"/><di:waypoint x="1380" y="530"/><di:waypoint x="1380" y="706"/><di:waypoint x="1410" y="706"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP44_F6_di" bpmnElement="AP44_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="706"/><di:waypoint x="1620" y="706"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP44_F7_di" bpmnElement="AP44_F7" bioc:stroke="#7e90aa"><di:waypoint x="1780" y="706"/><di:waypoint x="1800" y="706"/><di:waypoint x="1800" y="354"/><di:waypoint x="1830" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP44_F8_di" bpmnElement="AP44_F8" bioc:stroke="#7e90aa"><di:waypoint x="1990" y="354"/><di:waypoint x="2040" y="354"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>