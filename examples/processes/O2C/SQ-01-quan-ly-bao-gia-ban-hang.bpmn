<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP36_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP36_collab"><bpmn:participant id="AP36_pool" name="Quản lý Báo giá bán hàng" processRef="AP36"/></bpmn:collaboration><bpmn:process id="AP36" name="Quản lý Báo giá bán hàng" isExecutable="false"><bpmn:laneSet id="AP36_lanes"><bpmn:lane id="AP36_lane_0" name="Khách hàng"><bpmn:flowNodeRef>AP36_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP36_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP36_T5</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP36_lane_1" name="Phòng Kinh doanh"><bpmn:flowNodeRef>AP36_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP36_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP36_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP36_T6</bpmn:flowNodeRef><bpmn:flowNodeRef>AP36_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP36_lane_2" name="Trưởng BP KD"><bpmn:flowNodeRef>AP36_T3</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP36_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP36_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP36_T0" name="01 · Gửi yêu cầu báo giá"><bpmn:documentation>Bước 1 · Khách hàng. Khách hàng liên hệ Phòng Kinh doanh đề nghị báo giá cho một số mặt hàng và số lượng cụ thể; có thể đi kèm điều khoản giao hàng, thanh toán mong muốn.</bpmn:documentation><bpmn:incoming>AP36_F0</bpmn:incoming><bpmn:outgoing>AP36_F1</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="AP36_T1" name="02 · Lập Báo giá"><bpmn:documentation>Bước 2 · NV P. Kinh doanh. Lập Báo giá cho Khách hàng với mặt hàng, số lượng; đơn giá được hệ thống tự gợi ý từ Bảng giá bán đang hoạt động cho nhóm Khách hàng tương ứng.</bpmn:documentation><bpmn:incoming>AP36_F1</bpmn:incoming><bpmn:outgoing>AP36_F2</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="AP36_T2" name="03 · Gửi phê duyệt Báo giá"><bpmn:documentation>Bước 3 · NV P. Kinh doanh. Gửi Báo giá đi phê duyệt nội bộ; Trưởng BP Kinh doanh xem xét trước khi phát hành chính thức cho Khách hàng.</bpmn:documentation><bpmn:incoming>AP36_F2</bpmn:incoming><bpmn:outgoing>AP36_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP36_T3" name="04 · Phê duyệt / Từ chối"><bpmn:documentation>Bước 4 · Trưởng BP KD. Kiểm tra thông tin Khách hàng, mặt hàng, số lượng, đơn giá. Duyệt nếu hợp lệ; từ chối kèm lý do nếu chưa phù hợp để Nhân viên điều chỉnh.</bpmn:documentation><bpmn:incoming>AP36_F3</bpmn:incoming><bpmn:outgoing>AP36_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP36_T4" name="05 · In Báo giá, gửi Khách
hàng"><bpmn:documentation>Bước 5 · NV P. Kinh doanh. Sau khi Báo giá được duyệt, in theo mẫu và gửi Khách hàng qua email hoặc văn bản.</bpmn:documentation><bpmn:incoming>AP36_F4</bpmn:incoming><bpmn:outgoing>AP36_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP36_T5" name="06 · Phản hồi chấp nhận"><bpmn:documentation>Bước 6 · Khách hàng. Khách hàng xác nhận đồng ý điều khoản trong Báo giá; gửi phản hồi bằng văn bản, email hoặc đơn đặt hàng chính thức.</bpmn:documentation><bpmn:incoming>AP36_F5</bpmn:incoming><bpmn:outgoing>AP36_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP36_T6" name="07 · Chuyển thành Đơn bán
hàng"><bpmn:documentation>Bước 7 · NV P. Kinh doanh. Chuyển Báo giá đã được Khách hàng chấp nhận thành Đơn bán hàng; các thông tin trên Báo giá kế thừa sang Đơn bán hàng mới, không cần nhập lại.</bpmn:documentation><bpmn:incoming>AP36_F6</bpmn:incoming><bpmn:outgoing>AP36_F7</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP36_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP36_F7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP36_F0" sourceRef="AP36_S" targetRef="AP36_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP36_F1" sourceRef="AP36_T0" targetRef="AP36_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP36_F2" sourceRef="AP36_T1" targetRef="AP36_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP36_F3" sourceRef="AP36_T2" targetRef="AP36_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP36_F4" sourceRef="AP36_T3" targetRef="AP36_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP36_F5" sourceRef="AP36_T4" targetRef="AP36_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP36_F6" sourceRef="AP36_T5" targetRef="AP36_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP36_F7" sourceRef="AP36_T6" targetRef="AP36_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP36_diagram"><bpmndi:BPMNPlane id="AP36_plane" bpmnElement="AP36_collab"><bpmndi:BPMNShape id="AP36_pool_di" bpmnElement="AP36_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1956" height="528"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP36_lane_0_di" bpmnElement="AP36_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP36_lane_1_di" bpmnElement="AP36_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP36_lane_2_di" bpmnElement="AP36_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP36_S_di" bpmnElement="AP36_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP36_T0_di" bpmnElement="AP36_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP36_T1_di" bpmnElement="AP36_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP36_T2_di" bpmnElement="AP36_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP36_T3_di" bpmnElement="AP36_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP36_T4_di" bpmnElement="AP36_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP36_T5_di" bpmnElement="AP36_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP36_T6_di" bpmnElement="AP36_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP36_E_di" bpmnElement="AP36_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1830" y="336" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1786" y="381" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP36_F0_di" bpmnElement="AP36_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP36_F1_di" bpmnElement="AP36_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="540" y="178"/><di:waypoint x="540" y="354"/><di:waypoint x="570" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP36_F2_di" bpmnElement="AP36_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="354"/><di:waypoint x="780" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP36_F3_di" bpmnElement="AP36_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="354"/><di:waypoint x="960" y="354"/><di:waypoint x="960" y="530"/><di:waypoint x="990" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP36_F4_di" bpmnElement="AP36_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="530"/><di:waypoint x="1170" y="530"/><di:waypoint x="1170" y="354"/><di:waypoint x="1200" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP36_F5_di" bpmnElement="AP36_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="354"/><di:waypoint x="1380" y="354"/><di:waypoint x="1380" y="178"/><di:waypoint x="1410" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP36_F6_di" bpmnElement="AP36_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="178"/><di:waypoint x="1590" y="178"/><di:waypoint x="1590" y="354"/><di:waypoint x="1620" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP36_F7_di" bpmnElement="AP36_F7" bioc:stroke="#7e90aa"><di:waypoint x="1780" y="354"/><di:waypoint x="1830" y="354"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>