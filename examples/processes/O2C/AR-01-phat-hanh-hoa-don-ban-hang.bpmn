<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP46_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP46_collab"><bpmn:participant id="AP46_pool" name="Phát hành hóa đơn bán hàng" processRef="AP46"/></bpmn:collaboration><bpmn:process id="AP46" name="Phát hành hóa đơn bán hàng" isExecutable="false"><bpmn:laneSet id="AP46_lanes"><bpmn:lane id="AP46_lane_0" name="Bộ phận Kho"><bpmn:flowNodeRef>AP46_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP46_T0</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP46_lane_1" name="Phòng Kế toán"><bpmn:flowNodeRef>AP46_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP46_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP46_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP46_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP46_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP46_T6</bpmn:flowNodeRef><bpmn:flowNodeRef>AP46_T7</bpmn:flowNodeRef><bpmn:flowNodeRef>AP46_E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP46_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP46_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP46_T0" name="01 · Nhận Phiếu xuất kho"><bpmn:documentation>Bước 1 · NV Kho / KT. Kho post xuất hàng sau khi giao; Kế toán lấy Phiếu xuất đã post làm căn cứ lập Hóa đơn bán hàng đảm bảo khớp giữa hàng đã giao và hóa đơn.</bpmn:documentation><bpmn:incoming>AP46_F0</bpmn:incoming><bpmn:outgoing>AP46_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP46_T1" name="02 · Lập Hóa đơn bán hàng"><bpmn:documentation>Bước 2 · NV Kế toán. Lập Hóa đơn bán hàng cho Khách hàng, lấy dòng từ Phiếu xuất đã post; kiểm tra số lượng, đơn giá, thuế GTGT khớp với Đơn bán hàng gốc.</bpmn:documentation><bpmn:incoming>AP46_F1</bpmn:incoming><bpmn:outgoing>AP46_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP46_T2" name="03 · Kiểm tra tiền, thuế,
hạch toán"><bpmn:documentation>Bước 3 · NV Kế toán. Rà soát nhóm thuế sản phẩm, nhóm sản phẩm, tổng tiền, tiền thuế, nhóm hạch toán Khách hàng - đảm bảo hóa đơn đúng quy định thuế Việt Nam trước khi phát hành.</bpmn:documentation><bpmn:incoming>AP46_F2</bpmn:incoming><bpmn:outgoing>AP46_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP46_T3" name="04 · Phát hành hóa đơn &amp; tự
đẩy VNPT"><bpmn:documentation>Bước 4 · NV Kế toán. Phát hành hóa đơn. Nếu hệ thống đã thiết lập tự động kết nối VNPT, hóa đơn tự đẩy sang VNPT cấp mã và gửi Khách hàng; kiểm tra log hóa đơn điện tử.</bpmn:documentation><bpmn:incoming>AP46_F3</bpmn:incoming><bpmn:outgoing>AP46_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP46_T4" name="05 · Gửi VNPT thủ công"><bpmn:documentation>Bước 5 · NV Kế toán. Trường hợp cài đặt không bật tự động, Kế toán mở hóa đơn, kiểm tra lại thông tin và gửi VNPT bằng thao tác thủ công.</bpmn:documentation><bpmn:incoming>AP46_F4</bpmn:incoming><bpmn:outgoing>AP46_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP46_T5" name="06 · Hóa đơn điều chỉnh giảm"><bpmn:documentation>Bước 6 · NV Kế toán. Phát hành Hóa đơn điều chỉnh giảm cho các trường hợp: KH trả hàng, chiết khấu sau, giảm giá chất lượng. Hóa đơn điều chỉnh tham chiếu hóa đơn gốc, tự động cấn trừ công nợ.</bpmn:documentation><bpmn:incoming>AP46_F5</bpmn:incoming><bpmn:outgoing>AP46_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP46_T6" name="07 · Điều chỉnh thông tin
người mua"><bpmn:documentation>Bước 7 · NV Kế toán. Khi phát hiện thông tin người mua sai sau khi hóa đơn đã ký (sai tên công ty, MST), phát hành hóa đơn điều chỉnh thông tin thay vì hủy hóa đơn gốc.</bpmn:documentation><bpmn:incoming>AP46_F6</bpmn:incoming><bpmn:outgoing>AP46_F7</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP46_T7" name="08 · HĐ trả thưởng · khen
thưởng · khuyến mại"><bpmn:documentation>Bước 8 · NV Kế toán. Các trường hợp hạch toán riêng: (1) HĐ trả thưởng hàng - trích trước Nợ 641/Có 335 cuối quý, xuất Nợ 335/Có 155+33311; (2) HĐ trả thưởng trong kỳ Nợ 641/Có 33311+155; (3) HĐ khen thưởng phúc lợi Nợ 353/Có 33311+511; (4) HĐ khuyến mại - chiết khấu 100%; (5) HĐ thay thế.</bpmn:documentation><bpmn:incoming>AP46_F7</bpmn:incoming><bpmn:outgoing>AP46_F8</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP46_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP46_F8</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP46_F0" sourceRef="AP46_S" targetRef="AP46_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP46_F1" sourceRef="AP46_T0" targetRef="AP46_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP46_F2" sourceRef="AP46_T1" targetRef="AP46_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP46_F3" sourceRef="AP46_T2" targetRef="AP46_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP46_F4" sourceRef="AP46_T3" targetRef="AP46_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP46_F5" sourceRef="AP46_T4" targetRef="AP46_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP46_F6" sourceRef="AP46_T5" targetRef="AP46_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP46_F7" sourceRef="AP46_T6" targetRef="AP46_T7"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP46_F8" sourceRef="AP46_T7" targetRef="AP46_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP46_diagram"><bpmndi:BPMNPlane id="AP46_plane" bpmnElement="AP46_collab"><bpmndi:BPMNShape id="AP46_pool_di" bpmnElement="AP46_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="2166" height="352"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP46_lane_0_di" bpmnElement="AP46_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP46_lane_1_di" bpmnElement="AP46_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP46_S_di" bpmnElement="AP46_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP46_T0_di" bpmnElement="AP46_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP46_T1_di" bpmnElement="AP46_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP46_T2_di" bpmnElement="AP46_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP46_T3_di" bpmnElement="AP46_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP46_T4_di" bpmnElement="AP46_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP46_T5_di" bpmnElement="AP46_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP46_T6_di" bpmnElement="AP46_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP46_T7_di" bpmnElement="AP46_T7" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1830" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP46_E_di" bpmnElement="AP46_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="2040" y="336" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1996" y="381" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP46_F0_di" bpmnElement="AP46_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP46_F1_di" bpmnElement="AP46_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="540" y="178"/><di:waypoint x="540" y="354"/><di:waypoint x="570" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP46_F2_di" bpmnElement="AP46_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="354"/><di:waypoint x="780" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP46_F3_di" bpmnElement="AP46_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="354"/><di:waypoint x="990" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP46_F4_di" bpmnElement="AP46_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="354"/><di:waypoint x="1200" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP46_F5_di" bpmnElement="AP46_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="354"/><di:waypoint x="1410" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP46_F6_di" bpmnElement="AP46_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="354"/><di:waypoint x="1620" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP46_F7_di" bpmnElement="AP46_F7" bioc:stroke="#7e90aa"><di:waypoint x="1780" y="354"/><di:waypoint x="1830" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP46_F8_di" bpmnElement="AP46_F8" bioc:stroke="#7e90aa"><di:waypoint x="1990" y="354"/><di:waypoint x="2040" y="354"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>