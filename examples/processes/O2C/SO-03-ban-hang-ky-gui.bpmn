<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP40_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP40_collab"><bpmn:participant id="AP40_pool" name="Bán hàng ký gửi" processRef="AP40"/></bpmn:collaboration><bpmn:process id="AP40" name="Bán hàng ký gửi" isExecutable="false"><bpmn:laneSet id="AP40_lanes"><bpmn:lane id="AP40_lane_0" name="Phòng Kinh doanh"><bpmn:flowNodeRef>AP40_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP40_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP40_T5</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP40_lane_1" name="KD"><bpmn:flowNodeRef>AP40_T1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP40_lane_2" name="Bộ phận Kho"><bpmn:flowNodeRef>AP40_T2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP40_lane_3" name="Phòng Kế toán"><bpmn:flowNodeRef>AP40_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP40_T6</bpmn:flowNodeRef><bpmn:flowNodeRef>AP40_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP40_lane_4" name="NPP"><bpmn:flowNodeRef>AP40_T4</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP40_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP40_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP40_T0" name="01 · Ký hợp đồng ký gửi"><bpmn:documentation>Bước 1 · P. Kinh doanh / NPP. và NPP thống nhất danh mục SKU được ký gửi, tỷ lệ chiết khấu, chu kỳ báo cáo doanh thu, chính sách thu hồi hàng tồn cuối kỳ.</bpmn:documentation><bpmn:incoming>AP40_F0</bpmn:incoming><bpmn:outgoing>AP40_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP40_T1" name="02 · Điều chuyển hàng sang
NPP"><bpmn:documentation>Bước 2 · NV KD. Điều chuyển hàng từ kho tổng của sang kho ký gửi của NPP. Hàng vẫn thuộc sở hữu, chỉ đang đặt tại NPP chờ bán.</bpmn:documentation><bpmn:incoming>AP40_F1</bpmn:incoming><bpmn:outgoing>AP40_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP40_T2" name="03 · Xuất - Nhập điều chuyển"><bpmn:documentation>Bước 3 · NV Kho. Ghi sổ Xuất tại kho tổng; Ghi sổ Nhận tại kho ký gửi của NPP. Trên sổ sách, tồn kho chuyển từ kho sang kho ký gửi.</bpmn:documentation><bpmn:incoming>AP40_F2</bpmn:incoming><bpmn:outgoing>AP40_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP40_T3" name="04 · Phát hành phiếu xuất
hàng ký gửi đại lý"><bpmn:documentation>Bước 4 · NV Kế toán. Phát hành phiếu xuất hàng ký gửi đại lý theo yêu cầu thuế Việt Nam; hóa đơn đẩy qua VNPT.</bpmn:documentation><bpmn:incoming>AP40_F3</bpmn:incoming><bpmn:outgoing>AP40_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP40_T4" name="05 · Báo cáo doanh thu đã
bán"><bpmn:documentation>Bước 5 · NPP. Theo chu kỳ đã thống nhất (tuần, tháng), NPP tổng hợp số lượng thực tế bán ra từ kho ký gửi và gửi báo cáo về để đối chiếu.</bpmn:documentation><bpmn:incoming>AP40_F4</bpmn:incoming><bpmn:outgoing>AP40_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP40_T5" name="06 · Ghi nhận Đơn bán hàng"><bpmn:documentation>Bước 6 · NV Kinh doanh. Căn cứ báo cáo NPP, Kinh doanh lập Đơn bán hàng với NPP là Khách hàng, mã kho xuất là kho ký gửi tương ứng - ghi nhận doanh thu cho.</bpmn:documentation><bpmn:incoming>AP40_F5</bpmn:incoming><bpmn:outgoing>AP40_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP40_T6" name="07 · Phát hành Hóa đơn bán
hàng"><bpmn:documentation>Bước 7 · NV Kế toán. Lập Hóa đơn bán hàng cho NPP theo Đơn bán hàng đã xuất; hóa đơn điện tử đẩy VNPT. Kết thúc quy trình ghi nhận doanh thu ký gửi.</bpmn:documentation><bpmn:incoming>AP40_F6</bpmn:incoming><bpmn:outgoing>AP40_F7</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP40_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP40_F7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP40_F0" sourceRef="AP40_S" targetRef="AP40_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP40_F1" sourceRef="AP40_T0" targetRef="AP40_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP40_F2" sourceRef="AP40_T1" targetRef="AP40_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP40_F3" sourceRef="AP40_T2" targetRef="AP40_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP40_F4" sourceRef="AP40_T3" targetRef="AP40_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP40_F5" sourceRef="AP40_T4" targetRef="AP40_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP40_F6" sourceRef="AP40_T5" targetRef="AP40_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP40_F7" sourceRef="AP40_T6" targetRef="AP40_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP40_diagram"><bpmndi:BPMNPlane id="AP40_plane" bpmnElement="AP40_collab"><bpmndi:BPMNShape id="AP40_pool_di" bpmnElement="AP40_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1956" height="880"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP40_lane_0_di" bpmnElement="AP40_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP40_lane_1_di" bpmnElement="AP40_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP40_lane_2_di" bpmnElement="AP40_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP40_lane_3_di" bpmnElement="AP40_lane_3" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="618" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP40_lane_4_di" bpmnElement="AP40_lane_4" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="794" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP40_S_di" bpmnElement="AP40_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP40_T0_di" bpmnElement="AP40_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP40_T1_di" bpmnElement="AP40_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP40_T2_di" bpmnElement="AP40_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP40_T3_di" bpmnElement="AP40_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="658" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP40_T4_di" bpmnElement="AP40_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="834" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP40_T5_di" bpmnElement="AP40_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP40_T6_di" bpmnElement="AP40_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="658" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP40_E_di" bpmnElement="AP40_E" bioc:fill="#fff0f0" bioc:stroke="#b9