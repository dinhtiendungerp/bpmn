<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP39_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP39_collab"><bpmn:participant id="AP39_pool" name="Bán hàng thương mại điện tử" processRef="AP39"/></bpmn:collaboration><bpmn:process id="AP39" name="Bán hàng thương mại điện tử" isExecutable="false"><bpmn:laneSet id="AP39_lanes"><bpmn:lane id="AP39_lane_0" name="KD Online"><bpmn:flowNodeRef>AP39_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP39_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP39_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP39_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP39_T3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP39_lane_1" name="Bộ phận Kho"><bpmn:flowNodeRef>AP39_T4</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP39_lane_2" name="Phòng Kế toán"><bpmn:flowNodeRef>AP39_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP39_T6</bpmn:flowNodeRef><bpmn:flowNodeRef>AP39_T7</bpmn:flowNodeRef><bpmn:flowNodeRef>AP39_E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP39_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP39_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP39_T0" name="01 · Thu thập đơn hàng từ
sàn"><bpmn:documentation>Bước 1 · NV KD Online. Tải danh sách đơn hàng phát sinh trong ngày từ cổng quản trị của Shopee, Tiki, Lazada, TikTok Shop; phân loại theo đơn mới, đơn đã giao, đơn trả.</bpmn:documentation><bpmn:incoming>AP39_F0</bpmn:incoming><bpmn:outgoing>AP39_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP39_T1" name="02 · Chuẩn hóa dữ liệu theo
mẫu"><bpmn:documentation>Bước 2 · NV KD Online. Ánh xạ dữ liệu đơn hàng từ sàn sang mẫu nhập chuẩn của: mã Khách hàng (là mã sàn), mã mặt hàng, số lượng, đơn giá, ngày giao.</bpmn:documentation><bpmn:incoming>AP39_F1</bpmn:incoming><bpmn:outgoing>AP39_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP39_T2" name="03 · Nhập Đơn bán hàng hàng
loạt"><bpmn:documentation>Bước 3 · NV KD Online. Nhập file dữ liệu vào hệ thống, sinh Đơn bán hàng hàng loạt thay vì nhập tay từng đơn - tiết kiệm thời gian khi có hàng trăm đơn / ngày.</bpmn:documentation><bpmn:incoming>AP39_F2</bpmn:incoming><bpmn:outgoing>AP39_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP39_T3" name="04 · Kiểm tra log &amp; đơn đã
tạo"><bpmn:documentation>Bước 4 · NV KD Online. Hệ thống báo cáo các dòng bị lỗi (mã hàng chưa tồn tại, Khách hàng sàn chưa khai báo). Xử lý lỗi và nhập bổ sung; mở các đơn đã tạo kiểm tra đơn giá, số lượng.</bpmn:documentation><bpmn:incoming>AP39_F3</bpmn:incoming><bpmn:outgoing>AP39_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP39_T4" name="05 · Xuất kho đơn TMĐT"><bpmn:documentation>Bước 5 · NV Kho. Tạo Phiếu xuất kho hàng loạt từ các Đơn bán hàng TMĐT đã duyệt; xuất tại kho bán hàng TMĐT theo FEFO.</bpmn:documentation><bpmn:incoming>AP39_F4</bpmn:incoming><bpmn:outgoing>AP39_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP39_T5" name="06 · Phát hành Hóa đơn"><bpmn:documentation>Bước 6 · NV Kế toán. Lập Hóa đơn bán hàng cho từng đơn TMĐT theo Phiếu xuất kho; hóa đơn điện tử đẩy qua VNPT về sàn / Khách hàng.</bpmn:documentation><bpmn:incoming>AP39_F5</bpmn:incoming><bpmn:outgoing>AP39_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP39_T6" name="07 · Theo dõi công nợ sàn"><bpmn:documentation>Bước 7 · NV Kế toán. Theo dõi số dư công nợ của từng sàn TMĐT; đối chiếu doanh số bán với báo cáo từ sàn để phát hiện sai lệch.</bpmn:documentation><bpmn:incoming>AP39_F6</bpmn:incoming><bpmn:outgoing>AP39_F7</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP39_T7" name="08 · Ghi nhận tiền sàn trả
về"><bpmn:documentation>Bước 8 · NV Kế toán. Khi sàn chuyển tiền về tài khoản (sau khi trừ phí sàn), Kế toán ghi nhận thanh toán và cấn trừ công nợ; đối chiếu chênh lệch tiền thực nhận vs doanh số bán.</bpmn:documentation><bpmn:incoming>AP39_F7</bpmn:incoming><bpmn:outgoing>AP39_F8</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP39_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP39_F8</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP39_F0" sourceRef="AP39_S" targetRef="AP39_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP39_F1" sourceRef="AP39_T0" targetRef="AP39_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP39_F2" sourceRef="AP39_T1" targetRef="AP39_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP39_F3" sourceRef="AP39_T2" targetRef="AP39_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP39_F4" sourceRef="AP39_T3" targetRef="AP39_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP39_F5" sourceRef="AP39_T4" targetRef="AP39_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP39_F6" sourceRef="AP39_T5" targetRef="AP39_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP39_F7" sourceRef="AP39_T6" targetRef="AP39_T7"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP39_F8" sourceRef="AP39_T7" targetRef="AP39_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP39_diagram"><bpmndi:BPMNPlane id="AP39_plane" bpmnElement="AP39_collab"><bpmndi:BPMNShape id="AP39_pool_di" bpmnElement="AP39_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="2166" height="528"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP39_lane_0_di" bpmnElement="AP39_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP39_lane_1_di" bpmnElement="AP39_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP39_lane_2_di" bpmnElement="AP39_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP39_S_di" bpmnElement="AP39_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP39_T0_di" bpmnElement="AP39_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP39_T1_di" bpmnElement="AP39_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP39_T2_di" bpmnElement="AP39_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP39_T3_di" bpmnElement="AP39_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP39_T4_di" bpmnElement="AP39_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP39_T5_di" bpmnElement="AP39_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP39_T6_di" bpmnElement="AP39_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP39_T7_di" bpmnElement="AP39_T7" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1830" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP39_E_di" bpmnElement="AP39_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="2040" y="512" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1996" y="557" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP39_F0_di" bpmnElement="AP39_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP39_F1_di" bpmnElement="AP39_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="570" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP39_F2_di" bpmnElement="AP39_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="178"/><di:waypoint x="780" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP39_F3_di" bpmnElement="AP39_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="178"/><di:waypoint x="990" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP39_F4_di" bpmnElement="AP39_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="178"/><di:waypoint x="1170" y="178"/><di:waypoint x="1170" y="354"/><di:waypoint x="1200" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP39_F5_di" bpmnElement="AP39_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="354"/><di:waypoint x="1380" y="354"/><di:waypoint x="1380" y="530"/><di:waypoint x="1410" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP39_F6_di" bpmnElement="AP39_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="530"/><di:waypoint x="1620" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP39_F7_di" bpmnElement="AP39_F7" bioc:stroke="#7e90aa"><di:waypoint x="1780" y="530"/><di:waypoint x="1830" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP39_F8_di" bpmnElement="AP39_F8" bioc:stroke="#7e90aa"><di:waypoint x="1990" y="530"/><di:waypoint x="2040" y="530"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>