<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP38_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP38_collab"><bpmn:participant id="AP38_pool" name="Bán hàng thông thường" processRef="AP38"/></bpmn:collaboration><bpmn:process id="AP38" name="Bán hàng thông thường" isExecutable="false"><bpmn:laneSet id="AP38_lanes"><bpmn:lane id="AP38_lane_0" name="Phòng Kinh doanh"><bpmn:flowNodeRef>AP38_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP38_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP38_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP38_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP38_T3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP38_lane_1" name="Phòng Kế toán"><bpmn:flowNodeRef>AP38_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP38_T8</bpmn:flowNodeRef><bpmn:flowNodeRef>AP38_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP38_lane_2" name="Bộ phận Giao vận"><bpmn:flowNodeRef>AP38_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP38_T7</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP38_lane_3" name="Bộ phận Kho"><bpmn:flowNodeRef>AP38_T6</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP38_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP38_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP38_T0" name="01 · Kiểm tra hạn mức &amp; tồn
kho"><bpmn:documentation>Bước 1 · NV P. Kinh doanh. Kiểm tra: (1) Số dư công nợ &amp; hạn mức tín dụng KH; (2) Trả trước nếu KH yêu cầu - đợi tiền về; (3) Tồn kho thành phẩm tại kho xuất. Nếu thiếu tồn: đề nghị bộ phận Sản xuất lập kế hoạch.</bpmn:documentation><bpmn:incoming>AP38_F0</bpmn:incoming><bpmn:outgoing>AP38_F1</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="AP38_T1" name="02 · Lập Đơn bán hàng"><bpmn:documentation>Bước 2 · NV P. Kinh doanh. Lập Đơn bán hàng với Khách hàng, mặt hàng, số lượng, ngày giao. Đơn giá do hệ thống tự gợi ý từ Bảng giá bán và Chương trình khuyến mãi đang hiệu lực.</bpmn:documentation><bpmn:incoming>AP38_F1</bpmn:incoming><bpmn:outgoing>AP38_F2</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="AP38_T2" name="03 · Ghi chú yêu cầu đặc thù"><bpmn:documentation>Bước 3 · NV Kinh doanh. Ghi chú các yêu cầu riêng của Khách hàng: Lô hàng HSD trên 6 tháng, quy cách đóng gói 10 thùng / pallet, ưu tiên giờ giao, điều kiện bốc xếp...</bpmn:documentation><bpmn:incoming>AP38_F2</bpmn:incoming><bpmn:outgoing>AP38_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP38_T3" name="04 · Gửi phê duyệt Đơn bán
hàng"><bpmn:documentation>Bước 4 · NV P. Kinh doanh. Gửi Đơn bán hàng đi phê duyệt; đơn chuyển sang Kế toán kiểm tra hạn mức tín dụng trước khi cho phép xuất kho.</bpmn:documentation><bpmn:incoming>AP38_F3</bpmn:incoming><bpmn:outgoing>AP38_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP38_T4" name="05 · Phê duyệt / Từ chối đơn"><bpmn:documentation>Bước 5 · NV Kế toán. Kế toán kiểm tra tổng tiền đơn + công nợ vs hạn mức tín dụng. Đạt: duyệt - đơn tự chuyển trạng thái Đã duyệt sẵn sàng giao hàng. Vượt hạn mức: từ chối, yêu cầu KH thanh toán nợ trước khi xét lại.</bpmn:documentation><bpmn:incoming>AP38_F4</bpmn:incoming><bpmn:outgoing>AP38_F5</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="AP38_T5" name="06 · Yêu cầu vận chuyển tự
sinh"><bpmn:documentation>Bước 6 · NV Logistic. Khi Đơn bán hàng được duyệt, đối với Khách hàng có phương thức giao yêu cầu vận chuyển, hệ thống tự sinh Yêu cầu vận chuyển trên kế hoạch giao vận để sắp xếp xe, tài xế (chi tiết tại quy trình TR-01).</bpmn:documentation><bpmn:incoming>AP38_F5</bpmn:incoming><bpmn:outgoing>AP38_F6</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="AP38_T6" name="07 · Xuất kho"><bpmn:documentation>Bước 7 · NV Kho. Kho tạo Phiếu xuất kho cho đơn đã duyệt; gán Lô hàng xuất theo nguyên tắc hết hạn trước - xuất trước (FEFO); ghi sổ phiếu xuất kho.</bpmn:documentation><bpmn:incoming>AP38_F6</bpmn:incoming><bpmn:outgoing>AP38_F7</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP38_T7" name="08 · Giao hàng"><bpmn:documentation>Bước 8 · NV Logistic. Logistic nhận hàng từ Kho theo Phiếu xuất kho; sắp xếp lịch giao và phương tiện vận chuyển; giao hàng đến Khách hàng và xác nhận đã giao.</bpmn:documentation><bpmn:incoming>AP38_F7</bpmn:incoming><bpmn:outgoing>AP38_F8</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP38_T8" name="09 · Phát hành Hóa đơn bán
hàng"><bpmn:documentation>Bước 9 · NV Kế toán. Sau khi giao hàng, Kế toán lập Hóa đơn bán hàng căn cứ theo Phiếu xuất kho đã post; phát hành hóa đơn điện tử qua VNPT để gửi Khách hàng.</bpmn:documentation><bpmn:incoming>AP38_F8</bpmn:incoming><bpmn:outgoing>AP38_F9</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP38_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP38_F9</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP38_F0" sourceRef="AP38_S" targetRef="AP38_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP38_F1" sourceRef="AP38_T0" targetRef="AP38_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP38_F2" sourceRef="AP38_T1" targetRef="AP38_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP38_F3" sourceRef="AP38_T2" targetRef="AP38_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP38_F4" sourceRef="AP38_T3" targetRef="AP38_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP38_F5" sourceRef="AP38_T4" targetRef="AP38_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP38_F6" sourceRef="AP38_T5" targetRef="AP38_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP38_F7" sourceRef="AP38_T6" targetRef="AP38_T7"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP38_F8" sourceRef="AP38_T7" targetRef="AP38_T8"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP38_F9" sourceRef="AP38_T8" targetRef="AP38_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP38_diagram"><bpmndi:BPMNPlane id="AP38_plane" bpmnElement="AP38_collab"><bpmndi:BPMNShape id="AP38_pool_di" bpmnElement="AP38_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="2376" height="704"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP38_lane_0_di" bpmnElement="AP38_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="2346" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP38_lane_1_di" bpmnElement="AP38_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="2346" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP38_lane_2_di" bpmnElement="AP38_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="2346" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP38_lane_3_di" bpmnElement="AP38_lane_3" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="618" width="2346" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP38_S_di" bpmnElement="AP38_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP38_T0_di" bpmnElement="AP38_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP38_T1_di" bpmnElement="AP38_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP38_T2_di" bpmnElement="AP38_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP38_T3_di" bpmnElement="AP38_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP38_T4_di" bpmnElement="AP38_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP38_T5_di" bpmnElement="AP38_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP38_T6_di" bpmnElement="AP38_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="658" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP38_T7_di" bpmnElement="AP38_T7" bioc:fill="#eef4ff" bioc:stroke="#5c81c