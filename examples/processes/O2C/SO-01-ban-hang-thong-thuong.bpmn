pmndi:BPMNEdge id="AP38_F8_di" bpmnElement="AP38_F8" bioc:stroke="#7e90aa"><di:waypoint x="1990" y="530"/><di:waypoint x="2010" y="530"/><di:waypoint x="2010" y="354"/><di:waypoint x="2040" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP38_F9_di" bpmnElement="AP38_F9" bioc:stroke="#7e90aa"><di:waypoint x="2200" y="354"/><di:waypoint x="2250" y="354"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>