<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP33_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP33_collab"><bpmn:participant id="AP33_pool" name="Quản lý thông tin Khách hàng" processRef="AP33"/></bpmn:collaboration><bpmn:process id="AP33" name="Quản lý thông tin Khách hàng" isExecutable="false"><bpmn:laneSet id="AP33_lanes"><bpmn:lane id="AP33_lane_0" name="Bộ phận yêu cầu"><bpmn:flowNodeRef>AP33_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP33_T0</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP33_lane_1" name="Phòng Kinh doanh"><bpmn:flowNodeRef>AP33_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP33_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP33_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP33_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP33_T6</bpmn:flowNodeRef><bpmn:flowNodeRef>AP33_T8</bpmn:flowNodeRef><bpmn:flowNodeRef>AP33_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP33_lane_2" name="Bộ phận CNTT"><bpmn:flowNodeRef>AP33_T3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP33_lane_3" name="Phòng Kế toán"><bpmn:flowNodeRef>AP33_T7</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP33_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP33_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP33_T0" name="01 · Phát sinh nhu cầu giao
dịch với Khách hàng mới"><bpmn:documentation>Bước 1 · Các phòng ban. Phòng Kinh doanh, Cửa hàng hoặc Phòng XNK phát sinh giao dịch với Khách hàng chưa có trong danh sách; đề nghị tạo Khách hàng mới.</bpmn:documentation><bpmn:incoming>AP33_F0</bpmn:incoming><bpmn:outgoing>AP33_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP33_T1" name="02 · Thu thập thông tin
Khách hàng"><bpmn:documentation>Bước 2 · P. Kinh doanh / Cửa hàng. Thu thập hồ sơ pháp lý: tên pháp nhân, Mã số thuế, địa chỉ trụ sở, địa chỉ giao hàng, thông tin liên hệ, điều khoản thanh toán dự kiến.</bpmn:documentation><bpmn:incoming>AP33_F1</bpmn:incoming><bpmn:outgoing>AP33_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP33_T2" name="03 · Kiểm tra Khách hàng đã
có"><bpmn:documentation>Bước 3 · P. Kinh doanh / Cửa hàng. Rà soát danh mục Khách hàng đã có trên hệ thống để tránh trùng lặp. Nếu đã có, chuyển sang cập nhật thông tin.</bpmn:documentation><bpmn:incoming>AP33_F2</bpmn:incoming><bpmn:outgoing>AP33_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP33_T3" name="04 · Thiết lập mẫu Khách
hàng"><bpmn:documentation>Bước 4 · NV P. CNTT. Dựng sẵn các mẫu Khách hàng theo nhóm (NPP, TMĐT, Showroom, Xuất khẩu) với thiết lập chuẩn. Mẫu mới tạo ra mặc định ở trạng thái khóa để đảm bảo kiểm soát.</bpmn:documentation><bpmn:incoming>AP33_F3</bpmn:incoming><bpmn:outgoing>AP33_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP33_T4" name="05 · Tạo Khách hàng mới trên
hệ thống"><bpmn:documentation>Bước 5 · P. Kinh doanh / Cửa hàng. Tạo Khách hàng theo mẫu phù hợp; điền tên, địa chỉ, điều khoản thanh toán, phương thức giao hàng, hạn mức tín dụng dự kiến.</bpmn:documentation><bpmn:incoming>AP33_F4</bpmn:incoming><bpmn:outgoing>AP33_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP33_T5" name="06 · Khai báo Địa chỉ giao
hàng &amp; Thuộc tính"><bpmn:documentation>Bước 6 · P. Kinh doanh / Cửa hàng. Khai báo danh sách địa chỉ giao hàng (nhiều điểm giao cho cùng Khách hàng); gán thuộc tính mở rộng: Kênh bán hàng, Vùng miền phục vụ phân tích và báo giá.</bpmn:documentation><bpmn:incoming>AP33_F5</bpmn:incoming><bpmn:outgoing>AP33_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP33_T6" name="07 · Gửi phê duyệt Khách
hàng"><bpmn:documentation>Bước 7 · P. Kinh doanh / Cửa hàng. Gửi yêu cầu phê duyệt; thông tin Khách hàng chuyển sang Phòng Kế toán để kiểm tra hạch toán trước khi được phép giao dịch.</bpmn:documentation><bpmn:incoming>AP33_F6</bpmn:incoming><bpmn:outgoing>AP33_F7</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP33_T7" name="08 · Kiểm tra hạch toán &amp;
duyệt"><bpmn:documentation>Bước 8 · NV Kế toán. Kiểm tra nhóm hạch toán kế toán, nhóm thuế, hạn mức tín dụng phù hợp với chính sách công ty; phê duyệt nếu hợp lệ.</bpmn:documentation><bpmn:incoming>AP33_F7</bpmn:incoming><bpmn:outgoing>AP33_F8</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP33_T8" name="09 · Khóa Khách hàng khi cần"><bpmn:documentation>Bước 9 · P. Kinh doanh / Cửa hàng. Khi Khách hàng dừng hợp tác hoặc vi phạm điều khoản, khóa Khách hàng để chặn phát sinh đơn hàng mới.</bpmn:documentation><bpmn:incoming>AP33_F8</bpmn:incoming><bpmn:outgoing>AP33_F9</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP33_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP33_F9</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP33_F0" sourceRef="AP33_S" targetRef="AP33_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP33_F1" sourceRef="AP33_T0" targetRef="AP33_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP33_F2" sourceRef="AP33_T1" targetRef="AP33_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP33_F3" sourceRef="AP33_T2" targetRef="AP33_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP33_F4" sourceRef="AP33_T3" targetRef="AP33_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP33_F5" sourceRef="AP33_T4" targetRef="AP33_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP33_F6" sourceRef="AP33_T5" targetRef="AP33_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP33_F7" sourceRef="AP33_T6" targetRef="AP33_T7"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP33_F8" sourceRef="AP33_T7" targetRef="AP33_T8"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP33_F9" sourceRef="AP33_T8" targetRef="AP33_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP33_diagram"><bpmndi:BPMNPlane id="AP33_plane" bpmnElement="AP33_collab"><bpmndi:BPMNShape id="AP33_pool_di" bpmnElement="AP33_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="2376" height="704"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP33_lane_0_di" bpmnElement="AP33_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="2346" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP33_lane_1_di" bpmnElement="AP33_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="2346" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP33_lane_2_di" bpmnElement="AP33_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="2346" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP33_lane_3_di" bpmnElement="AP33_lane_3" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="618" width="2346" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP33_S_di" bpmnElement="AP33_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP33_T0_di" bpmnElement="AP33_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP33_T1_di" bpmnElement="AP33_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP33_T2_di" bpmnElement="AP33_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP33_T3_di" bpmnElement="AP33_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP33_T4_di" bpmnElement="AP33_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP33_T5_di" bpmnElement="AP33_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP33_T6_di" bpmnElement="AP33_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP33_T7_di" bpmnElement="AP33_T7" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1830" y="658" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP33_T8_di" bpmnElement="AP33_T8" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="2040" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP33_E_di" bpmnElement="AP33_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="2250" y="336" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="2206" y="381" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP33_F0_di" bpmnElement="AP33_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP33_F1_di" bpmnElement="AP33_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="540" y="178"/><di:waypoint x="540" y="354"/><di:waypoint x="570" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP33_F2_di" bpmnElement="AP33_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="354"/><di:waypoint x="780" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP33_F3_di" bpmnElement="AP33_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="354"/><di:waypoint x="960" y="354"/><di:waypoint x="960" y="530"/><di:waypoint x="990" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP33_F4_di" bpmnElement="AP33_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="530"/><di:waypoint x="1170" y="530"/><di:waypoint x="1170" y="354"/><di:waypoint x="1200" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP33_F5_di" bpmnElement="AP33_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="354"/><di:waypoint x="1410" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP33_F6_di" bpmnElement="AP33_F6" bioc:stroke="#7e9