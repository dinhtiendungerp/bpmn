<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP42_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP42_collab"><bpmn:participant id="AP42_pool" name="Bán hàng nội bộ" processRef="AP42"/></bpmn:collaboration><bpmn:process id="AP42" name="Bán hàng nội bộ" isExecutable="false"><bpmn:laneSet id="AP42_lanes"><bpmn:lane id="AP42_lane_0" name="Tổng cty/Nội bộ tập đoàn"><bpmn:flowNodeRef>AP42_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP42_T0</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP42_lane_1" name="Phòng Kinh doanh"><bpmn:flowNodeRef>AP42_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP42_T2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP42_lane_2" name="Bộ phận Kho"><bpmn:flowNodeRef>AP42_T3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP42_lane_3" name="Bộ phận Giao vận"><bpmn:flowNodeRef>AP42_T4</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP42_lane_4" name="Phòng Kế toán"><bpmn:flowNodeRef>AP42_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP42_E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP42_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP42_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP42_T0" name="01 · Tổng hợp &amp; gửi Yêu cầu
giao hàng cho"><bpmn:documentation>Bước 1 · Tổng cty/Nội bộ tập đoàn. Tổng công ty/Công ty nội bộ tập đoàn tổng hợp các yêu cầu xuất hàng - liên quan đến - rồi gửi Bảng tổng hợp đơn hoặc Yêu cầu mua hàng tới.</bpmn:documentation><bpmn:incoming>AP42_F0</bpmn:incoming><bpmn:outgoing>AP42_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP42_T1" name="02 · Tổng hợp số lượng theo
từng NPP"><bpmn:documentation>Bước 2 · P. Kinh doanh. Phòng Kinh doanh tiếp nhận yêu cầu, tổng hợp số lượng theo từng NPP trực thuộc Tổng công ty - làm cơ sở lập đơn cho các NPP.</bpmn:documentation><bpmn:incoming>AP42_F1</bpmn:incoming><bpmn:outgoing>AP42_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP42_T2" name="03 · Tạo Đơn bán hàng cho
Tổng công ty"><bpmn:documentation>Bước 3 · P. Kinh doanh. Lên Đơn bán hàng cho Tổng công ty trên hệ thống, mỗi NPP là một địa chỉ giao hàng. Áp dụng giá bán nội bộ giữa công ty mẹ - công ty con.</bpmn:documentation><bpmn:incoming>AP42_F2</bpmn:incoming><bpmn:outgoing>AP42_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP42_T3" name="04 · Kiểm tồn kho &amp; lên kế
hoạch xuất"><bpmn:documentation>Bước 4 · P. Kho vận và Sản xuất. Bộ phận Kho kiểm tra tồn kho thành phẩm tại nhà máy. Đủ tồn → lên kế hoạch xuất kho từ kho tổng. Không đủ → chạy quy trình lập kế hoạch &amp; sản xuất MPS để bổ sung hàng đáp ứng yêu cầu.</bpmn:documentation><bpmn:incoming>AP42_F3</bpmn:incoming><bpmn:outgoing>AP42_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP42_T4" name="05 · Giao hàng tới NPP của
Tổng cty"><bpmn:documentation>Bước 5 · Công ty vận chuyển. thuê Công ty vận chuyển chuyển hàng đến các NPP/đại lý trực thuộc Tổng công ty. Quản lý qua Lệnh vận chuyển trong hệ thống.</bpmn:documentation><bpmn:incoming>AP42_F4</bpmn:incoming><bpmn:outgoing>AP42_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP42_T5" name="06 · Xuất Hóa đơn Tổng cuối
ngày"><bpmn:documentation>Bước 6 · P. Kế toán. Cuối ngày, Kế toán tổng hợp các đơn bán hàng nội bộ phát sinh trong ngày, lập Hóa đơn bán hàng cho Tổng công ty/Công ty nội bộ tập đoàn.</bpmn:documentation><bpmn:incoming>AP42_F5</bpmn:incoming><bpmn:outgoing>AP42_F6</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP42_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP42_F6</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP42_F0" sourceRef="AP42_S" targetRef="AP42_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP42_F1" sourceRef="AP42_T0" targetRef="AP42_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP42_F2" sourceRef="AP42_T1" targetRef="AP42_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP42_F3" sourceRef="AP42_T2" targetRef="AP42_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP42_F4" sourceRef="AP42_T3" targetRef="AP42_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP42_F5" sourceRef="AP42_T4" targetRef="AP42_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP42_F6" sourceRef="AP42_T5" targetRef="AP42_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP42_diagram"><bpmndi:BPMNPlane id="AP42_plane" bpmnElement="AP42_collab"><bpmndi:BPMNShape id="AP42_pool_di" bpmnElement="AP42_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1746" height="880"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP42_lane_0_di" bpmnElement="AP42_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1716" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP42_lane_1_di" bpmnElement="AP42_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1716" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP42_lane_2_di" bpmnElement="AP42_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="1716" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP42_lane_3_di" bpmnElement="AP42_lane_3" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="618" width="1716" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP42_lane_4_di" bpmnElement="AP42_lane_4" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="794" width="1716" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP42_S_di" bpmnElement="AP42_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP42_T0_di" bpmnElement="AP42_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP42_T1_di" bpmnElement="AP42_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP42_T2_di" bpmnElement="AP42_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP42_T3_di" bpmnElement="AP42_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP42_T4_di" bpmnElement="AP42_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="658" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP42_T5_di" bpmnElement="AP42_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="834" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP42_E_di" bpmnElement="AP42_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1620" y="864" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1576" y="909" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP42_F0_di" bpmnElement="AP42_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP42_F1_di" bpmnElement="AP42_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="540" y="178"/><di:waypoint x="540" y="354"/><di:waypoint x="570" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP42_F2_di" bpmnElement="AP42_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="354"/><di:waypoint x="780" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP42_F3_di" bpmnElement="AP42_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="354"/><di:waypoint x="960" y="354"/><di:waypoint x="960" y="530"/><di:waypoint x="990" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP42_F4_di" bpmnElement="AP42_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="530"/><di:waypoint x="1170" y="530"/><di:waypoint x="1170" y="706"/><di:waypoint x="1200" y="706"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP42_F5_di" bpmnElement="AP42_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="706"/><di:waypoint x="1380" y="706"/><di:waypoint x="1380" y="882"/><di:waypoint x="1410" y="882"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP42_F6_di" bpmnElement="AP42_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="882"/><di:waypoint x="1620" y="882"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>