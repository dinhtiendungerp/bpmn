<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP45_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP45_collab"><bpmn:participant id="AP45_pool" name="Xuất hàng và giao vận" processRef="AP45"/></bpmn:collaboration><bpmn:process id="AP45" name="Xuất hàng và giao vận" isExecutable="false"><bpmn:laneSet id="AP45_lanes"><bpmn:lane id="AP45_lane_0" name="Bộ phận Giao vận"><bpmn:flowNodeRef>AP45_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP45_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP45_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP45_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP45_T4</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP45_lane_1" name="Hệ thống"><bpmn:flowNodeRef>AP45_T1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP45_lane_2" name="Phòng Kế toán"><bpmn:flowNodeRef>AP45_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP45_T7</bpmn:flowNodeRef><bpmn:flowNodeRef>AP45_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP45_lane_3" name="Bộ phận Kho"><bpmn:flowNodeRef>AP45_T6</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP45_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP45_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP45_T0" name="01 · Thiết lập Master Data"><bpmn:documentation>Bước 1 · NV Logistic. Khai báo danh mục tuyến vận chuyển, xe tải - rơ moóc, tài xế, cầu bốc xếp (dock), loại đơn vị chứa hàng (pallet, carton). Đây là dữ liệu nền cho mọi giao vận.</bpmn:documentation><bpmn:incoming>AP45_F0</bpmn:incoming><bpmn:outgoing>AP45_F1</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="AP45_T1" name="02 · Yêu cầu vận chuyển tự
sinh"><bpmn:documentation>Bước 2 · Hệ thống. Khi Đơn bán hàng hoặc Đơn chuyển kho được duyệt với phương thức giao hàng cần vận chuyển, hệ thống tự sinh Yêu cầu vận chuyển trên bảng kế hoạch - không cần thao tác tay.</bpmn:documentation><bpmn:incoming>AP45_F1</bpmn:incoming><bpmn:outgoing>AP45_F2</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="AP45_T2" name="03 · Lập kế hoạch vận chuyển"><bpmn:documentation>Bước 3 · NV Logistic. Trên kế hoạch, gom các yêu cầu vận chuyển cùng tuyến hoặc cùng khu vực để tối ưu xe; điều chỉnh chuyến, tách đơn khi cần.</bpmn:documentation><bpmn:incoming>AP45_F2</bpmn:incoming><bpmn:outgoing>AP45_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP45_T3" name="04 · Tạo Lệnh vận chuyển"><bpmn:documentation>Bước 4 · NV Logistic. Tạo Lệnh vận chuyển cho từng chuyến xe; có thể gộp nhiều yêu cầu chung tuyến vào một lệnh để tối ưu chi phí.</bpmn:documentation><bpmn:incoming>AP45_F3</bpmn:incoming><bpmn:outgoing>AP45_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP45_T4" name="05 · Gán Tài xế, Xe, Dock"><bpmn:documentation>Bước 5 · NV Logistic. Gán cụ thể tài xế, xe tải, rơ moóc, cầu bốc xếp cho Lệnh vận chuyển; theo dõi trạng thái dock (đã đến, đang bốc, đã xuất phát).</bpmn:documentation><bpmn:incoming>AP45_F4</bpmn:incoming><bpmn:outgoing>AP45_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP45_T5" name="06 · Tính chi phí vận chuyển"><bpmn:documentation>Bước 6 · NV Logistic / KT. Tính chi phí vận chuyển theo tuyến: thủ công theo thỏa thuận hoặc tự động theo bảng cước (diện tích sàn, trọng lượng, gộp chuyến). Chi phí được phân bổ về các đơn hàng đi cùng chuyến.</bpmn:documentation><bpmn:incoming>AP45_F5</bpmn:incoming><bpmn:outgoing>AP45_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP45_T6" name="07 · Xuất kho theo Lệnh vận
chuyển"><bpmn:documentation>Bước 7 · NV Kho. Kho tạo Phiếu xuất kho theo Lệnh vận chuyển; gán vị trí, Lô; ghi sổ xuất kho. Có thể xuất gộp nhiều Đơn bán hàng cùng tuyến.</bpmn:documentation><bpmn:incoming>AP45_F6</bpmn:incoming><bpmn:outgoing>AP45_F7</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="AP45_T7" name="08 · Post Lệnh &amp; sinh đơn
mua cước"><bpmn:documentation>Bước 8 · NV Logistic / KT. Sau khi hoàn thành chuyến, ghi sổ Lệnh vận chuyển; nếu Nhà cung cấp vận tải có liên kết, hệ thống tự sinh Đơn mua hàng ghi nhận chi phí cước phải trả.</bpmn:documentation><bpmn:incoming>AP45_F7</bpmn:incoming><bpmn:outgoing>AP45_F8</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="AP45_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP45_F8</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP45_F0" sourceRef="AP45_S" targetRef="AP45_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP45_F1" sourceRef="AP45_T0" targetRef="AP45_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP45_F2" sourceRef="AP45_T1" targetRef="AP45_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP45_F3" sourceRef="AP45_T2" targetRef="AP45_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP45_F4" sourceRef="AP45_T3" targetRef="AP45_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP45_F5" sourceRef="AP45_T4" targetRef="AP45_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP45_F6" sourceRef="AP45_T5" targetRef="AP45_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP45_F7" sourceRef="AP45_T6" targetRef="AP45_T7"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP45_F8" sourceRef="AP45_T7" targetRef="AP45_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP45_diagram"><bpmndi:BPMNPlane id="AP45_plane" bpmnElement="AP45_collab"><bpmndi:BPMNShape id="AP45_pool_di" bpmnElement="AP45_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="2166" height="704"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP45_lane_0_di" bpmnElement="AP45_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP45_lane_1_di" bpmnElement="AP45_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP45_lane_2_di" bpmnElement="AP45_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP45_lane_3_di" bpmnElement="AP45_lane_3" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="618" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP45_S_di" bpmnElement="AP45_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP45_T0_di" bpmnElement="AP45_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP45_T1_di" bpmnElement="AP45_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP45_T2_di" bpmnElement="AP45_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP45_T3_di" bpmnElement="AP45_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP45_T4_di" bpmnElement="AP45_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP45_T5_di" bpmnElement="AP45_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP45_T6_di" bpmnElement="AP45_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="658" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP45_T7_di" bpmnElement="AP45_T7" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1830" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP45_E_di" bpmnElement="AP45_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="2040" y="512" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1996" y="557" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP45_F0_di" bpmnElement="AP45_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP45_F1_di" bpmnElement="AP45_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="540" y="178"/><di:waypoint x="540" y="354"/><di:waypoint x="570" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP45_F2_di" bpmnElement="AP45_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="354"/><di:waypoint x="750" y="354"/><di:waypoint x="750" y="178"/><di:waypoint x="780" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP45_F3_di" bpmnElement="AP45_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="178"/><di:waypoint x="990" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP45_F4_di" bpmnElement="AP45_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="178"/><di:waypoint x="1200" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP45_F5_di" bpmnElement="AP45_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="178"/><di:waypoint x="1380" y="178"/><di:waypoint x="1380" y="530"/><di:waypoint x="1410" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP45_F6_di" bpmnElement="AP45_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="530"/><di:waypoint x="1590" y="530"/><di:waypoint x="1590" y="706"/><di:waypoint x="1620" y="706"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP45_F7_di" bpmnElement="AP45_F7" bioc:stroke="#7e90aa"><di:waypoint x="1780" y="706"/><di:waypoint x="1800" y="706"/><di:waypoint x="1800" y="530"/><di:waypoint x="1830" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP45_F8_di" bpmnElement="AP45_F8" bioc:stroke="#7e90aa"><di:waypoint x="1990" y="530"/><di:waypoint x="2040" y="530"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>