<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP35_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP35_collab"><bpmn:participant id="AP35_pool" name="Quản lý Kế hoạch bán hàng" processRef="AP35"/></bpmn:collaboration><bpmn:process id="AP35" name="Quản lý Kế hoạch bán hàng" isExecutable="false"><bpmn:laneSet id="AP35_lanes"><bpmn:lane id="AP35_lane_0" name="Phòng Kinh doanh"><bpmn:flowNodeRef>AP35_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP35_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP35_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP35_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP35_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP35_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP35_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP35_lane_1" name="BLĐ KD"><bpmn:flowNodeRef>AP35_T4</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP35_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP35_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP35_T0" name="01 · Rà soát doanh thu kỳ
trước"><bpmn:documentation>Bước 1 · NV P. Kinh doanh. Xem báo cáo doanh thu theo mặt hàng, Khách hàng, kỳ để đánh giá kết quả thực tế làm căn cứ lập kế hoạch kỳ tiếp theo.</bpmn:documentation><bpmn:incoming>AP35_F0</bpmn:incoming><bpmn:outgoing>AP35_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP35_T1" name="02 · Phân tích tồn kho tại
NPP"><bpmn:documentation>Bước 2 · NV P. Kinh doanh. Phân tích tồn kho tại từng kho ký gửi NPP, kho showroom để xác định SKU nào cần đẩy bán, SKU nào cần hạn chế nhập thêm.</bpmn:documentation><bpmn:incoming>AP35_F1</bpmn:incoming><bpmn:outgoing>AP35_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP35_T2" name="03 · Phân tích HSD theo Lô"><bpmn:documentation>Bước 3 · NV P. Kinh doanh. Rà soát các Lô hàng sắp hết hạn tại từng NPP để xây dựng chính sách ưu tiên bán sớm, tránh hàng cận date.</bpmn:documentation><bpmn:incoming>AP35_F2</bpmn:incoming><bpmn:outgoing>AP35_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP35_T3" name="04 · Lập Kế hoạch bán hàng"><bpmn:documentation>Bước 4 · P. Kinh doanh. Lập Kế hoạch bán hàng theo SKU cho từng kỳ: số lượng dự kiến, đơn giá, thành tiền. Phục vụ theo dõi tiến độ thực hiện và điều phối sản xuất.</bpmn:documentation><bpmn:incoming>AP35_F3</bpmn:incoming><bpmn:outgoing>AP35_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP35_T4" name="05 · Phê duyệt kế hoạch"><bpmn:documentation>Bước 5 · BLĐ KD. Ban Lãnh đạo Kinh doanh xem xét và phê duyệt Kế hoạch bán hàng; kế hoạch đã duyệt là căn cứ để so sánh với thực tế.</bpmn:documentation><bpmn:incoming>AP35_F4</bpmn:incoming><bpmn:outgoing>AP35_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP35_T5" name="06 · Theo dõi thực hiện vs
kế hoạch"><bpmn:documentation>Bước 6 · NV P. Kinh doanh. Định kỳ so sánh doanh thu thực tế đã phát hành hóa đơn với kế hoạch theo từng SKU, kỳ; báo cáo BLĐ để điều chỉnh chính sách khi lệch.</bpmn:documentation><bpmn:incoming>AP35_F5</bpmn:incoming><bpmn:outgoing>AP35_F6</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP35_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP35_F6</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP35_F0" sourceRef="AP35_S" targetRef="AP35_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP35_F1" sourceRef="AP35_T0" targetRef="AP35_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP35_F2" sourceRef="AP35_T1" targetRef="AP35_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP35_F3" sourceRef="AP35_T2" targetRef="AP35_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP35_F4" sourceRef="AP35_T3" targetRef="AP35_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP35_F5" sourceRef="AP35_T4" targetRef="AP35_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP35_F6" sourceRef="AP35_T5" targetRef="AP35_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP35_diagram"><bpmndi:BPMNPlane id="AP35_plane" bpmnElement="AP35_collab"><bpmndi:BPMNShape id="AP35_pool_di" bpmnElement="AP35_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1746" height="352"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP35_lane_0_di" bpmnElement="AP35_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1716" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP35_lane_1_di" bpmnElement="AP35_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1716" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP35_S_di" bpmnElement="AP35_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP35_T0_di" bpmnElement="AP35_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP35_T1_di" bpmnElement="AP35_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP35_T2_di" bpmnElement="AP35_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP35_T3_di" bpmnElement="AP35_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP35_T4_di" bpmnElement="AP35_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP35_T5_di" bpmnElement="AP35_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP35_E_di" bpmnElement="AP35_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1620" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1576" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP35_F0_di" bpmnElement="AP35_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP35_F1_di" bpmnElement="AP35_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="570" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP35_F2_di" bpmnElement="AP35_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="178"/><di:waypoint x="780" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP35_F3_di" bpmnElement="AP35_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="178"/><di:waypoint x="990" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP35_F4_di" bpmnElement="AP35_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="178"/><di:waypoint x="1170" y="178"/><di:waypoint x="1170" y="354"/><di:waypoint x="1200" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP35_F5_di" bpmnElement="AP35_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="354"/><di:waypoint x="1380" y="354"/><di:waypoint x="1380" y="178"/><di:waypoint x="1410" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP35_F6_di" bpmnElement="AP35_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="178"/><di:waypoint x="1620" y="178"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>