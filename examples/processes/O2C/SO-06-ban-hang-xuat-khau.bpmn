<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP43_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP43_collab"><bpmn:participant id="AP43_pool" name="Bán hàng xuất khẩu" processRef="AP43"/></bpmn:collaboration><bpmn:process id="AP43" name="Bán hàng xuất khẩu" isExecutable="false"><bpmn:laneSet id="AP43_lanes"><bpmn:lane id="AP43_lane_0" name="KD XNK"><bpmn:flowNodeRef>AP43_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP43_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP43_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP43_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP43_T4</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP43_lane_1" name="Phòng Kế toán"><bpmn:flowNodeRef>AP43_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP43_T7</bpmn:flowNodeRef><bpmn:flowNodeRef>AP43_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP43_lane_2" name="Bộ phận Kho"><bpmn:flowNodeRef>AP43_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP43_T6</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP43_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP43_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP43_T0" name="01 · Lập Đơn bán xuất khẩu"><bpmn:documentation>Bước 1 · NV KD XNK. Lập Đơn bán hàng với Khách hàng nước ngoài; khai báo mã tiền tệ (USD, EUR), phương thức giao hàng quốc tế (CIF, FOB, DDP), đơn giá ngoại tệ, số lượng.</bpmn:documentation><bpmn:incoming>AP43_F0</bpmn:incoming><bpmn:outgoing>AP43_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP43_T1" name="02 · Gửi phê duyệt đơn"><bpmn:documentation>Bước 2 · NV KD XNK. Gửi Đơn bán xuất khẩu đi phê duyệt; đơn chuyển sang Kế toán kiểm tra hạn mức tín dụng và chính sách tỷ giá.</bpmn:documentation><bpmn:incoming>AP43_F1</bpmn:incoming><bpmn:outgoing>AP43_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP43_T2" name="03 · Phê duyệt đơn XK"><bpmn:documentation>Bước 3 · NV Kế toán. Kiểm tra hạn mức tín dụng đặc biệt dành cho Khách hàng xuất khẩu; duyệt đơn nếu phù hợp chính sách.</bpmn:documentation><bpmn:incoming>AP43_F2</bpmn:incoming><bpmn:outgoing>AP43_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP43_T3" name="04 · Kiểm tra trả trước"><bpmn:documentation>Bước 4 · NV KD XNK. Kiểm tra trả trước (nếu KH yêu cầu): đợi tiền về tài khoản. Đồng thời kiểm tra tồn kho tại kho xuất đủ đáp ứng đơn XK; nếu thiếu, phối hợp Sản xuất lập kế hoạch sản xuất bổ sung.</bpmn:documentation><bpmn:incoming>AP43_F3</bpmn:incoming><bpmn:outgoing>AP43_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP43_T4" name="05 · Báo Khách hàng book tàu"><bpmn:documentation>Bước 5 · NV KD XNK. Sau khi đủ tồn kho và có lịch sản xuất rõ, xác nhận thời gian chuẩn bị hàng với kho XNK; thông báo KH book container/tàu. Nếu lịch SX thay đổi, báo lại KH điều chỉnh.</bpmn:documentation><bpmn:incoming>AP43_F4</bpmn:incoming><bpmn:outgoing>AP43_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP43_T5" name="06 · Điều chuyển về kho XNK"><bpmn:documentation>Bước 6 · NV KD XNK / Kho. Điều chuyển thành phẩm từ kho tổng về kho xuất nhập khẩu - nơi có đủ điều kiện lưu trữ chờ thông quan.</bpmn:documentation><bpmn:incoming>AP43_F5</bpmn:incoming><bpmn:outgoing>AP43_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP43_T6" name="07 · Thông quan &amp; xuất kho"><bpmn:documentation>Bước 7 · NV KD XNK / Kho. Sau khi hoàn tất thủ tục hải quan, kho xuất hàng lên phương tiện vận chuyển quốc tế; ghi sổ Phiếu xuất kho.</bpmn:documentation><bpmn:incoming>AP43_F6</bpmn:incoming><bpmn:outgoing>AP43_F7</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP43_T7" name="08 · Hóa đơn xuất khẩu"><bpmn:documentation>Bước 8 · NV Kế toán. Lập Hóa đơn bán hàng xuất khẩu căn cứ Phiếu xuất; kiểm tra ngoại tệ, tỷ giá, mã thuế xuất khẩu; phát hành hóa đơn điện tử xuất khẩu qua VNPT.</bpmn:documentation><bpmn:incoming>AP43_F7</bpmn:incoming><bpmn:outgoing>AP43_F8</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP43_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP43_F8</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP43_F0" sourceRef="AP43_S" targetRef="AP43_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP43_F1" sourceRef="AP43_T0" targetRef="AP43_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP43_F2" sourceRef="AP43_T1" targetRef="AP43_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP43_F3" sourceRef="AP43_T2" targetRef="AP43_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP43_F4" sourceRef="AP43_T3" targetRef="AP43_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP43_F5" sourceRef="AP43_T4" targetRef="AP43_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP43_F6" sourceRef="AP43_T5" targetRef="AP43_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP43_F7" sourceRef="AP43_T6" targetRef="AP43_T7"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP43_F8" sourceRef="AP43_T7" targetRef="AP43_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP43_diagram"><bpmndi:BPMNPlane id="AP43_plane" bpmnElement="AP43_collab"><bpmndi:BPMNShape id="AP43_pool_di" bpmnElement="AP43_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="2166" height="528"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP43_lane_0_di" bpmnElement="AP43_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP43_lane_1_di" bpmnElement="AP43_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP43_lane_2_di" bpmnElement="AP43_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP43_S_di" bpmnElement="AP43_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP43_T0_di" bpmnElement="AP43_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP43_T1_di" bpmnElement="AP43_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP43_T2_di" bpmnElement="AP43_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP43_T3_di" bpmnElement="AP43_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP43_T4_di" bpmnElement="AP43_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP43_T5_di" bpmnElement="AP43_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP43_T6_di" bpmnElement="AP43_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP43_T7_di" bpmnElement="AP43_T7" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1830" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP43_E_di" bpmnElement="AP43_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="2040" y="336" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1996" y="381" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP43_F0_di" bpmnElement="AP43_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP43_F1_di" bpmnElement="AP43_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="570" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP43_F2_di" bpmnElement="AP43_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="178"/><di:waypoint x="750" y="178"/><di:waypoint x="750" y="354"/><di:waypoint x="780" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP43_F3_di" bpmnElement="AP43_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="354"/><di:waypoint x="960" y="354"/><di:waypoint x="960" y="178"/><di:waypoint x="990" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP43_F4_di" bpmnElement="AP43_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="178"/><di:waypoint x="1200" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP43_F5_di" bpmnElement="AP43_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="178"/><di:waypoint x="1380" y="178"/><di:waypoint x="1380" y="530"/><di:waypoint x="1410" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP43_F6_di" bpmnElement="AP43_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="530"/><di:waypoint x="1620" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP43_F7_di" bpmnElement="AP43_F7" bioc:stroke="#7e90aa"><di:waypoint x="1780" y="530"/><di:waypoint x="1800" y="530"/><di:waypoint x="1800" y="354"/><di:waypoint x="1830" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP43_F8_di" bpmnElement="AP43_F8" bioc:stroke="#7e90aa"><di:waypoint x="1990" y="354"/><di:waypoint x="2040" y="354"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>