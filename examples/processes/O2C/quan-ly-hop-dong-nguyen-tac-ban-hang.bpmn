<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP37_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP37_collab"><bpmn:participant id="AP37_pool" name="Quản lý Hợp đồng nguyên tắc bán hàng" processRef="AP37"/></bpmn:collaboration><bpmn:process id="AP37" name="Quản lý Hợp đồng nguyên tắc bán hàng" isExecutable="false"><bpmn:laneSet id="AP37_lanes"><bpmn:lane id="AP37_lane_0" name="Phòng Kinh doanh"><bpmn:flowNodeRef>AP37_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP37_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP37_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP37_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP37_T6</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP37_lane_1" name="BLĐ / KH"><bpmn:flowNodeRef>AP37_T1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP37_lane_2" name="Trưởng BP KD"><bpmn:flowNodeRef>AP37_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP37_T7</bpmn:flowNodeRef><bpmn:flowNodeRef>AP37_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP37_lane_3" name="Khách hàng / KD"><bpmn:flowNodeRef>AP37_T4</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP37_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP37_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP37_T0" name="01 · Thương thảo hợp đồng
nguyên tắc"><bpmn:documentation>Bước 1 · P. Kinh doanh / KH. và Khách hàng (ví dụ NPP lớn, chuỗi siêu thị) thương thảo cam kết tổng sản lượng và đơn giá trong một kỳ hiệu lực (quý, năm) để đảm bảo ổn định nguồn cung - nguồn cầu.</bpmn:documentation><bpmn:incoming>AP37_F0</bpmn:incoming><bpmn:outgoing>AP37_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP37_T1" name="02 · Ký Hợp đồng nguyên tắc"><bpmn:documentation>Bước 2 · BLĐ / KH. Hai bên ký Hợp đồng nguyên tắc bán hàng với nội dung: tổng số lượng cam kết, đơn giá cố định hoặc công thức tính, kỳ hiệu lực, điều khoản giao hàng, thanh toán, thưởng phạt.</bpmn:documentation><bpmn:incoming>AP37_F1</bpmn:incoming><bpmn:outgoing>AP37_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP37_T2" name="03 · Ghi nhận Hợp đồng trên
hệ thống"><bpmn:documentation>Bước 3 · NV P. Kinh doanh. Ghi nhận Hợp đồng nguyên tắc đã ký lên hệ thống làm căn cứ quản lý: Khách hàng, danh mục mặt hàng, tổng số lượng cam kết, đơn giá. Đây là cam kết khung, chưa phát sinh xuất kho.</bpmn:documentation><bpmn:incoming>AP37_F2</bpmn:incoming><bpmn:outgoing>AP37_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP37_T3" name="04 · Phê duyệt Hợp đồng nội
bộ"><bpmn:documentation>Bước 4 · Trưởng BP KD. Trưởng BP Kinh doanh rà soát và phê duyệt Hợp đồng trên hệ thống để mở quyền tạo Đơn bán hàng đợt theo Hợp đồng.</bpmn:documentation><bpmn:incoming>AP37_F3</bpmn:incoming><bpmn:outgoing>AP37_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP37_T4" name="05 · Giao hàng từng đợt"><bpmn:documentation>Bước 5 · Khách hàng / KD. Khách hàng đặt hàng theo tiến độ thực tế (hàng tuần, hàng tháng). Mỗi đợt đặt là một lần rút từ tổng cam kết chung, không cần thương lượng giá lại.</bpmn:documentation><bpmn:incoming>AP37_F4</bpmn:incoming><bpmn:outgoing>AP37_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP37_T5" name="06 · Tạo Đơn bán hàng đợt từ
Hợp đồng"><bpmn:documentation>Bước 6 · NV P. Kinh doanh. Tạo Đơn bán hàng cho từng đợt giao; thông tin kế thừa từ Hợp đồng nguyên tắc (giá, điều khoản). Sau khi giao, số lượng cam kết còn lại của Hợp đồng tự động giảm.</bpmn:documentation><bpmn:incoming>AP37_F5</bpmn:incoming><bpmn:outgoing>AP37_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP37_T6" name="07 · Theo dõi cam kết còn
lại"><bpmn:documentation>Bước 7 · NV P. Kinh doanh. Theo dõi tổng số lượng đã giao, số lượng còn lại của Hợp đồng; nhắc Khách hàng khi sắp hết cam kết hoặc khi hợp đồng gần hết hạn.</bpmn:documentation><bpmn:incoming>AP37_F6</bpmn:incoming><bpmn:outgoing>AP37_F7</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP37_T7" name="08 · Tổng kết hợp đồng"><bpmn:documentation>Bước 8 · Trưởng BP KD. Hết kỳ hiệu lực, tổng kết tình hình thực hiện: đã giao bao nhiêu, còn thiếu bao nhiêu; quyết định gia hạn, ký hợp đồng mới, hoặc đóng hợp đồng.</bpmn:documentation><bpmn:incoming>AP37_F7</bpmn:incoming><bpmn:outgoing>AP37_F8</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP37_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP37_F8</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP37_F0" sourceRef="AP37_S" targetRef="AP37_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP37_F1" sourceRef="AP37_T0" targetRef="AP37_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP37_F2" sourceRef="AP37_T1" targetRef="AP37_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP37_F3" sourceRef="AP37_T2" targetRef="AP37_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP37_F4" sourceRef="AP37_T3" targetRef="AP37_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP37_F5" sourceRef="AP37_T4" targetRef="AP37_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP37_F6" sourceRef="AP37_T5" targetRef="AP37_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP37_F7" sourceRef="AP37_T6" targetRef="AP37_T7"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP37_F8" sourceRef="AP37_T7" targetRef="AP37_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP37_diagram"><bpmndi:BPMNPlane id="AP37_plane" bpmnElement="AP37_collab"><bpmndi:BPMNShape id="AP37_pool_di" bpmnElement="AP37_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="2166" height="704"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP37_lane_0_di" bpmnElement="AP37_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP37_lane_1_di" bpmnElement="AP37_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP37_lane_2_di" bpmnElement="AP37_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP37_lane_3_di" bpmnElement="AP37_lane_3" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="618" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP37_S_di" bpmnElement="AP37_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP37_T0_di" bpmnElement="AP37_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP37_T1_di" bpmnElement="AP37_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP37_T2_di" bpmnElement="AP37_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP37_T3_di" bpmnElement="AP37_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP37_T4_di" bpmnElement="AP37_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="658" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP37_T5_di" bpmnElement="AP37_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP37_T6_di" bpmnElement="AP37_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP37_T7_di" bpmnElement="AP37_T7" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1830" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP37_E_di" bpmnElement="AP37_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="2040" y="512" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1996" y="557" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP37_F0_di" bpmnElement="AP37_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP37_F1_di" bpmnElement="AP37_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="540" y="178"/><di:waypoint x="540" y="354"/><di:waypoint x="570" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP37_F2_di" bpmnElement="AP37_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="354"/><di:waypoint x="750" y="354"/><di:waypoint x="750" y="178"/><di:waypoint x="780" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP37_F3_di" bpmnElement="AP37_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="178"/><di:waypoint x="960" y="178"/><di:waypoint x="960" y="530"/><di:waypoint x="990" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP37_F4_di" bpmnElement="AP37_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="530"/><di:waypoint x="1170" y="530"/><di:waypoint x="1170" y="706"/><di:waypoint x="1200" y="706"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP37_F5_di" bpmnElement="AP37_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="706"/><di:waypoint x="1380" y="706"/><di:waypoint x="1380" y="178"/><di:waypoint x="1410" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP37_F6_di" bpmnElement="AP37_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="178"/><di:waypoint x="1620" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP37_F7_di" bpmnElement="AP37_F7" bioc:stroke="#7e90aa"><di:waypoint x="1780" y="178"/><di:waypoint x="1800" y="178"/><di:waypoint x="1800" y="530"/><di:waypoint x="1830" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP37_F8_di" bpmnElement="AP37_F8" bioc:stroke="#7e90aa"><di:waypoint x="1990" y="530"/><di:waypoint x="2040" y="530"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>