<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP24_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP24_collab"><bpmn:participant id="AP24_pool" name="Quản lý Định mức BOM" processRef="AP24"/></bpmn:collaboration><bpmn:process id="AP24" name="Quản lý Định mức BOM" isExecutable="false"><bpmn:laneSet id="AP24_lanes"><bpmn:lane id="AP24_lane_0" name="hòng R&amp;D"><bpmn:flowNodeRef>AP24_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP24_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP24_T1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP24_lane_1" name="Bộ phận CNTT"><bpmn:flowNodeRef>AP24_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP24_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP24_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP24_T6</bpmn:flowNodeRef><bpmn:flowNodeRef>AP24_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP24_lane_2" name="Bộ phận Sản xuất"><bpmn:flowNodeRef>AP24_T4</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP24_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP24_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP24_T0" name="01 · Nghiên cứu, đề xuất SP
mới"><bpmn:documentation>Bước 1 · Phòng R&amp;D. R&amp;D nghiên cứu phát triển sản phẩm nguyên liệu sào mới.</bpmn:documentation><bpmn:incoming>AP24_F0</bpmn:incoming><bpmn:outgoing>AP24_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP24_T1" name="02 · Ban hành thông tin định
mức"><bpmn:documentation>Bước 2 · Phòng R&amp;D. Ban hành thông tin về sản phẩm mới cho các bộ phận.</bpmn:documentation><bpmn:incoming>AP24_F1</bpmn:incoming><bpmn:outgoing>AP24_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP24_T2" name="03 · Khai báo Định mức BTP"><bpmn:documentation>Bước 3 · BP. CNTT. Khai báo BOM cho BTP, NVL trong BOM đã mã hóa trước.</bpmn:documentation><bpmn:incoming>AP24_F2</bpmn:incoming><bpmn:outgoing>AP24_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP24_T3" name="04 · Khai báo Định mức đóng
gói TP"><bpmn:documentation>Bước 4 · BP. CNTT. Khai báo BOM cho TP theo quy cách đóng gói (SKU).</bpmn:documentation><bpmn:incoming>AP24_F3</bpmn:incoming><bpmn:outgoing>AP24_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP24_T4" name="05 · Chạy thử sản phẩm mới"><bpmn:documentation>Bước 5 · BP. Sản xuất. Chạy thử và ghi nhận thông số đầu vào cho Routing.</bpmn:documentation><bpmn:incoming>AP24_F4</bpmn:incoming><bpmn:outgoing>AP24_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP24_T5" name="06 · Khai báo Định mức tái
chế"><bpmn:documentation>Bước 6 · BP. CNTT. Khai báo BOM cho sản phẩm tái chế.</bpmn:documentation><bpmn:incoming>AP24_F5</bpmn:incoming><bpmn:outgoing>AP24_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP24_T6" name="07 · Khai báo Kịch bản SX"><bpmn:documentation>Bước 7 · BP. CNTT. Khai báo kịch bản SX thông thường và tái chế.</bpmn:documentation><bpmn:incoming>AP24_F6</bpmn:incoming><bpmn:outgoing>AP24_F7</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP24_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP24_F7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP24_F0" sourceRef="AP24_S" targetRef="AP24_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP24_F1" sourceRef="AP24_T0" targetRef="AP24_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP24_F2" sourceRef="AP24_T1" targetRef="AP24_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP24_F3" sourceRef="AP24_T2" targetRef="AP24_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP24_F4" sourceRef="AP24_T3" targetRef="AP24_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP24_F5" sourceRef="AP24_T4" targetRef="AP24_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP24_F6" sourceRef="AP24_T5" targetRef="AP24_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP24_F7" sourceRef="AP24_T6" targetRef="AP24_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP24_diagram"><bpmndi:BPMNPlane id="AP24_plane" bpmnElement="AP24_collab"><bpmndi:BPMNShape id="AP24_pool_di" bpmnElement="AP24_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1956" height="528"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP24_lane_0_di" bpmnElement="AP24_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP24_lane_1_di" bpmnElement="AP24_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1926"