<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP23_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP23_collab"><bpmn:participant id="AP23_pool" name="Quản lý hàng hóa (NVL, TP, BTP)" processRef="AP23"/></bpmn:collaboration><bpmn:process id="AP23" name="Quản lý hàng hóa (NVL, TP, BTP)" isExecutable="false"><bpmn:laneSet id="AP23_lanes"><bpmn:lane id="AP23_lane_0" name="hòng R&amp;D"><bpmn:flowNodeRef>AP23_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP23_T0</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP23_lane_1" name="Bộ phận CNTT"><bpmn:flowNodeRef>AP23_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP23_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP23_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP23_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP23_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP23_T6</bpmn:flowNodeRef><bpmn:flowNodeRef>AP23_T7</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP23_lane_2" name="Phòng Kế toán"><bpmn:flowNodeRef>AP23_T8</bpmn:flowNodeRef><bpmn:flowNodeRef>AP23_T9</bpmn:flowNodeRef><bpmn:flowNodeRef>AP23_E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP23_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP23_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP23_T0" name="01 · Nghiên cứu phát triển
SP mới"><bpmn:documentation>Bước 1 · Phòng R&amp;D. Phòng R&amp;D phát triển sản phẩm mới, phát sinh yêu cầu tạo mã hàng.</bpmn:documentation><bpmn:incoming>AP23_F0</bpmn:incoming><bpmn:outgoing>AP23_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP23_T1" name="02 · Kiểm tra tồn tại trên
HT"><bpmn:documentation>Bước 2 · BP. CNTT. Kiểm tra mã hàng đã tồn tại chưa trên hệ thống.</bpmn:documentation><bpmn:incoming>AP23_F1</bpmn:incoming><bpmn:outgoing>AP23_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP23_T2" name="03 · Tạo mới NVL"><bpmn:documentation>Bước 3 · BP. CNTT. Tạo mã NVL: thông tin chung và tham số kế hoạch.</bpmn:documentation><bpmn:incoming>AP23_F2</bpmn:incoming><bpmn:outgoing>AP23_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP23_T3" name="04 · Mã hóa thông tin (nếu
cần)"><bpmn:documentation>Bước 4 · BP. CNTT. Điền thông tin mã hóa cho mặt hàng cần bảo mật.</bpmn:documentation><bpmn:incoming>AP23_F3</bpmn:incoming><bpmn:outgoing>AP23_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP23_T4" name="05 · Tạo mới BTP cấp 1, cấp
2"><bpmn:documentation>Bước 5 · BP. CNTT. Tạo các mã BTP tương ứng với thông tin SX và kế hoạch.</bpmn:documentation><bpmn:incoming>AP23_F4</bpmn:incoming><bpmn:outgoing>AP23_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP23_T5" name="06 · Tạo mới TP cuối"><bpmn:documentation>Bước 6 · BP. CNTT. Tạo mã TP với thông tin chung, SX, tham số kế hoạch.</bpmn:documentation><bpmn:incoming>AP23_F5</bpmn:incoming><bpmn:outgoing>AP23_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP23_T6" name="07 · Khai báo SKU"><bpmn:documentation>Bước 7 · BP. CNTT. Khai báo tham số bổ sung hàng (Stockkeeping Unit).</bpmn:documentation><bpmn:incoming>AP23_F6</bpmn:incoming><bpmn:outgoing>AP23_F7</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP23_T7" name="08 · Gửi yêu cầu phê duyệt"><bpmn:documentation>Bước 8 · BP. CNTT. Gửi yêu cầu phê duyệt mã mới cho BP Sản xuất.</bpmn:documentation><bpmn:incoming>AP23_F7</bpmn:incoming><bpmn:outgoing>AP23_F8</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP23_T8" name="09 · Kiểm tra nhóm hạch toán"><bpmn:documentation>Bước 9 · P. Kế toán. Kiểm tra và bổ sung thông tin nhóm hạch toán.</bpmn:documentation><bpmn:incoming>AP23_F8</bpmn:incoming><bpmn:outgoing>AP23_F9</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP23_T9" name="10 · Release cho phòng ban"><bpmn:documentation>Bước 10 · P. Kế toán. Mặt hàng được gỡ chặn, cho phép giao dịch.</bpmn:documentation><bpmn:incoming>AP23_F9</bpmn:incoming><bpmn:outgoing>AP23_F10</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP23_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP23_F10</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP23_F0" sourceRef="AP23_S" targetRef="AP23_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP23_F1" sourceRef="AP23_T0" targetRef="AP23_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP23_F2" sourceRef="AP23_T1" targetRef="AP23_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP23_F3" sourceRef="AP23_T2" targetRef="AP23_T3