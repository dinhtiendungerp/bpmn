<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP27_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP27_collab"><bpmn:participant id="AP27_pool" name="Lập kế hoạch sản xuất" processRef="AP27"/></bpmn:collaboration><bpmn:process id="AP27" name="Lập kế hoạch sản xuất" isExecutable="false"><bpmn:laneSet id="AP27_lanes"><bpmn:lane id="AP27_lane_0" name="Bộ phận Sản xuất"><bpmn:flowNodeRef>AP27_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP27_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP27_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP27_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP27_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP27_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP27_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP27_T6</bpmn:flowNodeRef><bpmn:flowNodeRef>AP27_E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP27_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP27_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP27_T0" name="01 · Dự báo doanh số BH"><bpmn:documentation>Bước 1 · BP. Sản xuất. Đầu vào từ bộ phận Kinh doanh (Sales Budget).</bpmn:documentation><bpmn:incoming>AP27_F0</bpmn:incoming><bpmn:outgoing>AP27_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP27_T1" name="02 · Sao chép dự báo → KH SX"><bpmn:documentation>Bước 2 · BP. Sản xuất. Sao chép dữ liệu dự báo BH thành Demand Forecast.</bpmn:documentation><bpmn:incoming>AP27_F1</bpmn:incoming><bpmn:outgoing>AP27_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP27_T2" name="03 · Điều chỉnh KH SX"><bpmn:documentation>Bước 3 · BP. Sản xuất. GĐ Sản xuất điều chỉnh KH chi tiết theo doanh số dự báo.</bpmn:documentation><bpmn:incoming>AP27_F2</bpmn:incoming><bpmn:outgoing>AP27_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP27_T3" name="04 · Chạy MPS"><bpmn:documentation>Bước 4 · BP. Sản xuất. Chạy MPS cho TP và BTP, quét dữ liệu KH + tồn kho.</bpmn:documentation><bpmn:incoming>AP27_F3</bpmn:incoming><bpmn:outgoing>AP27_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP27_T4" name="05 · Kiểm tra khả năng SX"><bpmn:documentation>Bước 5 · BP. Sản xuất. GĐ Xưởng kiểm tra lịch hệ thống đề xuất.</bpmn:documentation><bpmn:incoming>AP27_F4</bpmn:incoming><bpmn:outgoing>AP27_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP27_T5" name="06 · Điều chỉnh KH SX tổng"><bpmn:documentation>Bước 6 · BP. Sản xuất. Điều chỉnh lại cho hợp lý.</bpmn:documentation><bpmn:incoming>AP27_F5</bpmn:incoming><bpmn:outgoing>AP27_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP27_T6" name="07 · Tạo Firm Planned PO"><bpmn:documentation>Bước 7 · BP. Sản xuất. Tạo lệnh SX từ màn hình Kế hoạch.</bpmn:documentation><bpmn:incoming>AP27_F6</bpmn:incoming><bpmn:outgoing>AP27_F7</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP27_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP27_F7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP27_F0" sourceRef="AP27_S" targetRef="AP27_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP27_F1" sourceRef="AP27_T0" targetRef="AP27_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP27_F2" sourceRef="AP27_T1" targetRef="AP27_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP27_F3" sourceRef="AP27_T2" targetRef="AP27_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP27_F4" sourceRef="AP27_T3" targetRef="AP27_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP27_F5" sourceRef="AP27_T4" targetRef="AP27_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP27_F6" sourceRef="AP27_T5" targetRef="AP27_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP27_F7" sourceRef="AP27_T6" targetRef="AP27_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP27_diagram"><bpmndi:BPMNPlane id="AP27_plane" bpmnElement="AP27_collab"><bpmndi:BPMNShape id="AP27_pool_di" bpmnElement="AP27_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1956" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP27_lane_0_di" bpmnElement="AP27_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP27_S_di" bpmnElement="AP27_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP27_T0_di" bpmnElement="AP27_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP27_T1_di" bpmnElement="AP27_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP27_T2_di" bpmnElement="AP27_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP27_T3_di" bpmnElement="AP27_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP27_T4_di" bpmnElement="AP27_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP27_T5_di" bpmnElement="AP27_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP27_T6_di" bpmnElement="AP27_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP27_E_di" bpmnElement