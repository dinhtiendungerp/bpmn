<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP03_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP03_collab"><bpmn:participant id="AP03_pool" name="Quản lý chi tiền mặt, ngân hàng" processRef="AP03"/></bpmn:collaboration><bpmn:process id="AP03" name="Quản lý chi tiền mặt, ngân hàng" isExecutable="false"><bpmn:laneSet id="AP03_lanes"><bpmn:lane id="AP03_lane_0" name="Bộ phận yêu cầu"><bpmn:flowNodeRef>AP03_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP03_T0</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP03_lane_1" name="Phòng Kế toán"><bpmn:flowNodeRef>AP03_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP03_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP03_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP03_T7</bpmn:flowNodeRef><bpmn:flowNodeRef>AP03_T8</bpmn:flowNodeRef><bpmn:flowNodeRef>AP03_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP03_lane_2" name="Ban Giám đốc"><bpmn:flowNodeRef>AP03_T4</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP03_lane_3" name="Ngân hàng"><bpmn:flowNodeRef>AP03_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP03_T6</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP03_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP03_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP03_T0" name="01 · Lập bộ đề nghị thanh
toán"><bpmn:documentation>Bước 1 · Bộ phận yêu cầu. Các bộ phận/phòng ban có yêu cầu lập đề nghị thanh toán gửi BP. Kế toán; Trưởng bộ phận phê duyệt nội bộ.</bpmn:documentation><bpmn:incoming>AP03_F0</bpmn:incoming><bpmn:outgoing>AP03_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP03_T1" name="02 · Tiếp nhận &amp; thẩm định"><bpmn:documentation>Bước 2 · Bộ phận kế toán. Kế toán kiểm tra &amp; thẩm định bộ đề nghị thanh toán, trình phê duyệt lên các cấp lãnh đạo / TGĐ.</bpmn:documentation><bpmn:incoming>AP03_F1</bpmn:incoming><bpmn:outgoing>AP03_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP03_T2" name="03 · Tạo bút toán chi tiền"><bpmn:documentation>Bước 3 · Bộ phận kế toán. Tạo bút toán thanh toán trên Payment Journal: tiền mặt hoặc chuyển khoản; tham chiếu hóa đơn cần thanh toán.</bpmn:documentation><bpmn:incoming>AP03_F2</bpmn:incoming><bpmn:outgoing>AP03_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP03_T3" name="04 · Kết xuất XML / Gửi lệnh"><bpmn:documentation>Bước 4 · Bộ phận kế toán. Hai hình thức tích hợp e-banking: (1) File interface - kết xuất XML từ BC, import lên NH; (2) Host-to-host hoặc API - BC tự động gửi lệnh.</bpmn:documentation><bpmn:incoming>AP03_F3</bpmn:incoming><bpmn:outgoing>AP03_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP03_T4" name="05 · Duyệt lệnh chi trên hệ
thống NH"><bpmn:documentation>Bước 5 · Ban TGĐ. Ngân hàng yêu cầu người dùng duyệt lệnh thanh toán để đi lệnh trong trường hợp tích hợp e-banking.</bpmn:documentation><bpmn:incoming>AP03_F4</bpmn:incoming><bpmn:outgoing>AP03_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP03_T5" name="06 · Đi lệnh chuyển tiền"><bpmn:documentation>Bước 6 · Ngân hàng. Ngân hàng thực hiện chuyển tiền theo lệnh đã được duyệt.</bpmn:documentation><bpmn:incoming>AP03_F5</bpmn:incoming><bpmn:outgoing>AP03_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP03_T6" name="07 · Trả thông tin sao kê về
BC"><bpmn:documentation>Bước 7 · Ngân hàng. Thông tin sao kê ngân hàng được gửi về màn hình Bank Reconciliation trên D365 BC.</bpmn:documentation><bpmn:incoming>AP03_F6</bpmn:incoming><bpmn:outgoing>AP03_F7</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP03_T7" name="08 · Đối chiếu sao kê"><bpmn:documentation>Bước 8 · Bộ phận kế toán. Trên Bank Reconciliation, kế toán kiểm tra các lệnh đã hoàn thành; trạng thái Payment Journal = Complete.</bpmn:documentation><bpmn:incoming>AP03_F7</bpmn:incoming><bpmn:outgoing>AP03_F8</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP03_T8" name="09 · Hạch toán &amp; in phiếu
chi"><bpmn:documentation>Bước 9 · Bộ phận kế toán. Hệ thống ghi nhận hạch toán; kế toán in phiếu chi từ hệ thống (mẫu theo quy định hiện hành).</bpmn:documentation><bpmn:incoming>AP03_F8</bpmn:incoming><bpmn:outgoing>AP03_F9</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP03_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP03_F9</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP03_F0" sourceRef="AP03_S" targetRef="AP03_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP03_F1" sourceRef="AP03_T0" targetRef="AP03_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP03_F2" sourceRef="AP03_T1" targetRef="AP03_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP03_F3" sourceRef="AP03_T2" targetRef="AP03_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP03_F4" sourceRef="AP03_T3" targetRef="AP03_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP03_F5" sourceRef="AP03_T4" targetRef="AP03_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP03_F6" sourceRef="AP03_T5" targetRef="AP03_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP03_F7" sourceRef="AP03_T6" targetRef="AP03_T7"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP03_F8" sourceRef="AP03_T7" targetRef="AP03_T8"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP03_F9" sourceRef="AP03_T8" targetRef="AP03_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP03_diagram"><bpmndi:BPMNPlane id="AP03_plane" bpmnElement="AP03_collab"><bpmndi:BPMNShape id="AP03_pool_di" bpmnElement="AP03_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="2376" height="704"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP03_lane_0_di" bpmnElement="AP03_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="2346" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP03_lane_1_di" bpmnElement="AP03_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="2346" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP03_lane_2_di" bpmnElement="AP03_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="2346" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP03_lane_3_di" bpmnElement="AP03_lane_3" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="618" width="2346" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP03_S_di" bpmnElement="AP03_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP03_T0_di" bpmnElement="AP03_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP03_T1_di" bpmnElement="AP03_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP03_T2_di" bpmnElement="AP03_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP03_T3_di" bpmnElement="AP03_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP03_T4_di" bpmnElement="AP03_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP03_T5_di" bpmnElement="AP03_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="658" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP03_T6_di" bpmnElement="AP03_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="658" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP03_T7_di" bpmnElement="AP03_T7" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1830" y="306" width="160