<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP02_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP02_collab"><bpmn:participant id="AP02_pool" name="Quản lý thu tiền mặt, ngân hàng" processRef="AP02"/></bpmn:collaboration><bpmn:process id="AP02" name="Quản lý thu tiền mặt, ngân hàng" isExecutable="false"><bpmn:laneSet id="AP02_lanes"><bpmn:lane id="AP02_lane_0" name="Phòng Kế toán"><bpmn:flowNodeRef>AP02_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP02_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP02_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP02_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP02_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP02_E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP02_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP02_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP02_T0" name="01 · Tập hợp chứng từ liên
quan"><bpmn:documentation>Bước 1 · Phòng kế toán. Tập hợp các chứng từ thu: phiếu nộp tiền, sao kê ngân hàng, hóa đơn bán hàng, hợp đồng. Đối chiếu trước khi vào hệ thống.</bpmn:documentation><bpmn:incoming>AP02_F0</bpmn:incoming><bpmn:outgoing>AP02_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP02_T1" name="02 · Lập phiếu thu / phiếu
hạch toán"><bpmn:documentation>Bước 2 · Phòng kế toán. Lập trên Cash Receipt Journal hoặc Bank Receipt - hỗ trợ thu công nợ KH theo từng hóa đơn, thu trước, thu khác loại tiền (tự động CLTG).</bpmn:documentation><bpmn:incoming>AP02_F1</bpmn:incoming><bpmn:outgoing>AP02_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP02_T2" name="03 · Phê duyệt phiếu thu"><bpmn:documentation>Bước 3 · Phòng kế toán. Người có thẩm quyền (Kế toán trưởng) duyệt phiếu thu/phiếu hạch toán trước khi ghi sổ chính thức.</bpmn:documentation><bpmn:incoming>AP02_F2</bpmn:incoming><bpmn:outgoing>AP02_F3</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="AP02_T3" name="04 · Thu tiền &amp; hạch toán hệ
thống"><bpmn:documentation>Bước 4 · Phòng kế toán. Thực hiện thu tiền (mặt/chuyển khoản); post phiếu - hệ thống tự cập nhật công nợ KH, sổ quỹ. Quản lý số phiếu trước/sau ghi sổ riêng biệt.</bpmn:documentation><bpmn:incoming>AP02_F3</bpmn:incoming><bpmn:outgoing>AP02_F4</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="AP02_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP02_F4</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP02_F0" sourceRef="AP02_S" targetRef="AP02_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP02_F1" sourceRef="AP02_T0" targetRef="AP02_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP02_F2" sourceRef="AP02_T1" targetRef="AP02_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP02_F3" sourceRef="AP02_T2" targetRef="AP02_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP02_F4" sourceRef="AP02_T3" targetRef="AP02_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP02_diagram"><bpmndi:BPMNPlane id="AP02_plane" bpmnElement="AP02_collab"><bpmndi:BPMNShape id="AP02_pool_di" bpmnElement="AP02_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1326" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP02_lane_0_di" bpmnElement="AP02_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1296" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP02_S_di" bpmnElement="AP02_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP02_T0_di" bpmnElement="AP02_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP02_T1_di" bpmnElement="AP02_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP02_T2_di" bpmnElement="AP02_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP02_T3_di" bpmnElement="AP02_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP02_E_di" bpmnElement="AP02_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1200" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1156" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP02_F0_di" bpmnElement="AP02_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP02_F1_di" bpmnElement="AP02_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="570" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP02_F2_di" bpmnElement="AP02_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="178"/><di:waypoint x="780" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP02_F3_di" bpmnElement="AP02_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="178"/><di:waypoint x="990" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP02_F4_di" bpmnElement="AP02_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="178"/><di:waypoint x="1200" y="178"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>