<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP15_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP15_collab"><bpmn:participant id="AP15_pool" name="Lập dự toán và điều chỉnh ngân sách" processRef="AP15"/></bpmn:collaboration><bpmn:process id="AP15" name="Lập dự toán và điều chỉnh ngân sách" isExecutable="false"><bpmn:laneSet id="AP15_lanes"><bpmn:lane id="AP15_lane_0" name="Phòng Kế toán"><bpmn:flowNodeRef>AP15_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP15_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP15_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP15_T6</bpmn:flowNodeRef><bpmn:flowNodeRef>AP15_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP15_lane_1" name="BLĐ"><bpmn:flowNodeRef>AP15_T1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP15_lane_2" name="liên quan"><bpmn:flowNodeRef>AP15_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP15_T4</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP15_lane_3" name="Người duyệt"><bpmn:flowNodeRef>AP15_T5</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP15_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP15_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP15_T0" name="01 · Xây dựng tiêu chí &amp; lập
dự toán"><bpmn:documentation>Bước 1 · P. kế toán &amp; BP liên quan. DN cần lập kế hoạch giám sát &amp; kiểm soát các nguồn tài chính - dự tính các khoản thu chi cho thời kỳ nhất định.</bpmn:documentation><bpmn:incoming>AP15_F0</bpmn:incoming><bpmn:outgoing>AP15_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP15_T1" name="02 · Phê duyệt dự toán"><bpmn:documentation>Bước 2 · BLĐ. Người có quyền phê duyệt dự toán trước khi đưa vào hệ thống quản lý.</bpmn:documentation><bpmn:incoming>AP15_F1</bpmn:incoming><bpmn:outgoing>AP15_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP15_T2" name="03 · Tạo dự toán trên GL
Budget"><bpmn:documentation>Bước 3 · P. kế toán. Kiểm tra dự toán đã tồn tại; tạo mới - khai báo mã, tên, các tiêu chí phân tích, công thức; import từ Excel.</bpmn:documentation><bpmn:incoming>AP15_F2</bpmn:incoming><bpmn:outgoing>AP15_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP15_T3" name="04 · So sánh thực tế vs dự
toán &amp; phân tích"><bpmn:documentation>Bước 4 · BP. liên quan. Trong quá trình SXKD, các khoản phát sinh, sự cố ngoài ngân sách phải ghi nhận và đối chiếu; phân tích nguyên nhân chênh lệch.</bpmn:documentation><bpmn:incoming>AP15_F3</bpmn:incoming><bpmn:outgoing>AP15_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP15_T4" name="05 · Lập yêu cầu điều chỉnh"><bpmn:documentation>Bước 5 · BP. liên quan. Dựa trên kết quả so sánh và phân tích, lập đề xuất điều chỉnh ngân sách sát thực tế.</bpmn:documentation><bpmn:incoming>AP15_F4</bpmn:incoming><bpmn:outgoing>AP15_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP15_T5" name="06 · Phê duyệt điều chỉnh"><bpmn:documentation>Bước 6 · Người duyệt. Dựa trên kết quả so sánh và phân tích, người có quyền phê duyệt.</bpmn:documentation><bpmn:incoming>AP15_F5</bpmn:incoming><bpmn:outgoing>AP15_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP15_T6" name="07 · Tìm kiếm &amp; điều chỉnh
kế hoạch"><bpmn:documentation>Bước 7 · BP. kế toán. Tìm kiếm bảng kế hoạch trên hệ thống và điều chỉnh lại theo các yêu cầu đã được phê duyệt.</bpmn:documentation><bpmn:incoming>AP15_F6</bpmn:incoming><bpmn:outgoing>AP15_F7</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP15_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP15_F7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP15_F0" sourceRef="AP15_S" targetRef="AP15_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP15_F1" sourceRef="AP15_T0" targetRef="AP15_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP15_F2" sourceRef="AP15_T1" targetRef="AP15_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP15_F3" sourceRef="AP15_T2" targetRef="AP15_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP15_F4" sourceRef="AP15_T3" targetRef="AP15_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP15_F5" sourceRef="AP15_T4" targetRef="AP15_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP15_F6" sourceRef="AP15_T5" targetRef="AP15_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP15_F7" sourceRef="AP15_T6" targetRef="AP15_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP15_diagram"><bpmndi:BPMNPlane id="AP15_plane" bpmnElement="AP15_collab"><bpmndi:BPMNShape id="AP15_pool_di" bpmnElement="AP15_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1956" height="704"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP15_lane_0_di" bpmnElement="AP15_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP15_lane_1_di" bpmnElement="AP15_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP15_lane_2_di" bpmnElement="AP15_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP15_lane_3_di" bpmnElement="AP15_lane_3" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="618" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP15_S_di" bpmnElement="AP15_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP15_T0_di" bpmnElement="AP15_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP15_T1_di" bpmnElement="AP15_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP15_T2_di" bpmnElement="AP15_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP15_T3_di" bpmnElement="AP15_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP15_T4_di" bpmnElement="AP15_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP15_T5_di" bpmnElement="AP15_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="658" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP15_T6_di" bpmnElement="AP15_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP15_E_di" bpmnElement="AP15_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1830" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1786" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP15_F0_di" bpmnElement="AP15_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP15_F1_di" bpmnElement="AP15_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="540" y="178"/><di:waypoint x="540" y="354"/><di:waypoint x="570" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP15_F2_di" bpmnElement="AP15_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="354"/><di:waypoint x="750" y="354"/><di:waypoint x="750" y="178"/><di:waypoint x="780" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP15_F3_di" bpmnElement="AP15_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="178"/><di:waypoint x="960" y="178"/><di:waypoint x="960" y="530"/><di:waypoint x="990" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP15_F4_di" bpmnElement="AP15_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="530"/><di:waypoint x="1200" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP15_F5_di" bpmnElement="AP15_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="530"/><di:waypoint x="1380" y="530"/><di:waypoint x="1380" y="706"/><di:waypoint x="1410" y="706"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP15_F6_di" bpmnElement="AP15_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="706"/><di:waypoint x="1590" y="706"/><di:waypoint x="1590" y="178"/><di:waypoint x="1620" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP15_F7_di" bpmnElement="AP15_F7" bioc:stroke="#7e90aa"><di:waypoint x="1780" y="178"/><di:waypoint x="1830" y="178"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>