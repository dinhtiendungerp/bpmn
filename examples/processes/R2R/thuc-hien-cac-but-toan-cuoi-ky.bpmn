<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP21_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP21_collab"><bpmn:participant id="AP21_pool" name="Thực hiện các bút toán cuối kỳ" processRef="AP21"/></bpmn:collaboration><bpmn:process id="AP21" name="Thực hiện các bút toán cuối kỳ" isExecutable="false"><bpmn:laneSet id="AP21_lanes"><bpmn:lane id="AP21_lane_0" name="Phòng Kế toán"><bpmn:flowNodeRef>AP21_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP21_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP21_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP21_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP21_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP21_E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP21_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP21_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP21_T0" name="01 · Đóng kỳ ghi sổ &amp; mở kỳ
riêng"><bpmn:documentation>Bước 1 · Kế toán tổng hợp. Cuối mỗi kỳ, KTT đóng kỳ ghi sổ kế toán tổng hợp - không cho người dùng tiếp tục hạch toán; khai báo kỳ ghi sổ riêng cho từng người dùng.</bpmn:documentation><bpmn:incoming>AP21_F0</bpmn:incoming><bpmn:outgoing>AP21_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP21_T1" name="02 · Bút toán phân bổ, kết
chuyển &amp; bổ sung"><bpmn:documentation>Bước 2 · Kế toán tổng hợp. Cuối kỳ thực hiện thao tác phân bổ trên sổ cái (GL 3.1). Nếu sót chứng từ - thực hiện bút toán bổ sung trên sổ cái (GL 3.2).</bpmn:documentation><bpmn:incoming>AP21_F1</bpmn:incoming><bpmn:outgoing>AP21_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP21_T2" name="03 · Đánh giá CLTG cuối kỳ"><bpmn:documentation>Bước 3 · Kế toán tổng hợp. Xem xét các khoản vốn bằng tiền, phải thu, phải trả, nợ vay có gốc ngoại tệ; đánh giá lại với tỷ giá bình quân liên ngân hàng để điều chỉnh lãi/lỗ CLTG.</bpmn:documentation><bpmn:incoming>AP21_F2</bpmn:incoming><bpmn:outgoing>AP21_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP21_T3" name="04 · Đóng kỳ &amp; kết chuyển
KQKD"><bpmn:documentation>Bước 4 · Kế toán tổng hợp. Sau khi xác định lãi/lỗ trên BC KQKD - kết chuyển lãi/lỗ sang TK lợi nhuận giữ lại; chuyển bút toán cho người có thẩm quyền phê duyệt trước khi hạch toán.</bpmn:documentation><bpmn:incoming>AP21_F3</bpmn:incoming><bpmn:outgoing>AP21_F4</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP21_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP21_F4</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP21_F0" sourceRef="AP21_S" targetRef="AP21_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP21_F1" sourceRef="AP21_T0" targetRef="AP21_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP21_F2" sourceRef="AP21_T1" targetRef="AP21_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP21_F3" sourceRef="AP21_T2" targetRef="AP21_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP21_F4" sourceRef="AP21_T3" targetRef="AP21_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP21_diagram"><bpmndi:BPMNPlane id="AP21_plane" bpmnElement="AP21_collab"><bpmndi:BPMNShape id="AP21_pool_di" bpmnElement="AP21_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1326" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP21_lane_0_di" bpmnElement="AP21_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1296" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP21_S_di" bpmnElement="AP21_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP21_T0_di" bpmnElement="AP21_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP21_T1_di" bpmnElement="AP21_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP21_T2_di" bpmnElement="AP21_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP21_T3_di" bpmnElement="AP21_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP21_E_di" bpmnElement="AP21_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1200" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1156" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP21_F0_di" bpmnElement="AP21_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP21_F1_di" bpmnElement="AP21_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="570" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP21_F2_di" bpmnElement="AP21_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="178"/><di:waypoint x="780" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP21_F3_di" bpmnElement="AP21_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="178"/><di:waypoint x="990" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP21_F4_di" bpmnElement="AP21_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="178"/><di:waypoint x="1200" y="178"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>