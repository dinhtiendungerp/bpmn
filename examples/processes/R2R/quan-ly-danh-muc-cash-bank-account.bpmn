<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP01_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP01_collab"><bpmn:participant id="AP01_pool" name="Quản lý danh mục Cash / Bank Account" processRef="AP01"/></bpmn:collaboration><bpmn:process id="AP01" name="Quản lý danh mục Cash / Bank Account" isExecutable="false"><bpmn:laneSet id="AP01_lanes"><bpmn:lane id="AP01_lane_0" name="Phòng Kế toán"><bpmn:flowNodeRef>AP01_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP01_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP01_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP01_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP01_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP01_lane_1" name="Người duyệt"><bpmn:flowNodeRef>AP01_T1</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP01_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP01_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP01_T0" name="01 · Đề nghị / yêu cầu tạo
mới"><bpmn:documentation>Bước 1 · BP Kế toán. Phát sinh nhu cầu quản lý tài khoản tiền, ngân hàng - tạo mới hoặc thay đổi cấp tài khoản, đơn vị tiền tệ, mã Bank Account.</bpmn:documentation><bpmn:incoming>AP01_F0</bpmn:incoming><bpmn:outgoing>AP01_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP01_T1" name="02 · Kiểm tra / phê duyệt"><bpmn:documentation>Bước 2 · Người duyệt. Người có thẩm quyền (Kế toán trưởng/ BGĐ) kiểm tra và phê duyệt yêu cầu trước khi đưa vào hệ thống.</bpmn:documentation><bpmn:incoming>AP01_F1</bpmn:incoming><bpmn:outgoing>AP01_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP01_T2" name="03 · Tạo / cập nhật trên hệ
thống"><bpmn:documentation>Bước 3 · BP kế toán. Khai báo Cash/Bank Account: mã, tên, loại tiền, số dư đầu kỳ; có thể tách TK 112 thành level theo từng ngân hàng (theo từng ngân hàng).</bpmn:documentation><bpmn:incoming>AP01_F2</bpmn:incoming><bpmn:outgoing>AP01_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP01_T3" name="04 · Thông báo người liên
quan"><bpmn:documentation>Bước 4 · BP kế toán. Thông báo cho các kế toán viên / phòng ban có liên quan về tài khoản mới hoặc thay đổi đã được áp dụng.</bpmn:documentation><bpmn:incoming>AP01_F3</bpmn:incoming><bpmn:outgoing>AP01_F4</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP01_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP01_F4</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP01_F0" sourceRef="AP01_S" targetRef="AP01_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP01_F1" sourceRef="AP01_T0" targetRef="AP01_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP01_F2" sourceRef="AP01_T1" targetRef="AP01_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP01_F3" sourceRef="AP01_T2" targetRef="AP01_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP01_F4" sourceRef="AP01_T3" targetRef="AP01_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP01_diagram"><bpmndi:BPMNPlane id="AP01_plane" bpmnElement="AP01_collab"><bpmndi:BPMNShape id="AP01_pool_di" bpmnElement="AP01_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1326" height="352"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP01_lane_0_di" bpmnElement="AP01_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1296" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP01_lane_1_di" bpmnElement="AP01_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1296" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP01_S_di" bpmnElement="AP01_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP01_T0_di" bpmnElement="AP01_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP01_T1_di" bpmnElement="AP01_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP01_T2_di" bpmnElement="AP01_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP01_T3_di" bpmnElement="AP01_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP01_E_di" bpmnElement="AP01_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1200" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1156" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP01_F0_di" bpmnElement="AP01_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP01_F1_di" bpmnElement="AP01_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="540" y="178"/><di:waypoint x="540" y="354"/><di:waypoint x="570" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP01_F2_di" bpmnElement="AP01_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="354"/><di:waypoint x="750" y="354"/><di:waypoint x="750" y="178"/><di:waypoint x="780" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP01_F3_di" bpmnElement="AP01_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="178"/><di:waypoint x="990" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP01_F4_di" bpmnElement="AP01_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="178"/><di:waypoint x="1200" y="178"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>