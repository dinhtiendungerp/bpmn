<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP08_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP08_collab"><bpmn:participant id="AP08_pool" name="Mua mới TSCĐ" processRef="AP08"/></bpmn:collaboration><bpmn:process id="AP08" name="Mua mới TSCĐ" isExecutable="false"><bpmn:laneSet id="AP08_lanes"><bpmn:lane id="AP08_lane_0" name="yêu cầu"><bpmn:flowNodeRef>AP08_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP08_T0</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP08_lane_1" name="Thủ trưởng đơn vị"><bpmn:flowNodeRef>AP08_T1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP08_lane_2" name="Bộ phận Cung ứng"><bpmn:flowNodeRef>AP08_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP08_T3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP08_lane_3" name="Phòng Kế toán"><bpmn:flowNodeRef>AP08_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP08_T6</bpmn:flowNodeRef><bpmn:flowNodeRef>AP08_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP08_lane_4" name="Ban Giám đốc"><bpmn:flowNodeRef>AP08_T5</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP08_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP08_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP08_T0" name="01 · Lập đề xuất mua TSCĐ"><bpmn:documentation>Bước 1 · BP. yêu cầu. Bộ phận có nhu cầu mua TS lập đề xuất, gửi đi phê duyệt theo cấp.</bpmn:documentation><bpmn:incoming>AP08_F0</bpmn:incoming><bpmn:outgoing>AP08_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP08_T1" name="02 · Phê duyệt đề xuất"><bpmn:documentation>Bước 2 · Thủ trưởng đơn vị. Tiếp nhận đề xuất mua TSCĐ và phê duyệt làm căn cứ triển khai mua hàng.</bpmn:documentation><bpmn:incoming>AP08_F1</bpmn:incoming><bpmn:outgoing>AP08_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP08_T2" name="03 · Quy trình tạo mới TS &amp;
mua hàng"><bpmn:documentation>Bước 3 · BP. mua hàng. Sau khi phiếu được duyệt, BP. cung ứng triển khai quy trình mua TS; tham chiếu quy trình AP 2.2 ghi nhận hóa đơn mua TSCĐ.</bpmn:documentation><bpmn:incoming>AP08_F2</bpmn:incoming><bpmn:outgoing>AP08_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP08_T3" name="04 · Hoàn thành đơn hàng"><bpmn:documentation>Bước 4 · BP. mua hàng. Kiểm tra thông tin trên Purchase Order; post Purchase Receipt khi hàng về; thông tin các BP. liên quan.</bpmn:documentation><bpmn:incoming>AP08_F3</bpmn:incoming><bpmn:outgoing>AP08_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP08_T4" name="05 · Hạch toán công nợ &amp;
nguyên giá"><bpmn:documentation>Bước 5 · Phòng kế toán. Căn cứ hóa đơn mua, biên bản giao nhận: nếu ghi công nợ - hạch toán Purchase Invoice; nếu thanh toán trực tiếp - hạch toán FA G/L Journal.</bpmn:documentation><bpmn:incoming>AP08_F4</bpmn:incoming><bpmn:outgoing>AP08_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP08_T5" name="06 · Phê duyệt phiếu hạch
toán"><bpmn:documentation>Bước 6 · Lãnh đạo TCKT/BLĐ. Phê duyệt phiếu hạch toán hoặc hóa đơn mua tài sản trước khi đưa vào ghi sổ chính thức.</bpmn:documentation><bpmn:incoming>AP08_F5</bpmn:incoming><bpmn:outgoing>AP08_F6</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="AP08_T6" name="07 · Hạch toán vào hệ thống"><bpmn:documentation>Bước 7 · Phòng kế toán. Post phiếu/hóa đơn - tạo FA Ledger Entries; tự động sinh thẻ TSCĐ với nguyên giá và sẵn sàng tính khấu hao.</bpmn:documentation><bpmn:incoming>AP08_F6</bpmn:incoming><bpmn:outgoing>AP08_F7</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="AP08_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP08_F7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP08_F0" sourceRef="AP08_S" targetRef="AP08_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP08_F1" sourceRef="AP08_T0" targetRef="AP08_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP08_F2" sourceRef="AP08_T1" targetRef="AP08_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP08_F3" sourceRef="AP08_T2" targetRef="AP08_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP08_F4" sourceRef="AP08_T3" targetRef="AP08_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP08_F5" sourceRef="AP08_T4" targetRef="AP08_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP08_F6" sourceRef="AP08_T5" targetRef="AP08_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP08_F7" sourceRef="AP08_T6" targetRef="AP08_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP08_diagram"><bpmndi:BPMNPlane id="AP08_plane" bpmnElement="AP08_collab"><bpmndi:BPMNShape id="AP08_pool_di" bpmnElement="AP08_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1956" height="880"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP08_lane_0_di" bpmnElement="AP08_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP08_lane_1_di" bpmnElement="AP08_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP08_lane_2_di" bpmnElement="AP08_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP08_lane_3_di" bpmnElement="AP08_lane_3" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="618" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP08_lane_4_di" bpmnElement="AP08_lane_4" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="794" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP08_S_di" bpmnElement="AP08_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP08_T0_di" bpmnElement="AP08_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP08_T1_di" bpmnElement="AP08_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP08_T2_di" bpmnElement="AP08_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP08_T3_di" bpmnElement="AP08_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP08_T4_di" bpmnElement="AP08_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="658" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP08_T5_di" bpmnElement="AP08_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="834" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP08_T6_di" bpmnElement="AP08_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="658" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP08_E_di" bpmnElement="AP08_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1830" y="688" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1786" y="733" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP08_F0_di" bpmnElement="AP08_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP08_F1_di" bpmnElement="AP08_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="540" y="178"/><di:waypoint x="540" y="354"/><di:waypoint x="570" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP08_F2_di" bpmnElement="AP08_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="354"/><di:waypoint x="750" y="354"/><di:waypoint x="750" y="530"/><di:waypoint x="780" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP08_F3_di" bpmnElement="AP08_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="530"/><di:waypoint x="990" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP08_F4_di" bpmnElement="AP08_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="530"/><di:waypoint x="1170" y="530"/><di:waypoint x="1170" y="706"/><di:waypoint x="1200" y="706"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP08_F5_di" bpmnElement="AP08_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="706"/><di:waypoint x="1380" y="706"/><di:waypoint x="1380" y="882"/><di:waypoint x="1410" y="882"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP08_F6_di" bpmnElement="AP08_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="882"/><di:waypoint x="1590" y="882"/><di:waypoint x="1590" y="706"/><di:waypoint x="1620" y="706"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP08_F7_di" bpmnElement="AP08_F7" bioc:stroke="#7e90aa"><di:waypoint x="1780" y="706"/><di:waypoint x="1830" y="706"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>