<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP07_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP07_collab"><bpmn:participant id="AP07_pool" name="Phân loại tài sản cố định và quản lý thẻ chi tiết" processRef="AP07"/></bpmn:collaboration><bpmn:process id="AP07" name="Phân loại tài sản cố định và quản lý thẻ chi tiết" isExecutable="false"><bpmn:laneSet id="AP07_lanes"><bpmn:lane id="AP07_lane_0" name="Phòng Kế toán"><bpmn:flowNodeRef>AP07_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP07_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP07_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP07_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP07_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP07_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP07_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP07_lane_1" name="Bộ phận CNTT"><bpmn:flowNodeRef>AP07_T2</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP07_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP07_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP07_T0" name="01 · Xây dựng tiêu chí phân
loại"><bpmn:documentation>Bước 1 · BP. Kế toán. TSCĐ phân theo hình thái (hữu hình, vô hình, thuê TC) hoặc đặc trưng kỹ thuật (nhà cửa, máy móc...). Quản lý theo địa điểm, bộ phận sử dụng.</bpmn:documentation><bpmn:incoming>AP07_F0</bpmn:incoming><bpmn:outgoing>AP07_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP07_T1" name="02 · Lập yêu cầu tạo
mới/thay đổi"><bpmn:documentation>Bước 2 · BP. Kế toán. Khi phát sinh nhu cầu, lập phiếu yêu cầu tạo mới hoặc thay đổi mã nhóm TSCĐ; trình cấp có thẩm quyền.</bpmn:documentation><bpmn:incoming>AP07_F1</bpmn:incoming><bpmn:outgoing>AP07_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP07_T2" name="03 · Phê duyệt &amp; cập nhật hệ
thống"><bpmn:documentation>Bước 3 · TGĐ / Phòng IT. TGĐ phê duyệt; Phòng IT tạo mới hoặc cập nhật mã FA Class, FA Subclass, Posting Group trên hệ thống.</bpmn:documentation><bpmn:incoming>AP07_F2</bpmn:incoming><bpmn:outgoing>AP07_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP07_T3" name="04 · Tiếp nhận hồ sơ TS"><bpmn:documentation>Bước 4 · BP. Kế toán. Tiếp nhận hồ sơ mua hoặc yêu cầu thay đổi - kiểm tra tính hợp lệ chứng từ.</bpmn:documentation><bpmn:incoming>AP07_F3</bpmn:incoming><bpmn:outgoing>AP07_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP07_T4" name="05 · Phê duyệt &amp; tạo thẻ TS"><bpmn:documentation>Bước 5 · TGĐ / BP. Kế toán. Phê duyệt mua TS hoặc thay đổi đơn vị/người quản lý; tạo Fixed Asset Card hoặc cập nhật thông tin (Posting Group, Subclass, Location, Department).</bpmn:documentation><bpmn:incoming>AP07_F4</bpmn:incoming><bpmn:outgoing>AP07_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP07_T5" name="06 · Thông báo người liên
quan"><bpmn:documentation>Bước 6 · BP. Kế toán. Thông báo người chịu trách nhiệm quản lý TS hoặc BP. Kế toán có liên quan về các thay đổi đã thực hiện.</bpmn:documentation><bpmn:incoming>AP07_F5</bpmn:incoming><bpmn:outgoing>AP07_F6</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP07_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP07_F6</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP07_F0" sourceRef="AP07_S" targetRef="AP07_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP07_F1" sourceRef="AP07_T0" targetRef="AP07_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP07_F2" sourceRef="AP07_T1" targetRef="AP07_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP07_F3" sourceRef="AP07_T2" targetRef="AP07_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP07_F4" sourceRef="AP07_T3" targetRef="AP07_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP07_F5" sourceRef="AP07_T4" targetRef="AP07_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP07_F6" sourceRef="AP07_T5" targetRef="AP07_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP07_diagram"><bpmndi:BPMNPlane id="AP07_plane" bpmnElement="AP07_collab"><bpmndi:BPMNShape id="AP07_pool_di" bpmnElement="AP07_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1746" height="352"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP07_lane_0_di" bpmnElement="AP07_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1716" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP07_lane_1_di" bpmnElement="AP07_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1716" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP07_S_di" bpmnElement="AP07_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP07_T0_di" bpmnElement="AP07_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP07_T1_di" bpmnElement="AP07_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP07_T2_di" bpmnElement="AP07_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP07_T3_di" bpmnElement="AP07_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP07_T4_di" bpmnElement="AP07_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP07_T5_di" bpmnElement="AP07_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP07_E_di" bpmnElement="AP07_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1620" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1576" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP07_F0_di" bpmnElement="AP07_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP07_F1_di" bpmnElement="AP07_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="570" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP07_F2_di" bpmnElement="AP07_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="178"/><di:waypoint x="750" y="178"/><di:waypoint x="750" y="354"/><di:waypoint x="780" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP07_F3_di" bpmnElement="AP07_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="354"/><di:waypoint x="960" y="354"/><di:waypoint x="960" y="178"/><di:waypoint x="990" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP07_F4_di" bpmnElement="AP07_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="178"/><di:waypoint x="1200" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP07_F5_di" bpmnElement="AP07_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="178"/><di:waypoint x="1410" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP07_F6_di" bpmnElement="AP07_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="178"/><di:waypoint x="1620" y="178"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>