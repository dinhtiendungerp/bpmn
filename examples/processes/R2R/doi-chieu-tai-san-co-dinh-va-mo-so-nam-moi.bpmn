<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP13_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP13_collab"><bpmn:participant id="AP13_pool" name="Đối chiếu tài sản cố định và mở sổ năm mới" processRef="AP13"/></bpmn:collaboration><bpmn:process id="AP13" name="Đối chiếu tài sản cố định và mở sổ năm mới" isExecutable="false"><bpmn:laneSet id="AP13_lanes"><bpmn:lane id="AP13_lane_0" name="Phòng Kế toán"><bpmn:flowNodeRef>AP13_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP13_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP13_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP13_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP13_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP13_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP13_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP13_E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP13_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP13_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP13_T0" name="01 · In báo cáo TSCĐ"><bpmn:documentation>Bước 1 · BP. Kế toán. Cuối kỳ in các báo cáo FA Depreciation Book, FA Card, FA Analysis - lưu trữ và ký phê duyệt theo quy định.</bpmn:documentation><bpmn:incoming>AP13_F0</bpmn:incoming><bpmn:outgoing>AP13_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP13_T1" name="02 · Đối chiếu sổ cái"><bpmn:documentation>Bước 2 · BP. Kế toán. Đối chiếu giá trị nguyên giá, KH lũy kế trên báo cáo FA với sổ cái GL - đảm bảo số liệu thống nhất.</bpmn:documentation><bpmn:incoming>AP13_F1</bpmn:incoming><bpmn:outgoing>AP13_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP13_T2" name="03 · Điều chỉnh nếu có"><bpmn:documentation>Bước 3 · BP. Kế toán. Nếu phát hiện sai sót - tìm hiểu nguyên nhân, lập phiếu điều chỉnh trên FA Journal hoặc Cancel FA Ledger Entries.</bpmn:documentation><bpmn:incoming>AP13_F2</bpmn:incoming><bpmn:outgoing>AP13_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP13_T3" name="04 · Thực hiện GL 5.1, 5.2,
5.3 đầy đủ"><bpmn:documentation>Bước 4 · BP. Kế toán. Đóng kỳ ghi sổ, kết chuyển KQKD, đánh giá CLTG, đối chiếu sổ sách, điều chỉnh số liệu - hoàn tất các bước theo từng quy trình.</bpmn:documentation><bpmn:incoming>AP13_F3</bpmn:incoming><bpmn:outgoing>AP13_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP13_T4" name="05 · Tạo kỳ kế toán năm mới"><bpmn:documentation>Bước 5 · BP. Kế toán. Người có thẩm quyền (Kế toán trưởng) tạo các kỳ kế toán cho năm mới - định kỳ 12 tháng, năm tài chính từ 01/01 đến 31/12.</bpmn:documentation><bpmn:incoming>AP13_F4</bpmn:incoming><bpmn:outgoing>AP13_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP13_T5" name="06 · Tạo bộ số chứng từ năm
mới"><bpmn:documentation>Bước 6 · BP. Kế toán. Tùy theo quy ước đánh số chứng từ - tạo thêm các bộ số chứng từ cho năm mới (vd: PT2026/0001, PC2026/0001…).</bpmn:documentation><bpmn:incoming>AP13_F5</bpmn:incoming><bpmn:outgoing>AP13_F6</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP13_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP13_F6</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP13_F0" sourceRef="AP13_S" targetRef="AP13_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP13_F1" sourceRef="AP13_T0" targetRef="AP13_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP13_F2" sourceRef="AP13_T1" targetRef="AP13_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP13_F3" sourceRef="AP13_T2" targetRef="AP13_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP13_F4" sourceRef="AP13_T3" targetRef="AP13_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP13_F5" sourceRef="AP13_T4" targetRef="AP13_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP13_F6" sourceRef="AP13_T5" targetRef="AP13_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP13_diagram"><bpmndi:BPMNPlane id="AP13_plane" bpmnElement="AP13_collab"><bpmndi:BPMNShape id="AP13_pool_di" bpmnElement="AP13_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1746" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP13_lane_0_di" bpmnElement="AP13_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1716" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP13_S_di" bpmnElement="AP13_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP13_T0_di" bpmnElement="AP13_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP13_T1_di" bpmnElement="AP13_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP13_T2_di" bpmnElement="AP13_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP13_T3_di" bpmnElement="AP13_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP13_T4_di" bpmnElement="AP13_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP13_T5_di" bpmnElement="AP13_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP13_E_di" bpmnElement="AP13_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1620" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1576" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP13_F0_di" bpmnElement="AP13_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP13_F1_di" bpmnElement="AP13_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="570" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP13_F2_di" bpmnElement="AP13_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="178"/><di:waypoint x="780" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP13_F3_di" bpmnElement="AP13_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="178"/><di:waypoint x="990" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP13_F4_di" bpmnElement="AP13_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="178"/><di:waypoint x="1200" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP13_F5_di" bpmnElement="AP13_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="178"/><di:waypoint x="1410" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP13_F6_di" bpmnElement="AP13_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="178"/><di:waypoint x="1620" y="178"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>