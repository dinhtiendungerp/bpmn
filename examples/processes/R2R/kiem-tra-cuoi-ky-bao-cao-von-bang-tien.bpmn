<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP06_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP06_collab"><bpmn:participant id="AP06_pool" name="Kiểm tra cuối kỳ &amp; báo cáo vốn bằng tiền" processRef="AP06"/></bpmn:collaboration><bpmn:process id="AP06" name="Kiểm tra cuối kỳ &amp; báo cáo vốn bằng tiền" isExecutable="false"><bpmn:laneSet id="AP06_lanes"><bpmn:lane id="AP06_lane_0" name="Phòng Kế toán"><bpmn:flowNodeRef>AP06_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP06_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP06_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP06_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP06_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP06_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP06_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP06_lane_1" name="Người duyệt"><bpmn:flowNodeRef>AP06_T4</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP06_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP06_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP06_T0" name="01 · Kiểm tra CLTG cuối kỳ"><bpmn:documentation>Bước 1 · BP. Kế toán. Kiểm tra lại các khoản chênh lệch lãi/lỗ tỷ giá - đối chiếu giá trị quy đổi VND của số dư gốc ngoại tệ.</bpmn:documentation><bpmn:incoming>AP06_F0</bpmn:incoming><bpmn:outgoing>AP06_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP06_T1" name="02 · In các báo cáo sổ"><bpmn:documentation>Bước 2 · BP. Kế toán. In sổ cái TK vốn bằng tiền + sổ chi tiết Cash Book, Bank Book theo VAS - lưu trữ và ký duyệt.</bpmn:documentation><bpmn:incoming>AP06_F1</bpmn:incoming><bpmn:outgoing>AP06_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP06_T2" name="03 · Đối chiếu"><bpmn:documentation>Bước 3 · BP. Kế toán. Đối chiếu số liệu giữa sổ cái và sổ chi tiết để đảm bảo độ chính xác trước khi đóng kỳ.</bpmn:documentation><bpmn:incoming>AP06_F2</bpmn:incoming><bpmn:outgoing>AP06_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP06_T3" name="04 · Điều chỉnh &amp; hạch toán"><bpmn:documentation>Bước 4 · BP. Kế toán. Lập phiếu hạch toán điều chỉnh nếu có sai sót, phê duyệt, hạch toán vào hệ thống.</bpmn:documentation><bpmn:incoming>AP06_F3</bpmn:incoming><bpmn:outgoing>AP06_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP06_T4" name="05 · Phê duyệt"><bpmn:documentation>Bước 5 · Người duyệt. Phê duyệt phiếu hạch toán điều chỉnh</bpmn:documentation><bpmn:incoming>AP06_F4</bpmn:incoming><bpmn:outgoing>AP06_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP06_T5" name="06 · Hạch toán &amp; In sổ sau
điều chỉnh"><bpmn:documentation>Bước 6 · BP. Kế toán. In lại sổ chi tiết sau khi hạch toán điều chỉnh để có bản số liệu cuối cùng.</bpmn:documentation><bpmn:incoming>AP06_F5</bpmn:incoming><bpmn:outgoing>AP06_F6</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP06_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP06_F6</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP06_F0" sourceRef="AP06_S" targetRef="AP06_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP06_F1" sourceRef="AP06_T0" targetRef="AP06_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP06_F2" sourceRef="AP06_T1" targetRef="AP06_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP06_F3" sourceRef="AP06_T2" targetRef="AP06_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP06_F4" sourceRef="AP06_T3" targetRef="AP06_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP06_F5" sourceRef="AP06_T4" targetRef="AP06_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP06_F6" sourceRef="AP06_T5" targetRef="AP06_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP06_diagram"><bpmndi:BPMNPlane id="AP06_plane" bpmnElement="AP06_collab"><bpmndi:BPMNShape id="AP06_pool_di" bpmnElement="AP06_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1746" height="352"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP06_lane_0_di" bpmnElement="AP06_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1716" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP06_lane_1_di" bpmnElement="AP06_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1716" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP06_S_di" bpmnElement="AP06_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP06_T0_di" bpmnElement="AP06_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP06_T1_di" bpmnElement="AP06_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP06_T2_di" bpmnElement="AP06_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP06_T3_di" bpmnElement="AP06_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP06_T4_di" bpmnElement="AP06_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP06_T5_di" bpmnElement="AP06_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP06_E_di" bpmnElement="AP06_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1620" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1576" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP06_F0_di" bpmnElement="AP06_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP06_F1_di" bpmnElement="AP06_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="570" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP06_F2_di" bpmnElement="AP06_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="178"/><di:waypoint x="780" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP06_F3_di" bpmnElement="AP06_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="178"/><di:waypoint x="990" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP06_F4_di" bpmnElement="AP06_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="178"/><di:waypoint x="1170" y="178"/><di:waypoint x="1170" y="354"/><di:waypoint x="1200" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP06_F5_di" bpmnElement="AP06_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="354"/><di:waypoint x="1380" y="354"/><di:waypoint x="1380" y="178"/><di:waypoint x="1410" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP06_F6_di" bpmnElement="AP06_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="178"/><di:waypoint x="1620" y="178"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>