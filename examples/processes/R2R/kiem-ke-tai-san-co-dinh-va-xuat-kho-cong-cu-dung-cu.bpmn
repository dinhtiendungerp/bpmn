<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP12_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP12_collab"><bpmn:participant id="AP12_pool" name="Kiểm kê tài sản cố định và xuất kho công cụ dụng cụ" processRef="AP12"/></bpmn:collaboration><bpmn:process id="AP12" name="Kiểm kê tài sản cố định và xuất kho công cụ dụng cụ" isExecutable="false"><bpmn:laneSet id="AP12_lanes"><bpmn:lane id="AP12_lane_0" name="Phòng Kế toán"><bpmn:flowNodeRef>AP12_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP12_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP12_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP12_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP12_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP12_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP12_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP12_T6</bpmn:flowNodeRef><bpmn:flowNodeRef>AP12_E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP12_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP12_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP12_T0" name="01 · Lập KH kiểm kê &amp; in
danh sách TSCĐ"><bpmn:documentation>Bước 1 · P. HC + Kế toán. Phòng HC phối hợp Kế toán lập kế hoạch kiểm kê. In danh sách TS từ hệ thống và kiểm kê thực tế.</bpmn:documentation><bpmn:incoming>AP12_F0</bpmn:incoming><bpmn:outgoing>AP12_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP12_T1" name="02 · Lập biên bản &amp; phê
duyệt xử lý chênh lệch"><bpmn:documentation>Bước 2 · Phòng kế toán + BLĐ. Nếu có chênh lệch - lập biên bản xử lý, BLĐ phê duyệt. Lập phiếu hạch toán xử lý theo quyết định.</bpmn:documentation><bpmn:incoming>AP12_F1</bpmn:incoming><bpmn:outgoing>AP12_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP12_T2" name="03 · Hạch toán &amp; thông báo"><bpmn:documentation>Bước 3 · Phòng kế toán. Phê duyệt phiếu hạch toán; post vào hệ thống; thông báo cho các phòng ban có liên quan kết quả kiểm kê.</bpmn:documentation><bpmn:incoming>AP12_F2</bpmn:incoming><bpmn:outgoing>AP12_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP12_T3" name="04 · Tiếp nhận hồ sơ &amp; nhập
Item Journal"><bpmn:documentation>Bước 4 · BP. kế toán. Tiếp nhận yêu cầu xuất CCDC; nhập bút toán xuất dùng qua Item Journal - quản lý số lượng tại kho nhà máy.</bpmn:documentation><bpmn:incoming>AP12_F3</bpmn:incoming><bpmn:outgoing>AP12_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP12_T4" name="05 · Hạch toán chi phí trong
kỳ"><bpmn:documentation>Bước 5 · BP. kế toán. Nếu giá trị nhỏ - chọn nhóm Gen Bus Posting Group hạch toán trực tiếp vào chi phí trong kỳ.</bpmn:documentation><bpmn:incoming>AP12_F4</bpmn:incoming><bpmn:outgoing>AP12_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP12_T5" name="06 · Hạch toán chi phí trả
trước &amp; kết chuyển"><bpmn:documentation>Bước 6 · BP. kế toán. Nếu giá trị lớn cần phân bổ - hạch toán vào chi phí trả trước (ngắn/dài hạn); cuối kỳ điều chỉnh sau Adjust Cost; tạo mã FA chi phí trả trước và kết chuyển qua FA G/L Journal.</bpmn:documentation><bpmn:incoming>AP12_F5</bpmn:incoming><bpmn:outgoing>AP12_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP12_T6" name="07 · Điều chỉnh sau Adjust
Cost"><bpmn:documentation>Bước 7 · BP. kế toán. Kiểm tra và điều chỉnh phân bổ CCDC nếu Adjust Cost thay đổi giá trị xuất kho</bpmn:documentation><bpmn:incoming>AP12_F6</bpmn:incoming><bpmn:outgoing>AP12_F7</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP12_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP12_F7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP12_F0" sourceRef="AP12_S" targetRef="AP12_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP12_F1" sourceRef="AP12_T0" targetRef="AP12_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP12_F2" sourceRef="AP12_T1" targetRef="AP12_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP12_F3" sourceRef="AP12_T2" targetRef="AP12_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP12_F4" sourceRef="AP12_T3" targetRef="AP12_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP12_F5" sourceRef="AP12_T4" targetRef="AP12_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP12_F6" sourceRef="AP12_T5" targetRef="AP12_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP12_F7" sourceRef="AP12_T6" targetRef="AP12_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP12_diagram"><bpmndi:BPMNPlane id="AP12_plane" bpmnElement="AP12_collab"><bpmndi:BPMNShape id="AP12_pool_di" bpmnElement="AP12_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1956" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP12_lane_0_di" bpmnElement="AP12_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP12_S_di" bpmnElement="AP12_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP12_T0_di" bpmnElement="AP12_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP12_T1_di" bpmnElement="AP12_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP12_T2_di" bpmnElement="AP12_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP12_T3_di" bpmnElement="AP12_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP12_T4_di" bpmnElement="AP12_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP12_T5_di" bpmnElement="AP12_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP12_T6_di" bpmnElement="AP12_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP12_E_di" bpmnElement="AP12_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1830" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1786" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP12_F0_di" bpmnElement="AP12_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP12_F1_di" bpmnElement="AP12_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="570" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP12_F2_di" bpmnElement="AP12_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="178"/><di:waypoint x="780" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP12_F3_di" bpmnElement="AP12_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="178"/><di:waypoint x="990" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP12_F4_di" bpmnElement="AP12_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="178"/><di:waypoint x="1200" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP12_F5_di" bpmnElement="AP12_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="178"/><di:waypoint x="1410" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP12_F6_di" bpmnElement="AP12_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="178"/><di:waypoint x="1620" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP12_F7_di" bpmnElement="AP12_F7" bioc:stroke="#7e90aa"><di:waypoint x="1780" y="178"/><di:waypoint x="1830" y="178"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>