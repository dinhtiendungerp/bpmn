<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP04_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP04_collab"><bpmn:participant id="AP04_pool" name="Quản lý tạm ứng và quyết toán tạm ứng" processRef="AP04"/></bpmn:collaboration><bpmn:process id="AP04" name="Quản lý tạm ứng và quyết toán tạm ứng" isExecutable="false"><bpmn:laneSet id="AP04_lanes"><bpmn:lane id="AP04_lane_0" name="Bộ phận yêu cầu"><bpmn:flowNodeRef>AP04_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP04_T0</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP04_lane_1" name="Phòng Kế toán"><bpmn:flowNodeRef>AP04_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP04_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP04_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP04_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP04_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP04_E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP04_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP04_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP04_T0" name="01 · Lập phiếu đề xuất tạm
ứng"><bpmn:documentation>Bước 1 · Bộ phận yêu cầu. Nhân viên có nhu cầu tạm ứng/thanh toán lập Phiếu đề xuất, kèm chứng từ chứng minh mục đích sử dụng.</bpmn:documentation><bpmn:incoming>AP04_F0</bpmn:incoming><bpmn:outgoing>AP04_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP04_T1" name="02 · Kiểm tra hợp lệ &amp; tiếp
nhận phê duyệt"><bpmn:documentation>Bước 2 · Kế toán thanh toán. Kiểm tra chứng từ, hạn mức tạm ứng theo quy chế (≤5tr tiền mặt; &gt;5tr chuyển khoản); xác định hình thức chi.</bpmn:documentation><bpmn:incoming>AP04_F1</bpmn:incoming><bpmn:outgoing>AP04_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP04_T2" name="03 · Lập phiếu chi / lệnh
chuyển tiền"><bpmn:documentation>Bước 3 · Kế toán thanh toán. Tạo bút toán trên Payment Journal - nhân viên là Vendor để ghi nhận tạm ứng (TK 141), hạn thanh toán = 20D. Gửi các cấp xin phê duyệt trước khi chi tiền (người duyệt: TBD).</bpmn:documentation><bpmn:incoming>AP04_F2</bpmn:incoming><bpmn:outgoing>AP04_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP04_T3" name="04 · Quyết toán &amp; kiểm tra
hợp lệ"><bpmn:documentation>Bước 4 · BP. yêu cầu / Kế toán. Đến hạn quyết toán, người nhận liệt kê các khoản chi kèm hóa đơn, chứng từ trình phê duyệt; kế toán đối chiếu tổng số tiền với chứng từ.</bpmn:documentation><bpmn:incoming>AP04_F3</bpmn:incoming><bpmn:outgoing>AP04_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP04_T4" name="05 · Cấn trừ công nợ nhân
viên"><bpmn:documentation>Bước 5 · BP. Kế toán / Thủ quỹ. Áp dụng Apply Entry - cấn trừ phần tạm ứng (141) với công nợ phải trả (331). Nếu tạm ứng lớn/nhỏ hơn thực chi: tạo bút toán bù trừ.</bpmn:documentation><bpmn:incoming>AP04_F4</bpmn:incoming><bpmn:outgoing>AP04_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP04_T5" name="06 · Hạch toán vào hệ thống"><bpmn:documentation>Bước 6 · BP. Kế toán / Thủ quỹ. Tùy mục đích tạm ứng (mua hàng / công tác phí): hạch toán đối ứng chi phí (641, 642) hoặc cấn trừ NCC thực tế.</bpmn:documentation><bpmn:incoming>AP04_F5</bpmn:incoming><bpmn:outgoing>AP04_F6</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP04_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP04_F6</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP04_F0" sourceRef="AP04_S" targetRef="AP04_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP04_F1" sourceRef="AP04_T0" targetRef="AP04_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP04_F2" sourceRef="AP04_T1" targetRef="AP04_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP04_F3" sourceRef="AP04_T2" targetRef="AP04_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP04_F4" sourceRef="AP04_T3" targetRef="AP04_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP04_F5" sourceRef="AP04_T4" targetRef="AP04_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP04_F6" sourceRef="AP04_T5" targetRef="AP04_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP04_diagram"><bpmndi:BPMNPlane id="AP04_plane" bpmnElement="AP04_collab"><bpmndi:BPMNShape id="AP04_pool_di" bpmnElement="AP04_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1746" height="352"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP04_lane_0_di" bpmnElement="AP04_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1716" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP04_lane_1_di" bpmnElement="AP04_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1716" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP04_S_di" bpmnElement="AP04_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP04_T0_di" bpmnElement="AP04_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP04_T1_di" bpmnElement="AP04_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP04_T2_di" bpmnElement="AP04_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP04_T3_di" bpmnElement="AP04_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP04_T4_di" bpmnElement="AP04_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP04_T5_di" bpmnElement="AP04_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP04_E_di" bpmnElement="AP04_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1620" y="336" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1576" y="381" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP04_F0_di" bpmnElement="AP04_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP04_F1_di" bpmnElement="AP04_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="540" y="178"/><di:waypoint x="540" y="354"/><di:waypoint x="570" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP04_F2_di" bpmnElement="AP04_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="354"/><di:waypoint x="780" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP04_F3_di" bpmnElement="AP04_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="354"/><di:waypoint x="990" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP04_F4_di" bpmnElement="AP04_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="354"/><di:waypoint x="1200" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP04_F5_di" bpmnElement="AP04_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="354"/><di:waypoint x="1410" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP04_F6_di" bpmnElement="AP04_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="354"/><di:waypoint x="1620" y="354"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>