<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP19_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP19_collab"><bpmn:participant id="AP19_pool" name="Xây dựng yêu cầu quản trị tài chính kế toán" processRef="AP19"/></bpmn:collaboration><bpmn:process id="AP19" name="Xây dựng yêu cầu quản trị tài chính kế toán" isExecutable="false"><bpmn:laneSet id="AP19_lanes"><bpmn:lane id="AP19_lane_0" name="BLĐ / BGĐ"><bpmn:flowNodeRef>AP19_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP19_T0</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP19_lane_1" name="Phòng Kế toán"><bpmn:flowNodeRef>AP19_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP19_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP19_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP19_T4</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP19_lane_2" name="liên quan"><bpmn:flowNodeRef>AP19_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP19_E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP19_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP19_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP19_T0" name="01 · Yêu cầu báo cáo quản
trị nội bộ"><bpmn:documentation>Bước 1 · BLĐ / BGĐ. BLĐ / BGĐ yêu cầu lập báo cáo quản trị với mong muốn quản trị hiệu quả hoạt động kinh doanh.</bpmn:documentation><bpmn:incoming>AP19_F0</bpmn:incoming><bpmn:outgoing>AP19_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP19_T1" name="02 · Tập hợp &amp; phân tích khả
năng triển khai"><bpmn:documentation>Bước 2 · P. kế toán. Tập hợp các chỉ tiêu cần quản lý, tiêu thức phân bổ kiểm soát; phân tích khả năng quản lý qua hệ thống ERP và đề xuất huấn luyện/quy định đi kèm.</bpmn:documentation><bpmn:incoming>AP19_F1</bpmn:incoming><bpmn:outgoing>AP19_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP19_T2" name="03 · Tạo Analysis View tập
hợp số liệu"><bpmn:documentation>Bước 3 · P. kế toán. Kiểm tra Analysis View đã có; nếu chưa - tạo mới qua chức năng Analysis View, khai báo mã, tên, chỉ tiêu phân tích, tài khoản theo dõi.</bpmn:documentation><bpmn:incoming>AP19_F2</bpmn:incoming><bpmn:outgoing>AP19_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP19_T3" name="04 · Tạo Financial Reports /
Account Schedule"><bpmn:documentation>Bước 4 · P. kế toán. Xây dựng các biểu mẫu báo cáo cần lấy với công thức tương ứng; tạo Account Schedule trên hệ thống - khai báo mã, tên, công thức, phạm vi, giới hạn, cách trình bày.</bpmn:documentation><bpmn:incoming>AP19_F3</bpmn:incoming><bpmn:outgoing>AP19_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP19_T4" name="05 · Kiểm tra công thức &amp;
điều chỉnh"><bpmn:documentation>Bước 5 · P. kế toán. Kiểm tra công thức báo cáo có lấy đúng số liệu không bằng cách xem báo cáo với tập số liệu giới hạn; điều chỉnh lại công thức nếu sai.</bpmn:documentation><bpmn:incoming>AP19_F4</bpmn:incoming><bpmn:outgoing>AP19_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP19_T5" name="06 · Thông báo &amp; hướng dẫn
người sử dụng"><bpmn:documentation>Bước 6 · BP. liên quan. Sau khi báo cáo đã có thể đưa vào sử dụng - kế toán tạo hướng dẫn xem báo cáo và thông báo cho các bộ phận liên quan.</bpmn:documentation><bpmn:incoming>AP19_F5</bpmn:incoming><bpmn:outgoing>AP19_F6</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP19_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP19_F6</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP19_F0" sourceRef="AP19_S" targetRef="AP19_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP19_F1" sourceRef="AP19_T0" targetRef="AP19_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP19_F2" sourceRef="AP19_T1" targetRef="AP19_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP19_F3" sourceRef="AP19_T2" targetRef="AP19_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP19_F4" sourceRef="AP19_T3" targetRef="AP19_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP19_F5" sourceRef="AP19_T4" targetRef="AP19_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP19_F6" sourceRef="AP19_T5" targetRef="AP19_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP19_diagram"><bpmndi:BPMNPlane id="AP19_plane" bpmnElement="AP19_collab"><bpmndi:BPMNShape id="AP19_pool_di" bpmnElement="AP19_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1746" height="528"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP19_lane_0_di" bpmnElement="AP19_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1716" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP19_lane_1_di" bpmnElement="AP19_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1716" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP19_lane_2_di" bpmnElement="AP19_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="1716" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP19_S_di" bpmnElement="AP19_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP19_T0_di" bpmnElement="AP19_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP19_T1_di" bpmnElement="AP19_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP19_T2_di" bpmnElement="AP19_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP19_T3_di" bpmnElement="AP19_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP19_T4_di" bpmnElement="AP19_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP19_T5_di" bpmnElement="AP19_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP19_E_di" bpmnElement="AP19_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1620" y="512" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1576" y="557" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP19_F0_di" bpmnElement="AP19_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP19_F1_di" bpmnElement="AP19_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="540" y="178"/><di:waypoint x="540" y="354"/><di:waypoint x="570" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP19_F2_di" bpmnElement="AP19_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="354"/><di:waypoint x="780" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP19_F3_di" bpmnElement="AP19_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="354"/><di:waypoint x="990" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP19_F4_di" bpmnElement="AP19_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="354"/><di:waypoint x="1200" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP19_F5_di" bpmnElement="AP19_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="354"/><di:waypoint x="1380" y="354"/><di:waypoint x="1380" y="530"/><di:waypoint x="1410" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP19_F6_di" bpmnElement="AP19_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="530"/><di:waypoint x="1620" y="530"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>