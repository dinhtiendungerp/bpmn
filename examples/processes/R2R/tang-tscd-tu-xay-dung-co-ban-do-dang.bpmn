<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP09_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP09_collab"><bpmn:participant id="AP09_pool" name="Tăng TSCĐ từ Xây dựng cơ bản dở dang" processRef="AP09"/></bpmn:collaboration><bpmn:process id="AP09" name="Tăng TSCĐ từ Xây dựng cơ bản dở dang" isExecutable="false"><bpmn:laneSet id="AP09_lanes"><bpmn:lane id="AP09_lane_0" name="Phòng Kế toán"><bpmn:flowNodeRef>AP09_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP09_T0</bpmn:flowNodeRef><bpmn:flowNodeRef>AP09_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP09_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP09_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP09_T6</bpmn:flowNodeRef><bpmn:flowNodeRef>AP09_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP09_lane_1" name="Bộ phận Cung ứng"><bpmn:flowNodeRef>AP09_T2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP09_lane_2" name="quản lý CT"><bpmn:flowNodeRef>AP09_T4</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP09_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP09_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP09_T0" name="01 · Tạo dimension CIP"><bpmn:documentation>Bước 1 · BP. kế toán. Tại thời điểm bắt đầu công trình, kế toán tạo mã dimension (Project Code) để tập hợp chi phí XDCB dở dang.</bpmn:documentation><bpmn:incoming>AP09_F0</bpmn:incoming><bpmn:outgoing>AP09_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP09_T1" name="02 · Gửi thông tin dimension
cho BP. mua hàng"><bpmn:documentation>Bước 2 · BP. kế toán. BP. cung ứng tạo PO và gán dimension đã tạo - mọi chi phí mua phục vụ công trình tự động được tập hợp.</bpmn:documentation><bpmn:incoming>AP09_F1</bpmn:incoming><bpmn:outgoing>AP09_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP09_T2" name="03 · Hoàn thành đơn hàng"><bpmn:documentation>Bước 3 · BP. mua hàng. Kiểm tra thông tin trên Purchase Order; post Purchase Receipt khi nhận hàng/dịch vụ; thông tin các BP. liên quan.</bpmn:documentation><bpmn:incoming>AP09_F2</bpmn:incoming><bpmn:outgoing>AP09_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP09_T3" name="04 · Tập hợp chi phí XDCB"><bpmn:documentation>Bước 4 · BP. kế toán. Ghi nhận các chi phí có liên quan vào TK 241 (XDCB dở dang) hoặc 242 (chi phí trả trước dài hạn) theo dimension.</bpmn:documentation><bpmn:incoming>AP09_F3</bpmn:incoming><bpmn:outgoing>AP09_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP09_T4" name="05 · Biên bản nghiệm thu"><bpmn:documentation>Bước 5 · BP. quản lý CT. Khi công trình hoàn thành, BP. quản lý gửi biên bản nghiệm thu sang Kế toán; tham khảo quy trình FA 1.2 tạo mã TSCĐ mới.</bpmn:documentation><bpmn:incoming>AP09_F4</bpmn:incoming><bpmn:outgoing>AP09_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP09_T5" name="06 · Tạo phiếu kết chuyển
(Reclass)"><bpmn:documentation>Bước 6 · BP. kế toán. Lập phiếu hạch toán kết chuyển nguyên giá XDCB dở dang sang nguyên giá TSCĐ mới qua FA Reclassification Journal.</bpmn:documentation><bpmn:incoming>AP09_F5</bpmn:incoming><bpmn:outgoing>AP09_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP09_T6" name="07 · Phê duyệt &amp; ghi nhận"><bpmn:documentation>Bước 7 · TGĐ / BP. kế toán. TGĐ phê duyệt; Kế toán hạch toán bút toán - toàn bộ chi phí được kết chuyển vào nguyên giá; khấu hao bắt đầu từ tháng tiếp theo.</bpmn:documentation><bpmn:incoming>AP09_F6</bpmn:incoming><bpmn:outgoing>AP09_F7</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP09_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP09_F7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP09_F0" sourceRef="AP09_S" targetRef="AP09_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP09_F1" sourceRef="AP09_T0" targetRef="AP09_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP09_F2" sourceRef="AP09_T1" targetRef="AP09_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP09_F3" sourceRef="AP09_T2" targetRef="AP09_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP09_F4" sourceRef="AP09_T3" targetRef="AP09_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP09_F5" sourceRef="AP09_T4" targetRef="AP09_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP09_F6" sourceRef="AP09_T5" targetRef="AP09_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP09_F7" sourceRef="AP09_T6" targetRef="AP09_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP09_diagram"><bpmndi:BPMNPlane id="AP09_plane" bpmnElement="AP09_collab"><bpmndi:BPMNShape id="AP09_pool_di" bpmnElement="AP09_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1956" height="528"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP09_lane_0_di" bpmnElement="AP09_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP09_lane_1_di" bpmnElement="AP09_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP09_lane_2_di" bpmnElement="AP09_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="1926" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP09_S_di" bpmnElement="AP09_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP09_T0_di" bpmnElement="AP09_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP09_T1_di" bpmnElement="AP09_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP09_T2_di" bpmnElement="AP09_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP09_T3_di" bpmnElement="AP09_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP09_T4_di" bpmnElement="AP09_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP09_T5_di" bpmnElement="AP09_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP09_T6_di" bpmnElement="AP09_T6" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1620" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP09_E_di" bpmnElement="AP09_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1830" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1786" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP09_F0_di" bpmnElement="AP09_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP09_F1_di" bpmnElement="AP09_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="570" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP09_F2_di" bpmnElement="AP09_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="178"/><di:waypoint x="750" y="178"/><di:waypoint x="750" y="354"/><di:waypoint x="780" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP09_F3_di" bpmnElement="AP09_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="354"/><di:waypoint x="960" y="354"/><di:waypoint x="960" y="178"/><di:waypoint x="990" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP09_F4_di" bpmnElement="AP09_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="178"/><di:waypoint x="1170" y="178"/><di:waypoint x="1170" y="530"/><di:waypoint x="1200" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP09_F5_di" bpmnElement="AP09_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="530"/><di:waypoint x="1380" y="530"/><di:waypoint x="1380" y="178"/><di:waypoint x="1410" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP09_F6_di" bpmnElement="AP09_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="178"/><di:waypoint x="1620" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP09_F7_di" bpmnElement="AP09_F7" bioc:stroke="#7e90aa"><di:waypoint x="1780" y="178"/><di:waypoint x="1830" y="178"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>