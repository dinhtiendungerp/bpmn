<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP18_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP18_collab"><bpmn:participant id="AP18_pool" name="Hợp nhất dữ liệu (GL Consolidation)" processRef="AP18"/></bpmn:collaboration><bpmn:process id="AP18" name="Hợp nhất dữ liệu (GL Consolidation)" isExecutable="false"><bpmn:laneSet id="AP18_lanes"><bpmn:lane id="AP18_lane_0" name="Bộ phận CNTT"><bpmn:flowNodeRef>AP18_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP18_T0</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP18_lane_1" name="Hệ thống"><bpmn:flowNodeRef>AP18_T1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP18_lane_2" name="Phòng Kế toán"><bpmn:flowNodeRef>AP18_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP18_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP18_E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP18_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP18_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP18_T0" name="01 · Thiết lập phân hệ
Consolidation"><bpmn:documentation>Bước 1 · Bộ phận IT. Tạo 1 công ty hợp nhất không có giao dịch; thiết lập Business Unit Card cho từng công ty con, khai báo % tỷ lệ sở hữu (100% cho đơn vị thành viên).</bpmn:documentation><bpmn:incoming>AP18_F0</bpmn:incoming><bpmn:outgoing>AP18_F1</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="AP18_T1" name="02 · Đẩy dữ liệu hợp nhất"><bpmn:documentation>Bước 2 · Hệ thống. Hệ thống tự lấy dữ liệu GL Entries từ công ty mẹ () và công ty con (đơn vị thành viên) tại thời điểm đóng sổ tháng/năm.</bpmn:documentation><bpmn:incoming>AP18_F1</bpmn:incoming><bpmn:outgoing>AP18_F2</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="AP18_T2" name="03 · Xử lý bút toán loại trừ"><bpmn:documentation>Bước 3 · Kế toán. Kế toán hạch toán bút toán loại trừ trên Elimination Journal. NWV đề xuất phát triển thêm chức năng mapping TK Nợ-Có để hệ thống tự nhận bút toán cần loại trừ.</bpmn:documentation><bpmn:incoming>AP18_F2</bpmn:incoming><bpmn:outgoing>AP18_F3</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="AP18_T3" name="04 · Kiểm tra báo cáo hợp
nhất"><bpmn:documentation>Bước 4 · Kế toán. Lọc và kết xuất 3 bộ BCTC: Bảng Cân đối kế toán, Báo cáo KQKD, Báo cáo LCTT trực tiếp. Lưu ý BC không hỗ trợ Thuyết minh BCTC trực tiếp.</bpmn:documentation><bpmn:incoming>AP18_F3</bpmn:incoming><bpmn:outgoing>AP18_F4</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP18_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP18_F4</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP18_F0" sourceRef="AP18_S" targetRef="AP18_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP18_F1" sourceRef="AP18_T0" targetRef="AP18_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP18_F2" sourceRef="AP18_T1" targetRef="AP18_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP18_F3" sourceRef="AP18_T2" targetRef="AP18_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP18_F4" sourceRef="AP18_T3" targetRef="AP18_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP18_diagram"><bpmndi:BPMNPlane id="AP18_plane" bpmnElement="AP18_collab"><bpmndi:BPMNShape id="AP18_pool_di" bpmnElement="AP18_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1326" height="528"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP18_lane_0_di" bpmnElement="AP18_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1296" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP18_lane_1_di" bpmnElement="AP18_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1296" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP18_lane_2_di" bpmnElement="AP18_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="442" width="1296" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP18_S_di" bpmnElement="AP18_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP18_T0_di" bpmnElement="AP18_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP18_T1_di" bpmnElement="AP18_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP18_T2_di" bpmnElement="AP18_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP18_T3_di" bpmnElement="AP18_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="482" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP18_E_di" bpmnElement="AP18_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1200" y="512" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1156" y="557" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP18_F0_di" bpmnElement="AP18_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP18_F1_di" bpmnElement="AP18_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="540" y="178"/><di:waypoint x="540" y="354"/><di:waypoint x="570" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP18_F2_di" bpmnElement="AP18_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="354"/><di:waypoint x="750" y="354"/><di:waypoint x="750" y="530"/><di:waypoint x="780" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP18_F3_di" bpmnElement="AP18_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="530"/><di:waypoint x="990" y="530"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP18_F4_di" bpmnElement="AP18_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="530"/><di:waypoint x="1200" y="530"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>