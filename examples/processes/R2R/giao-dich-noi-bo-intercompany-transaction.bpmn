<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP17_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP17_collab"><bpmn:participant id="AP17_pool" name="Giao dịch nội bộ (Intercompany Transaction)" processRef="AP17"/></bpmn:collaboration><bpmn:process id="AP17" name="Giao dịch nội bộ (Intercompany Transaction)" isExecutable="false"><bpmn:laneSet id="AP17_lanes"><bpmn:lane id="AP17_lane_0" name="Bộ phận CNTT"><bpmn:flowNodeRef>AP17_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP17_T0</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP17_lane_1" name="Bộ phận yêu cầu"><bpmn:flowNodeRef>AP17_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP17_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP17_E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP17_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP17_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP17_T0" name="01 · Thiết lập phân hệ
Intercompany"><bpmn:documentation>Bước 1 · Bộ phận IT. Khai báo Intercompany Setup, IC Chart of Account (mapping TK với công ty con), IC Dimension và IC Partner Code cho đơn vị thành viên.</bpmn:documentation><bpmn:incoming>AP17_F0</bpmn:incoming><bpmn:outgoing>AP17_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP17_T1" name="02 · Thực hiện giao dịch IC
tại"><bpmn:documentation>Bước 2 · Các BP. ở. Triển khai quy trình mua/bán nội bộ, hạch toán, thanh toán giữa và đơn vị thành viên: PO/SO, IC Journal cho cho vay/thanh toán nội bộ. Tự động cấn trừ công nợ theo thứ tự thời gian hóa đơn.</bpmn:documentation><bpmn:incoming>AP17_F1</bpmn:incoming><bpmn:outgoing>AP17_F2</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="AP17_T2" name="03 · Nhận dữ liệu giao dịch
từ"><bpmn:documentation>Bước 3 · Các BP. ở đơn vị thành viên. Hệ thống tự khởi tạo giao dịch ngược tại công ty đối ứng: tạo Sales Order/Invoice → đơn vị thành viên tự động nhận Purchase Order/Invoice. Bên nhận vào IC Journal kiểm tra và Post thủ công sau khi tiền về.</bpmn:documentation><bpmn:incoming>AP17_F2</bpmn:incoming><bpmn:outgoing>AP17_F3</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="AP17_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP17_F3</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP17_F0" sourceRef="AP17_S" targetRef="AP17_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP17_F1" sourceRef="AP17_T0" targetRef="AP17_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP17_F2" sourceRef="AP17_T1" targetRef="AP17_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP17_F3" sourceRef="AP17_T2" targetRef="AP17_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP17_diagram"><bpmndi:BPMNPlane id="AP17_plane" bpmnElement="AP17_collab"><bpmndi:BPMNShape id="AP17_pool_di" bpmnElement="AP17_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1116" height="352"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP17_lane_0_di" bpmnElement="AP17_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1086" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP17_lane_1_di" bpmnElement="AP17_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1086" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP17_S_di" bpmnElement="AP17_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP17_T0_di" bpmnElement="AP17_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP17_T1_di" bpmnElement="AP17_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP17_T2_di" bpmnElement="AP17_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP17_E_di" bpmnElement="AP17_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="990" y="336" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="946" y="381" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP17_F0_di" bpmnElement="AP17_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP17_F1_di" bpmnElement="AP17_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="540" y="178"/><di:waypoint x="540" y="354"/><di:waypoint x="570" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP17_F2_di" bpmnElement="AP17_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="354"/><di:waypoint x="780" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP17_F3_di" bpmnElement="AP17_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="354"/><di:waypoint x="990" y="354"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>