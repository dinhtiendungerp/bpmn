<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP14_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP14_collab"><bpmn:participant id="AP14_pool" name="Hệ thống tài khoản và danh mục nhóm hạch toán" processRef="AP14"/></bpmn:collaboration><bpmn:process id="AP14" name="Hệ thống tài khoản và danh mục nhóm hạch toán" isExecutable="false"><bpmn:laneSet id="AP14_lanes"><bpmn:lane id="AP14_lane_0" name="yêu cầu"><bpmn:flowNodeRef>AP14_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP14_T0</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP14_lane_1" name="Người duyệt"><bpmn:flowNodeRef>AP14_T1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP14_lane_2" name="Phòng Kế toán"><bpmn:flowNodeRef>AP14_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP14_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP14_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP14_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP14_T7</bpmn:flowNodeRef><bpmn:flowNodeRef>AP14_E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP14_lane_3" name="Kế toán trưởng"><bpmn:flowNodeRef>AP14_T6</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP14_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP14_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP14_T0" name="01 · Lập yêu cầu tạo
mới/thay đổi"><bpmn:documentation>Bước 1 · BP yêu cầu. Thiết kế hệ thống TK theo TT99, khai báo Dimension, bộ số chứng từ, kỳ kế toán</bpmn:documentation><bpmn:incoming>AP14_F0</bpmn:incoming><bpmn:outgoing>AP14_F1</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP14_T1" name="02 · Phê duyệt yêu cầu"><bpmn:documentation>Bước 2 · Người duyệt. Người có thẩm quyền phê duyệt các yêu cầu thay đổi, bổ sung</bpmn:documentation><bpmn:incoming>AP14_F1</bpmn:incoming><bpmn:outgoing>AP14_F2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP14_T2" name="03 · Kiểm tra trong hệ thống
đã có chưa"><bpmn:documentation>Bước 3 · BP kế toán. BP kế toán kiểm tra xem hệ thống đã có chưa trước khi cập nhật</bpmn:documentation><bpmn:incoming>AP14_F2</bpmn:incoming><bpmn:outgoing>AP14_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP14_T3" name="04 · Cập nhật mã &amp; thông báo
người liên quan"><bpmn:documentation>Bước 4 · BP kế toán. BP kế toán cập nhật dữ liệu vào hệ thống</bpmn:documentation><bpmn:incoming>AP14_F3</bpmn:incoming><bpmn:outgoing>AP14_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP14_T4" name="05 · Xây dựng cách thức hạch
toán cho từng nhóm"><bpmn:documentation>Bước 5 · BP kế toán. BP kế toán sẽ xây dựng cách thức cho các nhóm hạch toán TK phải thu/ phải trả/ Hàng tồn kho..</bpmn:documentation><bpmn:incoming>AP14_F4</bpmn:incoming><bpmn:outgoing>AP14_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP14_T5" name="06 · Lập phiếu yêu cầu tạo
mới/thay đổi"><bpmn:documentation>Bước 6 · BP kế toán. Lập phiếu YC và gửi KTT phê duyệt</bpmn:documentation><bpmn:incoming>AP14_F5</bpmn:incoming><bpmn:outgoing>AP14_F6</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP14_T6" name="07 · Kiểm tra/phê duyệt yêu
cầu"><bpmn:documentation>Bước 7 · KTT. KTT kiểm tra và phê duyệt</bpmn:documentation><bpmn:incoming>AP14_F6</bpmn:incoming><bpmn:outgoing>AP14_F7</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP14_T7" name="08 · Tạo mới/cập nhật &amp;
thông báo người liên"><bpmn:documentation>Bước 8 · BP kế toán. Các thay đổi được cập nhật vào hệ thống</bpmn:documentation><bpmn:incoming>AP14_F7</bpmn:incoming><bpmn:outgoing>AP14_F8</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP14_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP14_F8</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP14_F0" sourceRef="AP14_S" targetRef="AP14_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP14_F1" sourceRef="AP14_T0" targetRef="AP14_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP14_F2" sourceRef="AP14_T1" targetRef="AP14_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP14_F3" sourceRef="AP14_T2" targetRef="AP14_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP14_F4" sourceRef="AP14_T3" targetRef="AP14_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP14_F5" sourceRef="AP14_T4" targetRef="AP14_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP14_F6" sourceRef="AP14_T5" targetRef="AP14_T6"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP14_F7" sourceRef="AP14_T6" targetRef="AP14_T7"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP14_F8" sourceRef="AP14_T7" targetRef="AP14_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP14_diagram"><bpmndi:BPMNPlane id="AP14_plane" bpmnElement="AP14_collab"><bpmndi:BPMNShape id="AP14_pool_di" bpmnElement="AP14_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="2166" height="704"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP14_lane_0_di" bpmnElement="AP14_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP14_lane_1_di" bpmnElement="AP14_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="2136" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP14_lane_2_di" bpmnElement="AP14_lane_2" isHorizontal="true" bioc:fill="#ffffff" bioc