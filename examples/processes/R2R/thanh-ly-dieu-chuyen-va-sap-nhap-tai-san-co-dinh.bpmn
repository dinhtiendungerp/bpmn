<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="AP11_definitions" targetNamespace="https://bpmn-studio.local/process" exporter="BPMN Studio" exporterVersion="1.0.0"><bpmn:collaboration id="AP11_collab"><bpmn:participant id="AP11_pool" name="Thanh lý, điều chuyển và sáp nhập tài sản cố định" processRef="AP11"/></bpmn:collaboration><bpmn:process id="AP11" name="Thanh lý, điều chuyển và sáp nhập tài sản cố định" isExecutable="false"><bpmn:laneSet id="AP11_lanes"><bpmn:lane id="AP11_lane_0" name="kiểm soát"><bpmn:flowNodeRef>AP11_S</bpmn:flowNodeRef><bpmn:flowNodeRef>AP11_T0</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="AP11_lane_1" name="Phòng Kế toán"><bpmn:flowNodeRef>AP11_T1</bpmn:flowNodeRef><bpmn:flowNodeRef>AP11_T2</bpmn:flowNodeRef><bpmn:flowNodeRef>AP11_T3</bpmn:flowNodeRef><bpmn:flowNodeRef>AP11_T4</bpmn:flowNodeRef><bpmn:flowNodeRef>AP11_T5</bpmn:flowNodeRef><bpmn:flowNodeRef>AP11_E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="AP11_S" name="Bắt đầu quy trình"><bpmn:documentation></bpmn:documentation><bpmn:outgoing>AP11_F0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="AP11_T0" name="01 · Tiếp nhận biên bản &amp;
gửi hồ sơ TS"><bpmn:documentation>Bước 1 · BP. kiểm soát. Phòng kiểm soát tiếp nhận quyết định, biên bản thanh lý từ Phòng HC; kiểm tra thông tin sổ sách kế toán; gửi hồ sơ TSCĐ thanh lý cho kế toán.</bpmn:documentation><bpmn:incoming>AP11_F0</bpmn:incoming><bpmn:outgoing>AP11_F1</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="AP11_T1" name="02 · Lập phiếu hạch toán
hoặc hóa đơn bán"><bpmn:documentation>Bước 2 · BP. kế toán. Quyết định: thanh lý không thu tiền - lập FA Journal (hệ thống tự tính nguyên giá, KH lũy kế, GTCL); bán có thu tiền - lập Sales Invoice (Type=FA).</bpmn:documentation><bpmn:incoming>AP11_F1</bpmn:incoming><bpmn:outgoing>AP11_F2</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="AP11_T2" name="03 · Phê duyệt &amp; hạch toán
hệ thống"><bpmn:documentation>Bước 3 · BP. kế toán. Phê duyệt chứng từ; post phiếu/hóa đơn - tạo FA Ledger Entries với Disposal Date; thẻ TSCĐ tự động đóng (Inactive).</bpmn:documentation><bpmn:incoming>AP11_F2</bpmn:incoming><bpmn:outgoing>AP11_F3</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP11_T3" name="04 · Tiếp nhận quyết định &amp;
phân loại"><bpmn:documentation>Bước 4 · BP. yêu cầu / kế toán. BP. yêu cầu chuyển thông tin TS sang Kế toán; phân loại: nếu điều chuyển - bước FA 2.5.40; nếu tách/sáp nhập - thực hiện FA 1.2 tạo mã TSCĐ mới trước.</bpmn:documentation><bpmn:incoming>AP11_F3</bpmn:incoming><bpmn:outgoing>AP11_F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP11_T4" name="05 · Thay đổi FA Card / Lập
Reclass"><bpmn:documentation>Bước 5 · BP. kế toán. Điều chuyển: thay đổi Location, Department trên FA Card. Tách/Gộp: dùng FA Reclassification Journal - bút toán tự sinh trên FA G/L Journal với tỷ trọng nguyên giá và KH lũy kế.</bpmn:documentation><bpmn:incoming>AP11_F4</bpmn:incoming><bpmn:outgoing>AP11_F5</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="AP11_T5" name="06 · Phê duyệt &amp; hạch toán"><bpmn:documentation>Bước 6 · TGĐ / BP. kế toán. TGĐ phê duyệt chứng từ; Kế toán post vào hệ thống - thẻ TS gốc giảm và thẻ TS mới tăng tương ứng.</bpmn:documentation><bpmn:incoming>AP11_F5</bpmn:incoming><bpmn:outgoing>AP11_F6</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="AP11_E" name="Kết thúc quy trình"><bpmn:documentation></bpmn:documentation><bpmn:incoming>AP11_F6</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="AP11_F0" sourceRef="AP11_S" targetRef="AP11_T0"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP11_F1" sourceRef="AP11_T0" targetRef="AP11_T1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP11_F2" sourceRef="AP11_T1" targetRef="AP11_T2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP11_F3" sourceRef="AP11_T2" targetRef="AP11_T3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP11_F4" sourceRef="AP11_T3" targetRef="AP11_T4"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP11_F5" sourceRef="AP11_T4" targetRef="AP11_T5"></bpmn:sequenceFlow><bpmn:sequenceFlow id="AP11_F6" sourceRef="AP11_T5" targetRef="AP11_E"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="AP11_diagram"><bpmndi:BPMNPlane id="AP11_plane" bpmnElement="AP11_collab"><bpmndi:BPMNShape id="AP11_pool_di" bpmnElement="AP11_pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#9aaac1"><dc:Bounds x="70" y="90" width="1746" height="352"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP11_lane_0_di" bpmnElement="AP11_lane_0" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="90" width="1716" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP11_lane_1_di" bpmnElement="AP11_lane_1" isHorizontal="true" bioc:fill="#f6f9fd" bioc:stroke="#c6d1df"><dc:Bounds x="100" y="266" width="1716" height="176"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP11_S_di" bpmnElement="AP11_S" bioc:fill="#e4f5ee" bioc:stroke="#298273"><dc:Bounds x="150" y="160" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="106" y="205" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP11_T0_di" bpmnElement="AP11_T0" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="360" y="130" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP11_T1_di" bpmnElement="AP11_T1" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="570" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP11_T2_di" bpmnElement="AP11_T2" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="780" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP11_T3_di" bpmnElement="AP11_T3" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="990" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP11_T4_di" bpmnElement="AP11_T4" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1200" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP11_T5_di" bpmnElement="AP11_T5" bioc:fill="#eef4ff" bioc:stroke="#5c81c2"><dc:Bounds x="1410" y="306" width="160" height="96"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AP11_E_di" bpmnElement="AP11_E" bioc:fill="#fff0f0" bioc:stroke="#b95560"><dc:Bounds x="1620" y="336" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1576" y="381" width="124" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="AP11_F0_di" bpmnElement="AP11_F0" bioc:stroke="#7e90aa"><di:waypoint x="186" y="178"/><di:waypoint x="360" y="178"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP11_F1_di" bpmnElement="AP11_F1" bioc:stroke="#7e90aa"><di:waypoint x="520" y="178"/><di:waypoint x="540" y="178"/><di:waypoint x="540" y="354"/><di:waypoint x="570" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP11_F2_di" bpmnElement="AP11_F2" bioc:stroke="#7e90aa"><di:waypoint x="730" y="354"/><di:waypoint x="780" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP11_F3_di" bpmnElement="AP11_F3" bioc:stroke="#7e90aa"><di:waypoint x="940" y="354"/><di:waypoint x="990" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP11_F4_di" bpmnElement="AP11_F4" bioc:stroke="#7e90aa"><di:waypoint x="1150" y="354"/><di:waypoint x="1200" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP11_F5_di" bpmnElement="AP11_F5" bioc:stroke="#7e90aa"><di:waypoint x="1360" y="354"/><di:waypoint x="1410" y="354"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AP11_F6_di" bpmnElement="AP11_F6" bioc:stroke="#7e90aa"><di:waypoint x="1570" y="354"/><di:waypoint x="1620" y="354"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>